<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Virtual Numbers Services - AK Cell</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css" />

  <style>
    body {
      background: #f6f7fb;
    }

    .page-title {
      font-weight: 900;
      letter-spacing: .2px;
    }

    .card-soft {
      border: 0;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    .filter-card {
      border: 0;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .service-header {
      background: #111827;
      color: #fff;
      font-weight: 800;
      font-size: .92rem;
      letter-spacing: .3px;
    }

    .service-header td {
      padding-top: 13px;
      padding-bottom: 13px;
    }

    .table td,
    .table th {
      vertical-align: middle;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-variant-numeric: tabular-nums;
    }

    .btn-round {
      border-radius: 12px;
    }

    .service-icon,
    .country-flag {
      width: 44px;
      height: 44px;
      border-radius: 11px;
      object-fit: cover;
      border: 1px solid #e5e7eb;
      background: #fff;
    }

    .service-fallback,
    .country-fallback {
      width: 44px;
      height: 44px;
      border-radius: 11px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      border: 1px solid #e5e7eb;
    }

    .service-fallback {
      color: #fff;
      background: linear-gradient(135deg, #0d6efd, #6f42c1);
    }

    .country-fallback {
      color: #475569;
      background: #f1f5f9;
    }

    .badge-pill {
      border-radius: 999px;
    }

    .availability-cell {
      min-width: 175px;
    }

    .price-cell {
      white-space: nowrap;
    }

    .action-cell {
      width: 90px;
      text-align: center;
    }

    .edit-btn {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .stat-box {
      background: #fff;
      border: 1px solid #e9edf3;
      border-radius: 15px;
      padding: 16px;
      box-shadow: 0 6px 18px rgba(15, 23, 42, .045);
    }

    .stat-label {
      color: #6b7280;
      font-size: .76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .3px;
    }

    .stat-value {
      margin-top: 3px;
      font-size: 1.35rem;
      font-weight: 900;
      color: #111827;
    }

    .empty-state {
      padding: 70px 20px;
      color: #6b7280;
      text-align: center;
    }

    .pagination .page-link {
      border-radius: 10px;
      margin: 0 2px;
    }

    @media (max-width: 991px) {
      .stat-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 575px) {
      .stat-grid {
        grid-template-columns: 1fr;
      }

      .page-actions {
        width: 100%;
      }

      .page-actions .btn {
        flex: 1;
      }
    }
  </style>
</head>

<body>
<div class="d-flex">
  <%- include('partials/admin-sidebar', { user: user }) %>

  <div class="container-fluid p-4 p-lg-5">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <div>
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-phone-vibrate fs-2 text-primary"></i>
          <h1 class="page-title mb-0">Virtual Numbers Services</h1>
        </div>
        <div class="text-muted small mt-1">
          Manage countries, prices, availability and service visibility.
        </div>
      </div>

      <div class="d-flex gap-2 page-actions">
        <a href="/admin" class="btn btn-outline-secondary btn-round">
          <i class="bi bi-arrow-left"></i>
          Dashboard
        </a>

        <a href="/admin/fivesim/sync" class="btn btn-primary btn-round">
          <i class="bi bi-arrow-repeat"></i>
          Sync 5SIM
        </a>
      </div>
    </div>

    <div class="stat-grid mb-4">
      <div class="stat-box">
        <div class="stat-label">Total Combinations</div>
        <div class="stat-value"><%= Number(meta?.total || 0).toLocaleString() %></div>
      </div>

      <div class="stat-box">
        <div class="stat-label">Active on Page</div>
        <div class="stat-value">
          <%= (items || []).filter(item => Number(item.is_active) === 1).length %>
        </div>
      </div>

      <div class="stat-box">
        <div class="stat-label">Available Numbers</div>
        <div class="stat-value">
          <%= (items || []).reduce((sum, item) => sum + Number(item.total_available || 0), 0).toLocaleString() %>
        </div>
      </div>

      <div class="stat-box">
        <div class="stat-label">Countries</div>
        <div class="stat-value"><%= (countries || []).length %></div>
      </div>
    </div>

    <div class="card filter-card mb-4">
      <div class="card-body p-4">
        <form method="get" action="/admin/fivesim-services" class="row g-3 align-items-end">
          <div class="col-xl-5 col-lg-5 col-md-6">
            <label class="form-label fw-bold">Search</label>
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="WhatsApp, Telegram, USA, Germany..."
              value="<%= filters?.search || '' %>"
            />
          </div>

          <div class="col-xl-3 col-lg-3 col-md-3">
            <label class="form-label fw-bold">Country</label>
            <select name="country_id" class="form-select">
              <option value="all" <%= filters?.country_id === 'all' ? 'selected' : '' %>>
                All countries
              </option>

              <% (countries || []).forEach(function(country) { %>
                <option
                  value="<%= country.id %>"
                  <%= String(filters?.country_id) === String(country.id) ? 'selected' : '' %>
                >
                  <%= country.custom_name || country.code %>
                  <%= country.iso ? `(${country.iso.toUpperCase()})` : '' %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="col-xl-2 col-lg-2 col-md-3">
            <label class="form-label fw-bold">Status</label>
            <select name="status" class="form-select">
              <option value="all" <%= filters?.status === 'all' ? 'selected' : '' %>>All</option>
              <option value="active" <%= filters?.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= filters?.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>

          <div class="col-xl-2 col-lg-2 col-md-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-round flex-grow-1">
              <i class="bi bi-funnel"></i>
              Filter
            </button>

            <a
              href="/admin/fivesim-services"
              class="btn btn-outline-secondary btn-round"
              title="Reset filters"
            >
              <i class="bi bi-x-lg"></i>
            </a>
          </div>
        </form>
      </div>
    </div>

    <div class="card card-soft">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-dark">
              <tr>
                <th style="width:74px;">Img</th>
                <th>Country</th>
                <th style="width:145px;">Provider Cost</th>
                <th style="width:145px;">Sell Price</th>
                <th style="width:145px;">Profit</th>
                <th style="width:190px;">Availability</th>
                <th style="width:125px;">Status</th>
                <th style="width:90px;" class="text-center">Edit</th>
              </tr>
            </thead>

            <tbody>
            <%
              let lastServiceId = null;
            %>

            <% if (items && items.length > 0) { %>
              <% items.forEach(function(item) { %>
                <%
                  const serviceKey = Number(item.service_id || 0);
                  const serviceName = item.service_custom_name || item.provider_name || item.product_code || 'Service';
                  const serviceImage = item.service_image || item.store_image || '';

                  const providerPrice = Number(item.cheapest_provider_price || 0);
                  const sellPrice = Number(item.sell_price || 0);
                  const profit = sellPrice - providerPrice;
                  const isLoss = sellPrice > 0 && providerPrice > sellPrice;

                  const editQuery = new URLSearchParams({
                    country_id: String(item.country_id || ''),
                    service_id: String(item.service_id || ''),
                    return_to: '/admin/fivesim-services?' + new URLSearchParams({
                      search: filters?.search || '',
                      country_id: filters?.country_id || 'all',
                      status: filters?.status || 'all',
                      page: String(meta?.page || 1)
                    }).toString()
                  }).toString();
                %>

                <% if (serviceKey !== lastServiceId) { %>
                  <tr class="service-header">
                    <td colspan="8">
                      <div class="d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-2">
                          <% if (serviceImage) { %>
                            <img
                              src="<%= serviceImage %>"
                              alt="<%= serviceName %>"
                              class="service-icon"
                              onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';"
                            />
                          <% } %>

                          <span
                            class="service-fallback"
                            style="<%= serviceImage ? 'display:none;' : 'display:inline-flex;' %>"
                          >
                            <i class="bi bi-chat-square-text-fill"></i>
                          </span>

                          <div>
                            <div><%= serviceName %></div>
                            <div class="small text-white-50 mono"><%= item.product_code || '' %></div>
                          </div>
                        </div>

                        <span class="badge bg-light text-dark badge-pill">
                          <i class="bi bi-globe2 me-1"></i>
                          Service countries
                        </span>
                      </div>
                    </td>
                  </tr>

                  <% lastServiceId = serviceKey; %>
                <% } %>

                <tr>
                  <td>
                    <% if (item.country_image) { %>
                      <img
                        src="<%= item.country_image %>"
                        alt="<%= item.country_name || item.country_code %>"
                        class="country-flag"
                        onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';"
                      />
                    <% } %>

                    <span
                      class="country-fallback"
                      style="<%= item.country_image ? 'display:none;' : 'display:inline-flex;' %>"
                    >
                      <i class="bi bi-flag-fill"></i>
                    </span>
                  </td>

                  <td>
                    <div class="fw-semibold">
                      <%= item.country_name || item.country_code %>
                    </div>

                    <div class="small text-muted">
                      <% if (item.country_iso) { %>
                        <span class="mono"><%= item.country_iso.toUpperCase() %></span>
                      <% } %>

                      <% if (item.country_prefix) { %>
                        <span class="ms-1"><%= item.country_prefix %></span>
                      <% } %>
                    </div>
                  </td>

                  <td class="price-cell mono fw-bold text-secondary">
                    <%= providerPrice > 0 ? `$${providerPrice.toFixed(4)}` : 'Unavailable' %>
                  </td>

                  <td class="price-cell mono fw-bold text-primary">
                    $<%= sellPrice.toFixed(4) %>
                  </td>

                  <td class="price-cell mono fw-bold <%= isLoss ? 'text-danger' : 'text-success' %>">
                    <%= profit >= 0 ? '+' : '' %>$<%= profit.toFixed(4) %>
                  </td>

                  <td class="availability-cell">
                    <div class="d-flex flex-column gap-1">
                      <% if (Number(item.total_available || 0) > 0) { %>
                        <span class="badge bg-success badge-pill align-self-start">
                          <i class="bi bi-check2-circle me-1"></i>
                          <%= Number(item.total_available || 0).toLocaleString() %> available
                        </span>
                      <% } else { %>
                        <span class="badge bg-danger badge-pill align-self-start">
                          <i class="bi bi-x-circle me-1"></i>
                          Out of stock
                        </span>
                      <% } %>

                      <span class="small text-muted">
                        <%= Number(item.available_operators || 0) %> operators
                      </span>
                    </div>
                  </td>

                  <td>
                    <% if (Number(item.is_active) === 1) { %>
                      <span class="badge bg-success badge-pill">
                        <i class="bi bi-eye-fill me-1"></i>
                        Active
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary badge-pill">
                        <i class="bi bi-eye-slash-fill me-1"></i>
                        Hidden
                      </span>
                    <% } %>

                    <% if (Number(item.is_featured) === 1) { %>
                      <div class="mt-1">
                        <span class="badge bg-warning text-dark badge-pill">
                          <i class="bi bi-star-fill me-1"></i>
                          Featured
                        </span>
                      </div>
                    <% } %>
                  </td>

                  <td class="action-cell">
                    <a
                      href="/admin/fivesim-services/edit?<%= editQuery %>"
                      class="btn btn-warning btn-sm btn-round edit-btn"
                      title="Edit service country"
                    >
                      <i class="bi bi-pencil"></i>
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="empty-state">
                  <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                  <div class="fw-bold mb-1">No services found</div>
                  <div>Try changing the filters or syncing the provider.</div>
                </td>
              </tr>
            <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if (meta && meta.pages > 1) { %>
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
        <div class="small text-muted">
          Showing
          <strong><%= ((meta.page - 1) * meta.limit) + 1 %></strong>
          to
          <strong><%= Math.min(meta.page * meta.limit, meta.total) %></strong>
          of
          <strong><%= meta.total %></strong>
        </div>

        <nav aria-label="Pagination">
          <ul class="pagination pagination-sm mb-0">
            <%
              const page = Number(meta.page || 1);
              const pages = Number(meta.pages || 1);
              const startPage = Math.max(1, page - 2);
              const endPage = Math.min(pages, page + 2);

              function pageUrl(targetPage) {
                return '/admin/fivesim-services?' + new URLSearchParams({
                  search: filters?.search || '',
                  country_id: filters?.country_id || 'all',
                  status: filters?.status || 'all',
                  page: String(targetPage)
                }).toString();
              }
            %>

            <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="<%= page <= 1 ? '#' : pageUrl(page - 1) %>">
                <i class="bi bi-chevron-left"></i>
              </a>
            </li>

            <% if (startPage > 1) { %>
              <li class="page-item">
                <a class="page-link" href="<%= pageUrl(1) %>">1</a>
              </li>

              <% if (startPage > 2) { %>
                <li class="page-item disabled">
                  <span class="page-link">…</span>
                </li>
              <% } %>
            <% } %>

            <% for (let p = startPage; p <= endPage; p += 1) { %>
              <li class="page-item <%= p === page ? 'active' : '' %>">
                <a class="page-link" href="<%= pageUrl(p) %>"><%= p %></a>
              </li>
            <% } %>

            <% if (endPage < pages) { %>
              <% if (endPage < pages - 1) { %>
                <li class="page-item disabled">
                  <span class="page-link">…</span>
                </li>
              <% } %>

              <li class="page-item">
                <a class="page-link" href="<%= pageUrl(pages) %>"><%= pages %></a>
              </li>
            <% } %>

            <li class="page-item <%= page >= pages ? 'disabled' : '' %>">
              <a class="page-link" href="<%= page >= pages ? '#' : pageUrl(page + 1) %>">
                <i class="bi bi-chevron-right"></i>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
