<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Checkout - <%= item.name %> <%= item.countryName %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      --vn-primary: #1266f1;
      --vn-success: #198754;
      --vn-danger: #dc3545;
      --vn-warning: #f59f00;
      --vn-text: #172033;
      --vn-muted: #6b7280;
      --vn-border: rgba(15, 23, 42, .08);
      --vn-card: #ffffff;
    }

    body {
      font-family: "Cairo", sans-serif;
      background:
        radial-gradient(900px 500px at 12% 8%, rgba(18, 102, 241, .11), transparent 60%),
        radial-gradient(850px 470px at 90% 18%, rgba(25, 135, 84, .09), transparent 55%),
        #f6f7fb;
      color: var(--vn-text);
    }

    .checkout-wrap {
      min-height: 72vh;
    }

    .checkout-card {
      border: 0;
      border-radius: 22px;
      overflow: hidden;
      background: var(--vn-card);
      box-shadow: 0 18px 50px rgba(20, 35, 60, .10);
    }

    .checkout-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 18px 22px;
      background:
        linear-gradient(135deg, rgba(18, 102, 241, .11), rgba(25, 135, 84, .08));
      border-bottom: 1px solid var(--vn-border);
    }

    .checkout-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      font-weight: 800;
      font-size: 1.05rem;
    }

    .secure-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      background: rgba(25, 135, 84, .12);
      color: #146c43;
      font-size: .75rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .checkout-body {
      padding: 26px;
    }

    .product-image-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 18px;
    }

    .product-image {
      width: 100%;
      max-width: 220px;
      height: 150px;
      object-fit: contain;
      border-radius: 18px;
      padding: 12px;
      background: #fff;
      border: 1px solid var(--vn-border);
      box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 16px;
      margin-bottom: 16px;
      border: 1px solid var(--vn-border);
      border-radius: 16px;
      background: #fff;
    }

    .summary-label {
      color: var(--vn-muted);
      font-size: .74rem;
      margin-bottom: 4px;
    }

    .summary-name {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .country-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 8px;
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(18, 102, 241, .09);
      color: var(--vn-primary);
      font-size: .76rem;
      font-weight: 700;
    }

    .price-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 13px;
      border-radius: 999px;
      background: rgba(25, 135, 84, .11);
      color: #146c43;
      font-weight: 800;
      white-space: nowrap;
    }

    .status-card {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 16px;
      padding: 14px;
      border-radius: 15px;
      background: rgba(25, 135, 84, .08);
      border: 1px solid rgba(25, 135, 84, .16);
      color: #146c43;
    }

    .checkout-meta {
      border: 1px solid var(--vn-border);
      border-radius: 16px;
      overflow: hidden;
      margin-bottom: 16px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 13px 15px;
      border-bottom: 1px solid var(--vn-border);
      background: #fff;
    }

    .meta-row:last-child {
      border-bottom: 0;
    }

    .balance-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border-radius: 999px;
      background: #f1f3f6;
      color: #495057;
      font-size: .83rem;
      font-weight: 700;
    }

    .info-card {
      margin-bottom: 16px;
      border: 1px solid var(--vn-border);
      border-radius: 16px;
      overflow: hidden;
      background: rgba(255, 255, 255, .95);
    }

    .info-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 15px;
      background:
        linear-gradient(135deg, rgba(18, 102, 241, .08), rgba(25, 135, 84, .07));
      border-bottom: 1px solid var(--vn-border);
    }

    .info-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0;
      font-weight: 800;
      font-size: .95rem;
    }

    .info-body {
      padding: 15px;
    }

    .description-text {
      margin: 0;
      color: rgba(0, 0, 0, .72);
      line-height: 1.7;
      white-space: pre-wrap;
    }

    .notes-box {
      margin-top: 12px;
      padding: 13px 14px;
      border-radius: 14px;
      background: #fff8e8;
      border: 1px solid #ffe3a3;
      color: #795900;
      white-space: pre-wrap;
    }

    .btn-buy {
      min-height: 52px;
      border-radius: 14px;
      font-weight: 800;
      box-shadow: 0 10px 22px rgba(18, 102, 241, .22);
      transition: transform .15s ease, box-shadow .15s ease;
    }

    .btn-buy:hover {
      transform: translateY(-1px);
      box-shadow: 0 14px 26px rgba(18, 102, 241, .25);
    }

    .btn-buy:disabled {
      transform: none;
      box-shadow: none;
      opacity: .75;
    }

    .trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }

    .trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      border-radius: 999px;
      background: rgba(0, 0, 0, .04);
      color: rgba(0, 0, 0, .65);
      font-size: .72rem;
      font-weight: 700;
    }

    .muted-note {
      color: rgba(0, 0, 0, .55);
    }

    .rtl-content {
      direction: rtl;
      text-align: right;
    }

    @media (max-width: 575px) {
      .checkout-head {
        align-items: flex-start;
      }

      .secure-badge {
        font-size: .66rem;
      }

      .checkout-body {
        padding: 18px;
      }

      .summary-row {
        align-items: flex-start;
        flex-direction: column;
      }

      .summary-row > div:last-child {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/header') %>

  <%
    const balance = Number(user?.balance || 0);
    const price = Number(item?.price || 0);

    const insufficientBalance = balance < price;

    const hasDescription =
      !!String(item?.description || '').trim();

    const hasNotes =
      !!String(item?.notes || '').trim();

    const isArabicContent =
      /[\u0600-\u06FF]/.test(
        `${item?.description || ''} ${item?.notes || ''}`
      );
  %>

  <main class="container my-5 checkout-wrap">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto">

      <div class="card checkout-card">

        <div class="checkout-head">
          <h1 class="checkout-title">
            <i class="bi bi-phone-fill"></i>
            Virtual Number Checkout
          </h1>

          <span class="secure-badge">
            <i class="bi bi-shield-lock-fill"></i>
            Secure Purchase
          </span>
        </div>

        <div class="checkout-body">

          <% if (error) { %>
            <div
              class="alert alert-danger d-flex align-items-center gap-2 mb-3"
              style="border-radius:14px;"
            >
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div class="fw-bold"><%= error %></div>
            </div>
          <% } %>

          <div class="product-image-wrap">
            <img
              src="<%= item.serviceImage || '/images/placeholder.png' %>"
              alt="<%= item.name %>"
              class="product-image"
              loading="lazy"
              onerror="this.src='/images/placeholder.png'"
            />
          </div>

          <div class="summary-row">
            <div>
              <div class="summary-label">
                Virtual Number Service
              </div>

              <h2 class="summary-name">
                <%= item.name %>
              </h2>

              <span class="country-chip">
                <i class="bi bi-geo-alt-fill"></i>

                <%= item.countryName %>

                <% if (item.countryIso) { %>
                  · <%= item.countryIso.toUpperCase() %>
                <% } %>

                <% if (item.countryPrefix) { %>
                  · <%= item.countryPrefix %>
                <% } %>
              </span>
            </div>

            <div class="text-end">
              <div class="summary-label">
                Total
              </div>

              <span class="price-chip">
                <i class="bi bi-cash-coin"></i>
                $<%= price.toFixed(2) %>
              </span>
            </div>
          </div>

          <div class="status-card">
            <i class="bi bi-check-circle-fill fs-5"></i>

            <div>
              <div class="fw-bold">
                <%= Number(item.available || 0).toLocaleString() %>
                numbers currently available
              </div>

              <div class="small mt-1">
                The best available operator is selected automatically.
              </div>
            </div>
          </div>

          <div class="checkout-meta">
            <div class="meta-row">
              <span class="text-muted">Service</span>
              <span class="fw-bold"><%= item.name %></span>
            </div>

            <div class="meta-row">
              <span class="text-muted">Country</span>
              <span class="fw-bold"><%= item.countryName %></span>
            </div>

            <div class="meta-row">
              <span class="text-muted">Availability</span>
              <span class="badge bg-success-subtle text-success">
                Available
              </span>
            </div>

            <div class="meta-row">
              <span class="text-muted">Your Balance</span>

              <span class="balance-chip">
                <i class="bi bi-wallet2"></i>
                $<%= balance.toFixed(2) %>
              </span>
            </div>

            <div class="meta-row">
              <span class="text-muted">Order Total</span>

              <span class="fw-bold text-success">
                $<%= price.toFixed(2) %>
              </span>
            </div>
          </div>

          <% if (hasDescription || hasNotes) { %>
            <div class="info-card <%= isArabicContent ? 'rtl-content' : '' %>">

              <div class="info-head">
                <h3 class="info-title">
                  <i class="bi bi-card-text"></i>
                  Service Details
                </h3>

                <span class="badge bg-primary-subtle text-primary">
                  Read Before Buying
                </span>
              </div>

              <div class="info-body">

                <% if (hasDescription) { %>
                  <p class="description-text">
                    <%= item.description %>
                  </p>
                <% } %>

                <% if (hasNotes) { %>
                  <div class="notes-box">
                    <div class="fw-bold mb-1">
                      <i class="bi bi-exclamation-circle-fill me-1"></i>
                      Important Notes
                    </div>

                    <%= item.notes %>
                  </div>
                <% } %>

              </div>
            </div>
          <% } %>

          <form
            id="virtualNumberBuyForm"
            method="POST"
            action="/virtual-numbers/buy/<%= item.id %>"
          >
            <input
              type="hidden"
              name="idem_key"
              value="<%= idemKey %>"
            />

            <button
              id="buyButton"
              type="submit"
              class="btn btn-primary w-100 btn-buy"
              <%= insufficientBalance ? 'disabled' : '' %>
            >
              <span class="button-text">
                <i class="bi bi-lightning-charge-fill me-1"></i>
                Buy Number
              </span>

              <span
                class="spinner-border spinner-border-sm ms-2 d-none"
                aria-hidden="true"
              ></span>
            </button>
          </form>

          <% if (insufficientBalance) { %>
            <div
              class="alert alert-warning mt-3 mb-0 small"
              style="border-radius:13px;"
            >
              <i class="bi bi-wallet2 me-1"></i>
              Your balance is insufficient for this purchase.
            </div>
          <% } %>

          <div class="trust-row">
            <span class="trust-pill">
              <i class="bi bi-shield-check"></i>
              Secure
            </span>

            <span class="trust-pill">
              <i class="bi bi-lightning-charge"></i>
              Instant Number
            </span>

            <span class="trust-pill">
              <i class="bi bi-chat-dots"></i>
              SMS in My Orders
            </span>
          </div>

          <p class="muted-note small mt-3 mb-0">
            The server verifies the price and availability again before completing the purchase.
          </p>

        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      const form =
        document.getElementById(
          'virtualNumberBuyForm'
        );

      const button =
        document.getElementById(
          'buyButton'
        );

      if (!form || !button) {
        return;
      }

      let submitting = false;

      form.addEventListener(
        'submit',
        function (event) {
          if (submitting) {
            event.preventDefault();
            return;
          }

          submitting = true;
          button.disabled = true;

          const text =
            button.querySelector(
              '.button-text'
            );

          const spinner =
            button.querySelector(
              '.spinner-border'
            );

          if (text) {
            text.innerHTML =
              '<i class="bi bi-hourglass-split me-1"></i>' +
              'Reserving Number...';
          }

          if (spinner) {
            spinner.classList.remove(
              'd-none'
            );
          }
        }
      );
    })();
  </script>

</body>
</html>
