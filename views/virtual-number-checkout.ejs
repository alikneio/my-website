<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <title>
    Checkout - <%= item.name %> <%= item.countryName %>
  </title>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link
    rel="stylesheet"
    href="/css/bootstrap-icons/font/bootstrap-icons.css"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    body {
      font-family: "Cairo", sans-serif;
      background:
        radial-gradient(
          1100px 550px at 15% 10%,
          rgba(13, 110, 253, .10),
          transparent 60%
        ),
        radial-gradient(
          900px 500px at 90% 20%,
          rgba(25, 135, 84, .08),
          transparent 55%
        ),
        #f6f7fb;
    }

    .checkout-wrap {
      min-height: 72vh;
    }

    .checkout-card {
      border: 0;
      border-radius: 20px;
      overflow: hidden;
      box-shadow:
        0 16px 45px rgba(20, 35, 60, .10);
    }

    .checkout-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      padding: 17px 20px;

      background:
        linear-gradient(
          135deg,
          rgba(13, 110, 253, .11),
          rgba(25, 135, 84, .08)
        );

      border-bottom:
        1px solid rgba(0, 0, 0, .06);
    }

    .checkout-title {
      display: flex;
      align-items: center;
      gap: 10px;

      margin: 0;
      font-weight: 800;
    }

    .secure-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 7px 11px;
      border-radius: 999px;

      background: rgba(25, 135, 84, .12);
      color: #146c43;

      font-size: .76rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .product-image-wrap {
      border-radius: 17px;
      overflow: hidden;

      background: #f2f5f9;
      border: 1px solid rgba(0, 0, 0, .06);
    }

    .product-image {
      display: block;
      width: 100%;
      max-height: 290px;
      object-fit: cover;
    }

    .summary-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;

      padding: 15px;
      margin-top: 15px;

      border-radius: 15px;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, .06);
    }

    .summary-label {
      margin-bottom: 4px;
      color: rgba(0, 0, 0, .55);
      font-size: .75rem;
    }

    .summary-name {
      margin: 0;
      font-weight: 800;
      line-height: 1.35;
    }

    .country-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      margin-top: 8px;
      padding: 7px 10px;

      border-radius: 999px;
      background: rgba(13, 110, 253, .09);
      color: #0d6efd;

      font-size: .78rem;
      font-weight: 700;
    }

    .price-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 9px 13px;
      border-radius: 999px;

      background: rgba(25, 135, 84, .11);
      color: #146c43;

      font-weight: 800;
      white-space: nowrap;
    }

    .availability-box {
      display: flex;
      align-items: flex-start;
      gap: 10px;

      margin-top: 15px;
      padding: 13px 14px;

      border-radius: 14px;
      background: rgba(25, 135, 84, .08);
      border: 1px solid rgba(25, 135, 84, .16);
      color: #146c43;
    }

    .info-card {
      margin-top: 15px;
      border-radius: 16px;
      overflow: hidden;

      background: rgba(255, 255, 255, .94);
      border: 1px solid rgba(0, 0, 0, .06);
    }

    .info-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      padding: 13px 15px;

      background:
        linear-gradient(
          135deg,
          rgba(13, 110, 253, .08),
          rgba(25, 135, 84, .07)
        );

      border-bottom:
        1px solid rgba(0, 0, 0, .06);
    }

    .info-title {
      display: flex;
      align-items: center;
      gap: 8px;

      margin: 0;
      font-weight: 800;
    }

    .info-body {
      padding: 14px 15px;
    }

    .description-text {
      margin: 0;
      color: rgba(0, 0, 0, .72);
      line-height: 1.7;
      white-space: pre-wrap;
    }

    .notes-box {
      margin-top: 12px;
      padding: 13px 14px;

      border-radius: 14px;
      background: #fff8e8;
      border: 1px solid #ffe3a3;
      color: #795900;
    }

    .checkout-side {
      padding: 17px;
      border-radius: 17px;

      background: #fff;
      border: 1px solid rgba(0, 0, 0, .06);
    }

    .side-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      padding: 11px 0;

      border-bottom:
        1px solid rgba(0, 0, 0, .06);
    }

    .side-row:last-child {
      border-bottom: 0;
    }

    .balance-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 7px 10px;
      border-radius: 999px;

      background: #f1f3f6;
      color: #495057;

      font-size: .85rem;
      font-weight: 700;
    }

    .btn-buy {
      min-height: 52px;
      margin-top: 16px;

      border-radius: 14px;
      font-weight: 800;

      box-shadow:
        0 10px 20px rgba(13, 110, 253, .20);
    }

    .btn-buy:hover {
      transform: translateY(-1px);
    }

    .trust-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;

      margin-top: 13px;
    }

    .trust-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      padding: 7px 9px;
      border-radius: 999px;

      background: rgba(0, 0, 0, .04);
      color: rgba(0, 0, 0, .65);

      font-size: .72rem;
      font-weight: 700;
    }

    .rtl-content {
      direction: rtl;
      text-align: right;
    }

    @media (max-width: 575px) {
      .checkout-head {
        align-items: flex-start;
      }

      .secure-badge {
        font-size: .66rem;
      }

      .summary-card {
        align-items: flex-start;
        flex-direction: column;
      }

      .product-image {
        max-height: 230px;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/header') %>

  <%
    const balance = Number(user?.balance || 0);
    const price = Number(item?.price || 0);

    const insufficientBalance =
      balance < price;

    const hasDescription =
      !!String(item?.description || '').trim();

    const hasNotes =
      !!String(item?.notes || '').trim();

    const isArabicContent =
      /[\u0600-\u06FF]/.test(
        `${item?.description || ''} ${item?.notes || ''}`
      );
  %>

  <main class="container my-5 checkout-wrap">
    <div class="col-12 col-xl-10 mx-auto">

      <div class="card checkout-card">

        <div class="checkout-head">
          <h5 class="checkout-title">
            <i class="bi bi-phone-fill"></i>
            Virtual Number Checkout
          </h5>

          <span class="secure-badge">
            <i class="bi bi-shield-lock-fill"></i>
            Secure Purchase
          </span>
        </div>

        <div class="card-body p-4 p-lg-5">

          <% if (error) { %>
            <div
              class="alert alert-danger d-flex align-items-center gap-2 mb-4"
              style="border-radius:14px;"
            >
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div class="fw-bold"><%= error %></div>
            </div>
          <% } %>

          <div class="row g-4">

            <div class="col-lg-7">

              <div class="product-image-wrap">
                <img
                  src="<%= item.serviceImage %>"
                  alt="<%= item.name %>"
                  class="product-image"
                  loading="lazy"
                  onerror="this.src='/images/placeholder.png'"
                />
              </div>

              <div class="summary-card">
                <div>
                  <div class="summary-label">
                    Virtual Number Service
                  </div>

                  <h1 class="h5 summary-name">
                    <%= item.name %>
                  </h1>

                  <span class="country-chip">
                    <i class="bi bi-geo-alt-fill"></i>

                    <%= item.countryName %>

                    <% if (item.countryIso) { %>
                      · <%= item.countryIso.toUpperCase() %>
                    <% } %>

                    <% if (item.countryPrefix) { %>
                      · <%= item.countryPrefix %>
                    <% } %>
                  </span>
                </div>

                <div>
                  <div class="summary-label text-end">
                    Total
                  </div>

                  <span class="price-chip">
                    <i class="bi bi-cash-coin"></i>
                    $<%= price.toFixed(2) %>
                  </span>
                </div>
              </div>

              <div class="availability-box">
                <i class="bi bi-check-circle-fill fs-5"></i>

                <div>
                  <div class="fw-bold">
                    <%= Number(item.available || 0).toLocaleString() %>
                    numbers currently available
                  </div>

                  <div class="small mt-1">
                    The system automatically selects the best available operator.
                  </div>
                </div>
              </div>

              <% if (hasDescription || hasNotes) { %>
                <div
                  class="info-card <%= isArabicContent ? 'rtl-content' : '' %>"
                >
                  <div class="info-head">
                    <h6 class="info-title">
                      <i class="bi bi-card-text"></i>
                      Service Details
                    </h6>

                    <span class="badge bg-primary-subtle text-primary">
                      Read Before Buying
                    </span>
                  </div>

                  <div class="info-body">

                    <% if (hasDescription) { %>
                      <p class="description-text">
                        <%= item.description %>
                      </p>
                    <% } %>

                    <% if (hasNotes) { %>
                      <div class="notes-box">
                        <div class="fw-bold mb-1">
                          <i class="bi bi-exclamation-circle-fill me-1"></i>
                          Important Notes
                        </div>

                        <div style="white-space:pre-wrap;">
                          <%= item.notes %>
                        </div>
                      </div>
                    <% } %>

                  </div>
                </div>
              <% } %>

            </div>

            <div class="col-lg-5">

              <div class="checkout-side">

                <div class="side-row">
                  <span class="text-muted">
                    Service
                  </span>

                  <span class="fw-bold">
                    <%= item.name %>
                  </span>
                </div>

                <div class="side-row">
                  <span class="text-muted">
                    Country
                  </span>

                  <span class="fw-bold">
                    <%= item.countryName %>
                  </span>
                </div>

                <div class="side-row">
                  <span class="text-muted">
                    Availability
                  </span>

                  <span class="badge bg-success-subtle text-success">
                    Available
                  </span>
                </div>

                <div class="side-row">
                  <span class="text-muted">
                    Your Balance
                  </span>

                  <span class="balance-chip">
                    <i class="bi bi-wallet2"></i>
                    $<%= balance.toFixed(2) %>
                  </span>
                </div>

                <div class="side-row">
                  <span class="text-muted">
                    Order Total
                  </span>

                  <span class="fw-bold text-success">
                    $<%= price.toFixed(2) %>
                  </span>
                </div>

                <form
                  id="virtualNumberBuyForm"
                  method="POST"
                  action="/virtual-numbers/buy/<%= item.id %>"
                >
                  <input
                    type="hidden"
                    name="idem_key"
                    value="<%= idemKey %>"
                  />

                  <button
                    id="buyButton"
                    type="submit"
                    class="btn btn-primary w-100 btn-buy"
                    <%= insufficientBalance ? 'disabled' : '' %>
                  >
                    <span class="button-text">
                      <i class="bi bi-lightning-charge-fill me-1"></i>
                      Buy Number
                    </span>

                    <span
                      class="spinner-border spinner-border-sm ms-2 d-none"
                      aria-hidden="true"
                    ></span>
                  </button>
                </form>

                <% if (insufficientBalance) { %>
                  <div
                    class="alert alert-warning mt-3 mb-0 small"
                    style="border-radius:13px;"
                  >
                    <i class="bi bi-wallet2 me-1"></i>
                    Your balance is insufficient for this purchase.
                  </div>
                <% } %>

                <div class="trust-row">
                  <span class="trust-pill">
                    <i class="bi bi-shield-check"></i>
                    Secure
                  </span>

                  <span class="trust-pill">
                    <i class="bi bi-lightning-charge"></i>
                    Instant Number
                  </span>

                  <span class="trust-pill">
                    <i class="bi bi-chat-dots"></i>
                    SMS in My Orders
                  </span>
                </div>

                <p class="small text-muted mt-3 mb-0">
                  The price and availability are verified again securely
                  by the server before the purchase is completed.
                </p>

              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      const form =
        document.getElementById(
          'virtualNumberBuyForm'
        );

      const button =
        document.getElementById(
          'buyButton'
        );

      if (!form || !button) {
        return;
      }

      let submitting = false;

      form.addEventListener(
        'submit',
        function (event) {
          if (submitting) {
            event.preventDefault();
            return;
          }

          submitting = true;
          button.disabled = true;

          const text =
            button.querySelector(
              '.button-text'
            );

          const spinner =
            button.querySelector(
              '.spinner-border'
            );

          if (text) {
            text.innerHTML =
              '<i class="bi bi-hourglass-split me-1"></i>' +
              'Reserving Number...';
          }

          if (spinner) {
            spinner.classList.remove(
              'd-none'
            );
          }
        }
      );
    })();
  </script>

</body>
</html>