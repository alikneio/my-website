
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Processing | AK Cell</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="stylesheet" href="/css/bootstrap.css">
  <link rel="stylesheet" href="/css/custom.css">
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css">

  <style>
    :root {
      --ak-primary: #2563eb;
      --ak-dark: #172554;
      --ak-muted: #64748b;
      --ak-border: #e2e8f0;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100dvh;
      background:
        radial-gradient(circle at 15% 15%, #dbeafe 0%, transparent 36%),
        radial-gradient(circle at 85% 85%, #e0e7ff 0%, transparent 38%),
        #f8fafc;
      font-family: system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
    }

    .processing-card {
      width: 100%;
      max-width: 490px;
      background: #fff;
      border: 1px solid rgba(226, 232, 240, .9);
      border-radius: 24px;
      padding: 30px;
      box-shadow: 0 18px 55px rgba(15, 23, 42, .08);
      animation: cardEnter .5s ease both;
    }

    .brand-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 30px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--ak-dark);
      font-size: 17px;
      font-weight: 800;
      letter-spacing: .5px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      background: var(--ak-dark);
      color: white;
      border-radius: 12px;
      font-size: 19px;
    }

    .status-badge {
      background: #eff6ff;
      color: #1d4ed8;
      border-radius: 30px;
      padding: 7px 11px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .status-visual {
      position: relative;
      width: 104px;
      height: 104px;
      margin: 0 auto 22px;
      display: grid;
      place-items: center;
    }

    .status-ring {
      position: absolute;
      inset: 0;
      border: 4px solid #dbeafe;
      border-top-color: var(--ak-primary);
      border-radius: 50%;
      animation: spin 1.5s linear infinite;
    }

    .status-icon {
      width: 79px;
      height: 79px;
      border-radius: 50%;
      background: #eff6ff;
      display: grid;
      place-items: center;
      color: var(--ak-primary);
      font-size: 35px;
    }

    .processing-title {
      color: var(--ak-dark);
      text-align: center;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .processing-description {
      color: var(--ak-muted);
      text-align: center;
      font-size: 14px;
      line-height: 1.8;
      margin: 0 auto 25px;
      max-width: 380px;
    }

    .steps {
      background: #f8fafc;
      border: 1px solid var(--ak-border);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 24px;
    }

    .step {
      display: flex;
      align-items: center;
      gap: 13px;
      font-size: 13px;
      color: #334155;
      font-weight: 600;
    }

    .step + .step {
      margin-top: 18px;
    }

    .step-icon {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: 50%;
      font-size: 16px;
    }

    .step-done .step-icon {
      color: #16a34a;
      background: #dcfce7;
    }

    .step-active .step-icon {
      color: #2563eb;
      background: #dbeafe;
    }

    .step-pending {
      color: #94a3b8;
    }

    .step-pending .step-icon {
      color: #94a3b8;
      background: #e2e8f0;
    }

    .action-buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .action-buttons a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 10px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: transform .2s, background .2s;
    }

    .action-buttons a:hover {
      transform: translateY(-2px);
    }

    .btn-home {
      color: #334155;
      background: #f1f5f9;
    }

    .btn-home:hover {
      color: #172554;
      background: #e2e8f0;
    }

    .btn-orders {
      color: white;
      background: var(--ak-primary);
    }

    .btn-orders:hover {
      color: white;
      background: #1d4ed8;
    }

    .footer-text {
      margin-top: 23px;
      color: #94a3b8;
      text-align: center;
      font-size: 11px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes cardEnter {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 480px) {
      .processing-card {
        padding: 24px 19px;
        border-radius: 20px;
      }

      .processing-title {
        font-size: 21px;
      }

      .brand {
        font-size: 15px;
      }

      .status-badge {
        font-size: 10px;
      }

      .action-buttons {
        gap: 9px;
      }

      .action-buttons a {
        font-size: 13px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .status-ring,
      .processing-card {
        animation: none;
      }
    }
  </style>
</head>

<body>

  <main class="processing-card">

    <div class="brand-row">
      <div class="brand">
        <span class="brand-icon">
          <i class="bi bi-bag-check"></i>
        </span>
        AK CELL
      </div>

      <span class="status-badge">
        <i class="bi bi-hourglass-split"></i>
        ORDER PROCESSING
      </span>
    </div>

    <div class="status-visual" aria-hidden="true">
      <div class="status-ring"></div>
      <div class="status-icon">
        <i class="bi bi-clock-history"></i>
      </div>
    </div>

    <h1 class="processing-title">
      Your order is being processed
    </h1>

    <p class="processing-description">
      Your order has been recorded and is awaiting processing.
      You can check its progress anytime through
      <strong>My Orders</strong>.
    </p>

    <div class="steps">
      <div class="step step-done">
        <span class="step-icon">
          <i class="bi bi-check-lg"></i>
        </span>
        <span>Order recorded</span>
      </div>

      <div class="step step-active">
        <span class="step-icon">
          <i class="bi bi-clock-history"></i>
        </span>
        <span>Awaiting processing</span>
      </div>

      <div class="step step-pending">
        <span class="step-icon">
          <i class="bi bi-circle"></i>
        </span>
        <span>Completion pending</span>
      </div>
    </div>

    <div class="action-buttons">
      <a href="/" class="btn-home">
        <i class="bi bi-house-door"></i>
        Home
      </a>

      <a href="/my-orders" class="btn-orders">
        <i class="bi bi-receipt"></i>
        My Orders
      </a>
    </div>

    <div class="footer-text">
      Powered by AK Cell &bull; Secure Order Tracking
    </div>

  </main>

</body>
</html>
