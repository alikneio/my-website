<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow"><title>Developer Center | AK Cell</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>.ak-dev-page{margin:0;background:var(--bg);color:var(--ink);font:14px/1.55 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.ak-dev-page button, .ak-dev-page input{font:inherit}
.ak-dev-page button{cursor:pointer}
.ak-dev-page a{text-decoration:none;color:inherit}
.ak-dev-page a:hover{color:var(--blue)}
.ak-dev-page .shell{max-width:1440px;margin:auto;padding:0 32px}
.ak-dev-page .top{background:var(--navy);color:#fff}
.ak-dev-page .top-inner{min-height:74px;display:flex;justify-content:space-between;align-items:center;gap:18px}
.ak-dev-page .brand{display:flex;align-items:center;gap:12px;font-weight:850;font-size:19px;letter-spacing:.25px}
.ak-dev-page .brandmark{width:39px;height:39px;border-radius:12px;background:linear-gradient(135deg,#26b6f0,#1264d8);display:grid;place-items:center;box-shadow:0 5px 18px #1478e644}
.ak-dev-page .brand small{display:block;font-size:11px;color:#9eb0c9;font-weight:550;letter-spacing:1.4px}
.ak-dev-page .toplinks{display:flex;align-items:center;gap:22px;font-size:12px;color:#c7d3e4}
.ak-dev-page .toplinks a:hover{color:#fff}
.ak-dev-page .avatar{display:inline-grid;place-items:center;width:31px;height:31px;background:#2a3c58;border-radius:50%;font-weight:800}
.ak-dev-page .hero{background:linear-gradient(112deg,#132a4b,#10203a 64%,#173e70);color:white;padding:37px 0 40px;position:relative;overflow:hidden}
.ak-dev-page .hero:after{content:"";position:absolute;width:390px;height:390px;border:1px solid #ffffff13;border-radius:50%;right:7%;top:-220px;box-shadow:0 0 0 65px #ffffff05,0 0 0 135px #ffffff04;pointer-events:none}
.ak-dev-page .hero-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:24px}
.ak-dev-page .eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:10px;font-weight:800;color:#80c7ff}
.ak-dev-page .hero h1{font-size:33px;line-height:1.18;letter-spacing:-1px;margin:9px 0 12px}
.ak-dev-page .hero p{color:#c0d0e6;max-width:630px;margin:0}
.ak-dev-page .hero-actions{display:flex;gap:9px;flex-wrap:wrap}
.ak-dev-page .dev-btn{border:1px solid transparent;border-radius:9px;padding:10px 16px;font-weight:700;font-size:12px;display:inline-flex;gap:9px;align-items:center;justify-content:center}
.ak-dev-page .btn-primary{background:#2389f5;color:white}
.ak-dev-page .btn-primary:hover{background:#0869d5;color:white}
.ak-dev-page .btn-light{background:white;color:#19334f}
.ak-dev-page .btn-outline{background:white;border-color:var(--line);color:#34445b}
.ak-dev-page .btn-outline:hover{background:#f4f8fd}
.ak-dev-page .btn-danger{border-color:#f3d2d6;background:#fff6f6;color:#bc4353}
.ak-dev-page .dev-btn:disabled{opacity:.48;cursor:not-allowed}
.ak-dev-page .layout{display:grid;grid-template-columns:232px minmax(0,1fr);gap:28px;padding-top:27px;padding-bottom:70px}
.ak-dev-page .side{align-self:start;position:sticky;top:20px}
.ak-dev-page .sidebox, .ak-dev-page .panel, .ak-dev-page .stat, .ak-dev-page .endpoint, .ak-dev-page .notice{background:var(--white);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
.ak-dev-page .sidebox{padding:12px}
.ak-dev-page .sideheading{padding:13px 13px 8px;font-size:10px;color:#93a0b0;font-weight:800;letter-spacing:1.3px}
.ak-dev-page .navitem{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:12px 13px;border:0;border-radius:9px;background:transparent;color:#68778d;font-weight:650;margin:2px 0}
.ak-dev-page .navitem i{font-size:16px}
.ak-dev-page .navitem.active{background:var(--soft);color:#116dd1}
.ak-dev-page .navitem:hover{background:#f2f6fb}
.ak-dev-page .navitem .soon{margin-left:auto;color:#9aa8b8;font-size:10px}
.ak-dev-page .sidefoot{font-size:11px;color:#8291a4;margin:15px 8px}
.ak-dev-page .content{min-width:0}
.ak-dev-page .dev-section{display:none}
.ak-dev-page .dev-section.active{display:block}
.ak-dev-page .dev-sectiontop{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:22px}
.ak-dev-page .dev-sectiontop h2{font-size:24px;letter-spacing:-.6px;margin:0 0 5px}
.ak-dev-page .dev-sectiontop p{margin:0;color:var(--muted);font-size:13px}
.ak-dev-page .pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 11px;font-size:11px;font-weight:750;background:#eaf9f2;color:#16825d;white-space:nowrap}
.ak-dev-page .pill.off{background:#fff3e9;color:#bd7524}
.ak-dev-page .pill i{font-size:9px}
.ak-dev-page .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}
.ak-dev-page .stat{padding:19px;min-width:0}
.ak-dev-page .stathead{display:flex;align-items:center;justify-content:space-between;color:#7d8ba0;font-size:12px;gap:8px}
.ak-dev-page .stathead i{display:grid;place-items:center;width:35px;height:35px;border-radius:10px;background:#eff5fd;color:#3e85d8;font-size:17px}
.ak-dev-page .statvalue{font-size:26px;font-weight:850;letter-spacing:-.8px;margin-top:14px;line-height:1.1;overflow-wrap:anywhere}
.ak-dev-page .statsub{font-size:11px;color:#9aa5b3;margin-top:8px}
.ak-dev-page .panel{padding:24px;margin-bottom:20px}
.ak-dev-page .paneltitle{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:21px}
.ak-dev-page .paneltitle h3{margin:0 0 5px;font-size:16px}
.ak-dev-page .paneltitle p{margin:0;color:var(--muted);font-size:12px}
.ak-dev-page .paneltitle .bi{color:#7e91a9}
.ak-dev-page .notice{padding:16px 19px;margin-bottom:20px;display:flex;gap:13px;align-items:flex-start;background:#f0f7ff;border-color:#d9e9fd;color:#395b7b}
.ak-dev-page .notice i{color:#1478e6;font-size:18px}
.ak-dev-page .notice strong{color:#1b456c}
.ak-dev-page .notice p{margin:4px 0 0;font-size:12px}
.ak-dev-page .split{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}
.ak-dev-page .step{display:flex;gap:13px;padding:15px 0;border-bottom:1px solid var(--line)}
.ak-dev-page .step:last-child{border:0}
.ak-dev-page .stepnum{display:grid;place-items:center;width:31px;height:31px;border-radius:9px;background:#edf5ff;color:#247bdc;font-size:12px;font-weight:800;flex-shrink:0}
.ak-dev-page .step strong{font-size:13px}
.ak-dev-page .step p{font-size:12px;color:var(--muted);margin:3px 0 0}
.ak-dev-page .code{background:#111d2e;color:#d5e6f6;border-radius:11px;overflow:hidden;margin:13px 0}
.ak-dev-page .codetop{display:flex;align-items:center;justify-content:space-between;padding:11px 15px;background:#1d2c42;color:#9fb5d0;font-size:11px}
.ak-dev-page .copy{background:transparent;border:0;color:#b4c6dc;font-size:11px}
.ak-dev-page .copy:hover{color:#fff}
.ak-dev-page .code pre{padding:17px 18px;margin:0;overflow:auto;font:12px/1.8 Consolas,"Courier New",monospace;white-space:pre;tab-size:2}
.ak-dev-page .inlinecode{font:12px Consolas,monospace;color:#116fd4;background:#eaf4ff;padding:3px 7px;border-radius:5px}
.ak-dev-page .muted{color:var(--muted)}
.ak-dev-page .small{font-size:12px}
.ak-dev-page .tablewrap{overflow:auto;border:1px solid var(--line);border-radius:10px}
.ak-dev-page .dev-table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}
.ak-dev-page .dev-table th{font-size:11px;letter-spacing:.2px;color:#8493a7;background:#f7f9fc;font-weight:700}
.ak-dev-page .dev-table td, .ak-dev-page .dev-table th{padding:14px 16px;border-bottom:1px solid var(--line)}
.ak-dev-page .dev-table tr:last-child td{border-bottom:0}
.ak-dev-page .dev-table td{font-size:12px}
.ak-dev-page .dev-table code{font-size:11px;background:#f1f5fa;padding:5px 7px;border-radius:5px}
.ak-dev-page .keybadge{display:inline-block;padding:4px 9px;border-radius:999px;font-size:10px;font-weight:800;background:#e7f7ef;color:#138458}
.ak-dev-page .keybadge.revoked{background:#f1f3f6;color:#7b8796}
.ak-dev-page .formrow{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ak-dev-page .field{min-width:230px;max-width:350px;width:100%;border:1px solid #d9e2ee;border-radius:9px;padding:11px 13px;background:white;outline:none}
.ak-dev-page .field:focus{border-color:#4098ee;box-shadow:0 0 0 3px #2389f51a}
.ak-dev-page .hint{font-size:11px;color:#8a99a9;margin-top:12px}
.ak-dev-page .endpoint{margin-bottom:13px;overflow:hidden}
.ak-dev-page .endpoint-head{display:flex;align-items:center;gap:12px;padding:17px 19px;cursor:pointer;flex-wrap:wrap}
.ak-dev-page .method{font:800 11px Consolas,monospace;border-radius:6px;padding:5px 9px;background:#e6f7f1;color:#0c8c60}
.ak-dev-page .method.post{background:#fff0dd;color:#bb7a16}
.ak-dev-page .path{font:700 12px Consolas,monospace;overflow-wrap:anywhere}
.ak-dev-page .endpoint-desc{color:#8190a2;font-size:12px;margin-left:auto}
.ak-dev-page .dev-endpoint-body{border-top:1px solid var(--line);padding:19px;display:none}
.ak-dev-page .endpoint.open .endpoint-body{display:block}
.ak-dev-page .endpoint-head .chevron{color:#8799ad}
.ak-dev-page .endpoint.open .chevron{transform:rotate(180deg)}
.ak-dev-page .docsnav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.ak-dev-page .docsnav button{border:1px solid var(--line);border-radius:8px;padding:8px 11px;background:#fff;color:#5e7189;font-size:11px}
.ak-dev-page .docsnav button:hover{background:var(--soft);color:var(--blue)}
.ak-dev-page .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}
.ak-dev-page .mini{padding:17px;border:1px solid var(--line);border-radius:11px;background:#fff}
.ak-dev-page .mini h4{margin:0 0 6px;font-size:13px}
.ak-dev-page .mini p{font-size:12px;color:var(--muted);margin:0}
.ak-dev-page .divider{border:0;border-top:1px solid var(--line);margin:20px 0}
.ak-dev-page .foot{padding:23px 0;color:#8795a8;font-size:11px;border-top:1px solid var(--line)}
.ak-dev-page .foot-inner{display:flex;justify-content:space-between;gap:12px}
.ak-dev-page .empty{text-align:center;padding:30px 10px;color:#8997a9}
.ak-dev-page .empty i{font-size:31px;color:#9bb0c7}
.ak-dev-page .empty strong{display:block;color:#3c4c62;margin:10px 0 5px}
.ak-dev-page .callout{padding:14px 16px;border-left:3px solid #e9aa43;background:#fffbf1;border-radius:7px;color:#836333;font-size:12px}
.ak-dev-page .status-table td:first-child{font-family:Consolas,monospace;font-weight:700}
.ak-dev-page .keylimit{color:#76869a;font-size:11px}
.ak-dev-page .tabs-mobile{display:none}
@media (max-width:1080px){.ak-dev-page .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
.ak-dev-page .split{grid-template-columns:1fr}
.ak-dev-page .layout{grid-template-columns:195px minmax(0,1fr);gap:17px}
.ak-dev-page .shell{padding:0 20px}}
@media (max-width:720px){.ak-dev-page .shell{padding:0 15px}
.ak-dev-page .toplinks .desktop{display:none}
.ak-dev-page .hero-inner{align-items:flex-start;flex-direction:column}
.ak-dev-page .hero h1{font-size:27px}
.ak-dev-page .layout{display:block;padding-top:17px}
.ak-dev-page .side{position:static;margin-bottom:18px}
.ak-dev-page .sidebox{display:flex;overflow-x:auto;gap:4px;padding:7px}
.ak-dev-page .sideheading, .ak-dev-page .sidefoot{display:none}
.ak-dev-page .navitem{white-space:nowrap;width:auto;font-size:12px;padding:10px}
.ak-dev-page .navitem .soon{display:none}
.ak-dev-page .dev-sectiontop h2{font-size:21px}
.ak-dev-page .panel{padding:18px}
.ak-dev-page .endpoint-desc{width:100%;margin-left:0}
.ak-dev-page .foot-inner{flex-direction:column}}
@media (max-width:400px){.ak-dev-page .stats{gap:9px}
.ak-dev-page .stat{padding:14px}
.ak-dev-page .statvalue{font-size:21px}
.ak-dev-page .stathead{font-size:11px}
.ak-dev-page .stathead i{display:none}
.ak-dev-page .hero-actions{width:100%}
.ak-dev-page .hero-actions .dev-btn{flex:1}}
.ak-dev-page{background:#f7f9fc;color:#162438}
.ak-dev-page .dev-intro{padding-top:34px;padding-bottom:20px}
.ak-dev-page .dev-crumb{display:flex;align-items:center;gap:9px;color:#8290a5;font-size:12px;margin-bottom:18px}
.ak-dev-page .dev-crumb i{font-size:10px}
.ak-dev-page .dev-intro-row{display:flex;align-items:end;justify-content:space-between;gap:20px}
.ak-dev-page .dev-overline{font-size:10px;font-weight:800;letter-spacing:1.7px;color:#3774bd;margin-bottom:6px}
.ak-dev-page .dev-intro h1{font-size:32px;letter-spacing:-.9px;font-weight:800;margin:0 0 7px}
.ak-dev-page .dev-intro p{font-size:13px;color:#66768b;margin:0}
.ak-dev-page .dev-intro-actions{display:flex;gap:9px;flex-wrap:wrap}
.ak-dev-page .layout{padding-top:15px}
.ak-dev-page .dev-btn{border:1px solid transparent;border-radius:9px;padding:10px 15px;font-weight:700;font-size:12px;display:inline-flex;gap:8px;align-items:center;justify-content:center;cursor:pointer}
.ak-dev-page .dev-btn-primary{background:#176edb;color:#fff}
.ak-dev-page .dev-btn-primary:hover{background:#0d5bb9;color:#fff}
.ak-dev-page .dev-btn-outline{background:#fff;border-color:#dfe6f0;color:#34445b}
.ak-dev-page .dev-btn-outline:hover{background:#f3f7fd}
.ak-dev-page .dev-btn-danger{border-color:#f3d2d6;background:#fff6f6;color:#bc4353}
.ak-dev-page .dev-btn:disabled{opacity:.48;cursor:not-allowed}
.ak-dev-page .dev-table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}
.ak-dev-page .dev-table th{font-size:11px;color:#8493a7;background:#f7f9fc;font-weight:700}
.ak-dev-page .dev-table td, .ak-dev-page .dev-table th{padding:13px 15px;border-bottom:1px solid #e3eaf2}
.ak-dev-page .dev-table tr:last-child td{border-bottom:0}
.ak-dev-page .dev-table td{font-size:12px}
.ak-dev-page .dev-table code{font-size:11px;background:#f1f5fa;padding:5px 7px;border-radius:5px}
@media (max-width:720px){.ak-dev-page .dev-intro-row{align-items:flex-start;flex-direction:column}
.ak-dev-page .dev-intro h1{font-size:26px}
.ak-dev-page .dev-intro-actions{width:100%}
.ak-dev-page .dev-intro-actions .dev-btn{flex:1}}
.ak-dev-page .dev-section{display:none!important}
.ak-dev-page .dev-section.active{display:block!important}
.ak-dev-page .dev-endpoint-body{display:none}
.ak-dev-page .endpoint.open .dev-endpoint-body{display:block}
.ak-dev-page .navitem{cursor:pointer}
.ak-dev-page .dev-btn{font-family:inherit}
.ak-dev-page{background:#f7f9fc;color:#162438;min-height:60vh}
</style>
</head>
<body>
<%
const d = typeof developer !== 'undefined' && developer ? developer : {};
const displayName = String(d.username || 'Developer');
const safeLevel = Math.max(1,Math.min(5,Number(d.level)||1));
const safeBalance = Number.isFinite(Number(d.balance)) ? Number(d.balance) : 0;
const apiAuthorized = Number(d.api_enabled) === 1;
const keys = typeof apiKeys !== 'undefined' && Array.isArray(apiKeys) ? apiKeys : [];
const activeKeyCount = keys.filter(k => Number(k.is_active) === 1).length;
const csrfValue = typeof developerCsrfToken !== 'undefined' && typeof developerCsrfToken === 'string' ? developerCsrfToken : '';
const keyActionsReady = apiAuthorized && /^[a-f0-9]{64}$/.test(csrfValue);
%>
<%- include('partials/header', { user: typeof user !== 'undefined' ? user : d }) %>
<div class="ak-dev-page">
<section class="dev-intro shell">
  <div class="dev-crumb"><a href="/">AK Cell</a><i class="bi bi-chevron-right"></i><span>Developer Center</span></div>
  <div class="dev-intro-row">
    <div><div class="dev-overline">RESELLER API / VERSION 1</div><h1>Developer Center</h1><p>Manage your API keys, integrate orders, and explore the API reference.</p></div>
    <div class="dev-intro-actions"><button class="dev-btn dev-btn-outline" type="button" data-go="documentation"><i class="bi bi-journal-code"></i> API Reference</button><button class="dev-btn dev-btn-primary" type="button" data-go="credentials"><i class="bi bi-key"></i> API Keys</button></div>
  </div>
</section>
<div class="shell layout"><aside class="side"><nav class="sidebox" aria-label="Developer navigation"><div class="sideheading">WORKSPACE</div><button class="navitem active" data-go="overview"><i class="bi bi-grid-1x2"></i> Overview</button><button class="navitem" data-go="credentials"><i class="bi bi-key"></i> API Keys</button><button class="navitem" data-go="documentation"><i class="bi bi-journal-code"></i> API Documentation</button><button class="navitem" data-go="orders"><i class="bi bi-receipt"></i> Orders Guide</button><div class="sideheading">RESOURCES</div><button class="navitem" data-go="security"><i class="bi bi-shield-lock"></i> Security & Limits</button></nav><div class="sidefoot">REST API · JSON · HTTPS<br>Base URL: akcell.store</div></aside>
<main class="content">
<section id="overview" class="dev-section active"><div class="sectiontop"><div><h2>Developer Overview</h2><p>Your integration workspace at a glance.</p></div><span class="pill <%= apiAuthorized ? '' : 'off' %>"><i class="bi bi-circle-fill"></i><%= apiAuthorized ? 'API Access Enabled' : 'API Access Disabled' %></span></div>
<div class="stats"><div class="stat"><div class="stathead">Wallet Balance <i class="bi bi-wallet2"></i></div><div class="statvalue">$<%= safeBalance.toFixed(2) %></div><div class="statsub">Shared with your store account</div></div><div class="stat"><div class="stathead">Dealer Tier <i class="bi bi-stars"></i></div><div class="statvalue">Level <%= safeLevel %></div><div class="statsub">Your current product pricing</div></div><div class="stat"><div class="stathead">Active API Keys <i class="bi bi-key"></i></div><div class="statvalue"><%= activeKeyCount %> <span class="muted" style="font-size:15px">/ 5</span></div><div class="statsub">Private server credentials</div></div><div class="stat"><div class="stathead">API Version <i class="bi bi-code-square"></i></div><div class="statvalue">v1</div><div class="statsub">REST · JSON responses</div></div></div>
<div class="notice"><i class="bi bi-info-circle"></i><div><strong>API v1 endpoints are available for authorized accounts.</strong><p>Account, product catalog, order creation, order tracking and order history are implemented. External integrations should complete their own testing before production use.</p></div></div>
<div class="split"><div class="panel"><div class="paneltitle"><div><h3>Getting Started</h3><p>Four steps to connect your reseller platform.</p></div><i class="bi bi-rocket-takeoff"></i></div><div class="step"><span class="stepnum">01</span><div><strong>Enable API access</strong><p>API access is approved by the AK Cell administrator.</p></div></div><div class="step"><span class="stepnum">02</span><div><strong>Create your private key</strong><p>Generate a Bearer token and save it securely when it is displayed.</p></div></div><div class="step"><span class="stepnum">03</span><div><strong>Fetch your catalog</strong><p>Read available products, prices and checkout requirements.</p></div></div><div class="step"><span class="stepnum">04</span><div><strong>Place and track orders</strong><p>Use an idempotency key for purchases, then poll order status.</p></div></div></div><div class="panel"><div class="paneltitle"><div><h3>Quick API Request</h3><p>Try your first authenticated request.</p></div><i class="bi bi-terminal"></i></div><div class="code"><div class="codetop"><span>cURL · Account Information</span><button type="button" class="copy" data-copy="quickcurl"><i class="bi bi-copy"></i> Copy</button></div><pre id="quickcurl">curl -X GET "https://akcell.store/api/v1/account" \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Accept: application/json"</pre></div><p class="hint"><i class="bi bi-shield-check"></i> Use your API key only on your backend. Never embed it in public frontend code.</p><button class="dev-btn dev-btn-outline" data-go="documentation" type="button">View Full Documentation <i class="bi bi-arrow-right"></i></button></div></div>
<div class="panel"><div class="paneltitle"><div><h3>Available API Capabilities</h3><p>Currently implemented API v1 functionality.</p></div></div><div class="info-grid"><div class="mini"><h4><i class="bi bi-person-check"></i> Account & Balance</h4><p>Check reseller account information, dealer level and wallet balance.</p></div><div class="mini"><h4><i class="bi bi-box-seam"></i> Product Catalog</h4><p>List available products, dealer pricing, options and required checkout details.</p></div><div class="mini"><h4><i class="bi bi-bag-check"></i> Order Creation</h4><p>Create manual fulfillment orders with an idempotency key.</p></div><div class="mini"><h4><i class="bi bi-clock-history"></i> Order Tracking</h4><p>Check individual order status or list your API orders with pagination.</p></div></div></div></section>
<section id="credentials" class="dev-section"><div class="sectiontop"><div><h2>API Key Management</h2><p>Create, review and revoke credentials for your integrations.</p></div><span class="pill <%= apiAuthorized ? '' : 'off' %>"><i class="bi bi-circle-fill"></i><%= apiAuthorized ? 'Access Approved' : 'Access Disabled' %></span></div><div class="notice"><i class="bi bi-shield-lock"></i><div><strong>Keep your credentials private.</strong><p>The complete API key is displayed only once, immediately after creation. Existing keys cannot be revealed again. Revoke compromised keys promptly.</p></div></div><div class="panel"><div class="paneltitle"><div><h3>Your API Keys</h3><p>Manage your server-side integrations.</p></div><span class="keylimit"><%= activeKeyCount %> of 5 active</span></div><% if(keys.length){ %><div class="tablewrap"><table class="dev-table"><thead><tr><th>KEY NAME</th><th>KEY PREFIX</th><th>STATUS</th><th>CREATED</th><th>ACTIONS</th></tr></thead><tbody><% keys.forEach(function(k){ %><tr><td><strong><%= k.key_name %></strong></td><td><code><%= k.key_prefix %>…</code></td><td><span class="keybadge <%= Number(k.is_active) === 1 ? '' : 'revoked' %>"><%= Number(k.is_active) === 1 ? 'Active' : 'Revoked' %></span></td><td><%= k.created_at ? String(k.created_at).slice(0,19) : '—' %></td><td><% if(Number(k.is_active) === 1 && keyActionsReady){ %><form method="POST" action="/developer/keys/<%= Number(k.id) %>/revoke" class="akc-revoke-form" data-key-name="<%= k.key_name %>"><input type="hidden" name="_csrf" value="<%= csrfValue %>"><button type="submit" class="dev-btn btn-danger" style="padding:6px 10px"><i class="bi bi-x-circle"></i> Revoke</button></form><% } else { %><span class="muted">—</span><% } %></td></tr><% }); %></tbody></table></div><% } else { %><div class="empty"><i class="bi bi-key"></i><strong>No API keys yet</strong><span>Create a private key to start integrating with AK Cell.</span></div><% } %><hr class="divider"><h3 style="font-size:14px;margin:0 0 12px">Create a new API key</h3><% if(keyActionsReady){ %><form id="createKeyForm" method="POST" action="/developer/keys/create" class="formrow"><input type="hidden" name="_csrf" value="<%= csrfValue %>"><input class="field" name="key_name" type="text" maxlength="100" required placeholder="e.g. Production Backend" aria-label="API key name"><button class="dev-btn dev-btn-primary" type="submit" id="createKeyButton" <%= activeKeyCount >= 5 ? 'disabled' : '' %>><i class="bi bi-plus-lg"></i> Generate API Key</button></form><p class="hint"><%= activeKeyCount >= 5 ? 'Maximum active key limit reached. Revoke an active key to create another.' : 'Maximum 5 active keys per account. Choose a descriptive name for each integration.' %></p><% } else { %><button class="dev-btn dev-btn-primary" disabled>Generate API Key</button><p class="hint">Key creation requires approved access and a valid security token. Refresh the page or contact support.</p><% } %></div></section>
<section id="documentation" class="dev-section"><div class="sectiontop"><div><h2>API Documentation</h2><p>Reference for the AK Cell Reseller REST API.</p></div><span class="pill"><i class="bi bi-circle-fill"></i> API v1</span></div><div class="panel"><div class="paneltitle"><div><h3>Overview</h3><p>Build secure server-to-server integrations using HTTPS and JSON.</p></div></div><p class="small">All API routes use the following base URL:</p><div class="code"><div class="codetop"><span>BASE URL</span><button type="button" class="copy" data-copy="baseurl"><i class="bi bi-copy"></i> Copy</button></div><pre id="baseurl">https://akcell.store/api/v1</pre></div><div class="info-grid"><div class="mini"><h4>Authentication</h4><p><span class="inlinecode">Authorization: Bearer YOUR_API_KEY</span></p></div><div class="mini"><h4>Content type</h4><p><span class="inlinecode">Content-Type: application/json</span> for POST requests.</p></div></div></div>
<div class="docsnav"><button type="button" data-open="ep-account">Account</button><button type="button" data-open="ep-products">Products</button><button type="button" data-open="ep-product">Product Details</button><button type="button" data-open="ep-create">Create Order</button><button type="button" data-open="ep-track">Order Status</button><button type="button" data-open="ep-history">Order History</button></div>
<div class="endpoint open" id="ep-account"><div class="endpoint-head" role="button" tabindex="0"><span class="method">GET</span><span class="path">/account</span><span class="endpoint-desc">Account profile and balance</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Returns the authenticated reseller account, dealer level, balance and API permission.</p><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-account" type="button">Copy</button></div><pre id="c-account">curl "https://akcell.store/api/v1/account" \
  -H "Authorization: Bearer YOUR_API_KEY"</pre></div><div class="code"><div class="codetop">EXAMPLE RESPONSE</div><pre>{
  "success": true,
  "data": {
    "id": 123,
    "username": "example_reseller",
    "dealer_level": 2,
    "balance": 100.00,
    "currency": "USD",
    "api_access": true
  }
}</pre></div></div></div>
<div class="endpoint" id="ep-products"><div class="endpoint-head" role="button" tabindex="0"><span class="method">GET</span><span class="path">/products</span><span class="endpoint-desc">Available catalog and reseller prices</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Returns products available to the authenticated reseller, including options, prices and availability.</p><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-products" type="button">Copy</button></div><pre id="c-products">curl "https://akcell.store/api/v1/products" \
  -H "Authorization: Bearer YOUR_API_KEY"</pre></div><p class="hint">Prices depend on the authenticated reseller's dealer level. Product availability may change.</p></div></div>
<div class="endpoint" id="ep-product"><div class="endpoint-head" role="button" tabindex="0"><span class="method">GET</span><span class="path">/products/:id</span><span class="endpoint-desc">Product options and checkout requirements</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Read a specific product before ordering. Check its available options and required fields such as player ID or account details.</p><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-product" type="button">Copy</button></div><pre id="c-product">curl "https://akcell.store/api/v1/products/61" \
  -H "Authorization: Bearer YOUR_API_KEY"</pre></div></div></div>
<div class="endpoint" id="ep-create"><div class="endpoint-head" role="button" tabindex="0"><span class="method post">POST</span><span class="path">/orders</span><span class="endpoint-desc">Create a reseller order</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Creates one unit of the selected product and charges the reseller wallet when the request is valid. The API does not accept a quantity field. A unique <span class="inlinecode">Idempotency-Key</span> header is required to protect retries from duplicate charges.</p><div class="tablewrap"><table class="dev-table"><thead><tr><th>FIELD</th><th>REQUIRED</th><th>DESCRIPTION</th></tr></thead><tbody><tr><td><code>product_id</code></td><td>Yes</td><td>Product identifier</td></tr><tr><td><code>option_id</code></td><td>Conditional</td><td>Selected product option</td></tr><tr><td><code>player_id</code></td><td>Conditional</td><td>Player / account ID</td></tr><tr><td><code>checkout_choice</code></td><td>Conditional</td><td>Checkout selection when applicable</td></tr><tr><td><code>account_email</code></td><td>Conditional</td><td>Account email when required</td></tr><tr><td><code>account_password</code></td><td>Conditional</td><td>Account password when required</td></tr></tbody></table></div><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-create" type="button">Copy</button></div><pre id="c-create">curl -X POST "https://akcell.store/api/v1/orders" \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -H "Idempotency-Key: YOUR_UNIQUE_ORDER_REFERENCE" \
  -d '{"product_id":61}'</pre></div><div class="callout"><strong>Important:</strong> This example is a real purchase request, not a sandbox call. Do not add unsupported fields such as quantity. It may charge your wallet and create an order. Use a fresh idempotency key per intended purchase; reuse the same key only when retrying that purchase.</div><p class="hint">A retry with the same key and identical payload returns the original order (HTTP 200 with idempotent_replay=true). Reusing the key with a different payload returns HTTP 409. A rejected order can trigger a refund according to the platform's fulfillment rules.</p></div></div>
<div class="endpoint" id="ep-track"><div class="endpoint-head" role="button" tabindex="0"><span class="method">GET</span><span class="path">/orders/:id</span><span class="endpoint-desc">Track a single API order</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Returns the status of an API order belonging to the authenticated reseller. Other users' orders and website-only orders are not exposed.</p><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-track" type="button">Copy</button></div><pre id="c-track">curl "https://akcell.store/api/v1/orders/ORDER_ID" \
  -H "Authorization: Bearer YOUR_API_KEY"</pre></div><div class="code"><div class="codetop">EXAMPLE RESPONSE</div><pre>{
  "success": true,
  "data": {
    "order_id": 12345,
    "product_id": 36,
    "product_name": "Example Product",
    "price": 18,
    "currency": "USD",
    "status": "rejected",
    "fulfillment": "manual",
    "admin_reply": "",
    "created_at": "2026-11-20 10:54:09"
  }
}</pre></div></div></div>
<div class="endpoint" id="ep-history"><div class="endpoint-head" role="button" tabindex="0"><span class="method">GET</span><span class="path">/orders</span><span class="endpoint-desc">Paginated reseller order history</span><i class="bi bi-chevron-down chevron"></i></div><div class="dev-endpoint-body"><p class="small muted">Lists only the authenticated reseller's API orders, newest first.</p><div class="tablewrap"><table class="dev-table"><thead><tr><th>QUERY</th><th>DEFAULT</th><th>DESCRIPTION</th></tr></thead><tbody><tr><td><code>page</code></td><td>1</td><td>Page number</td></tr><tr><td><code>limit</code></td><td>20</td><td>Results per page, maximum 100</td></tr><tr><td><code>status</code></td><td>All</td><td>pending, processing, completed, partial, rejected</td></tr></tbody></table></div><div class="code"><div class="codetop"><span>REQUEST · cURL</span><button class="copy" data-copy="c-history" type="button">Copy</button></div><pre id="c-history">curl "https://akcell.store/api/v1/orders?page=1&amp;limit=20&amp;status=rejected" \
  -H "Authorization: Bearer YOUR_API_KEY"</pre></div><p class="hint">Response includes <code>data</code> and <code>pagination</code> with page, limit, total, total_pages and has_next_page.</p></div></div>
<div class="panel"><div class="paneltitle"><div><h3>Order Status Reference</h3><p>Use these values when displaying and reconciling orders.</p></div></div><div class="tablewrap"><table class="dev-table status-table"><thead><tr><th>STATUS</th><th>MEANING</th></tr></thead><tbody><tr><td>pending</td><td>Order received and waiting for processing.</td></tr><tr><td>processing</td><td>Order is being processed.</td></tr><tr><td>completed</td><td>Order has been accepted / fulfilled.</td></tr><tr><td>partial</td><td>Order has been marked partially fulfilled; review details with support.</td></tr><tr><td>rejected</td><td>Order rejected; applicable wallet refund is handled by platform rules.</td></tr></tbody></table></div></div><div class="panel"><div class="paneltitle"><div><h3>Error Handling</h3><p>Use HTTP status codes and the JSON <code>error</code> field.</p></div></div><div class="tablewrap"><table class="dev-table"><thead><tr><th>HTTP</th><th>MEANING</th></tr></thead><tbody><tr><td>200 / 201</td><td>Successful request</td></tr><tr><td>400</td><td>Invalid or missing parameters</td></tr><tr><td>401</td><td>Invalid or missing authentication</td></tr><tr><td>403</td><td>Access not permitted</td></tr><tr><td>402</td><td>Insufficient wallet balance</td></tr><tr><td>404</td><td>Resource not found or not accessible</td></tr><tr><td>409</td><td>Idempotency key conflict</td></tr><tr><td>429</td><td>Rate limit exceeded</td></tr><tr><td>5xx</td><td>Server-side error; retry safely using the original idempotency key</td></tr></tbody></table></div><div class="code"><div class="codetop">EXAMPLE ERROR</div><pre>{
  "success": false,
  "error": "INSUFFICIENT_BALANCE"
}</pre></div></div></section>
<section id="orders" class="dev-section"><div class="sectiontop"><div><h2>Orders & Integration Workflow</h2><p>Understand the complete purchase and tracking lifecycle.</p></div></div><div class="panel"><div class="paneltitle"><div><h3>Recommended Order Flow</h3><p>Implement this flow in your backend service.</p></div></div><div class="step"><span class="stepnum">01</span><div><strong>Fetch products</strong><p>Call <code>GET /products</code> and <code>GET /products/:id</code> to determine current pricing and required fields.</p></div></div><div class="step"><span class="stepnum">02</span><div><strong>Generate a stable order reference</strong><p>Create a unique idempotency key for each intended purchase and save it with your local order.</p></div></div><div class="step"><span class="stepnum">03</span><div><strong>Submit the purchase</strong><p>Call <code>POST /orders</code>. Do not generate a new key merely because the network timed out.</p></div></div><div class="step"><span class="stepnum">04</span><div><strong>Track status</strong><p>Use <code>GET /orders/:id</code> and <code>GET /orders</code> to reconcile processing and final statuses.</p></div></div><div class="step"><span class="stepnum">05</span><div><strong>Handle refunds and failures</strong><p>Handle rejected orders and wallet balance changes according to the response and platform policy.</p></div></div></div><div class="notice"><i class="bi bi-arrow-repeat"></i><div><strong>Polling is the supported tracking approach.</strong><p>Webhook callbacks, client_order_id lookup and independent player validation are not documented as active AK Cell API v1 endpoints.</p></div></div><button class="dev-btn dev-btn-primary" type="button" data-go="documentation">Open Endpoint Reference <i class="bi bi-arrow-right"></i></button></section>
<section id="security" class="dev-section"><div class="sectiontop"><div><h2>Security & API Limits</h2><p>Protect your credentials and integrate responsibly.</p></div></div><div class="info-grid" style="margin-bottom:18px"><div class="mini"><h4><i class="bi bi-lock"></i> Backend-Only Credentials</h4><p>Store Bearer tokens in server environment variables or a secure secrets manager. Never expose them in browsers or mobile applications.</p></div><div class="mini"><h4><i class="bi bi-shield-check"></i> HTTPS Required</h4><p>Send requests only over HTTPS to the official AK Cell API domain.</p></div><div class="mini"><h4><i class="bi bi-arrow-repeat"></i> Safe Retries</h4><p>Use the same idempotency key and payload when retrying an uncertain purchase response.</p></div><div class="mini"><h4><i class="bi bi-person-lock"></i> Account Isolation</h4><p>Order detail and history endpoints restrict results to the authenticated reseller's API orders.</p></div></div><div class="panel"><div class="paneltitle"><div><h3>Current Limits</h3><p>Limits are enforced by the server and may be adjusted.</p></div></div><div class="tablewrap"><table class="dev-table"><thead><tr><th>RESOURCE</th><th>LIMIT</th></tr></thead><tbody><tr><td>Active API keys</td><td>5 per account</td></tr><tr><td>API requests</td><td>60 per minute per IP</td></tr><tr><td>Order history page size</td><td>100 maximum</td></tr><tr><td>Order history page number</td><td>1–1,000,000</td></tr></tbody></table></div><p class="hint">Do not treat these as guaranteed throughput commitments. Handle HTTP 429 with backoff.</p></div><div class="callout"><strong>Security note:</strong> If an API key is exposed, revoke it in API Key Management and generate a replacement. Do not share complete keys with support.</div></section>
</main></div>
</div>
<%- include('partials/footer') %>
<script>
(function(){
  function navigate(name){
    if(!document.getElementById(name)) return;
    document.querySelectorAll('.ak-dev-page .dev-section').forEach(el=>el.classList.toggle('active',el.id===name));
    document.querySelectorAll('.ak-dev-page .navitem[data-go]').forEach(el=>el.classList.toggle('active',el.dataset.go===name));
    history.replaceState(null,'','#'+name);
    window.scrollTo({top:0,behavior:'smooth'});
  }
  document.querySelectorAll('.ak-dev-page [data-go]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.go)));
  document.querySelectorAll('.ak-dev-page .endpoint-head').forEach(el=>{
    const toggle=()=>el.parentElement.classList.toggle('open');
    el.addEventListener('click',toggle);
    el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();toggle();}});
  });
  document.querySelectorAll('.ak-dev-page [data-open]').forEach(el=>el.addEventListener('click',()=>{
    const target=document.getElementById(el.dataset.open);if(!target)return;
    target.classList.add('open');target.scrollIntoView({behavior:'smooth',block:'start'});
  }));
  document.querySelectorAll('.ak-dev-page [data-copy]').forEach(el=>el.addEventListener('click',async()=>{
    const target=document.getElementById(el.dataset.copy);if(!target)return;
    try{await navigator.clipboard.writeText(target.textContent);const old=el.textContent;el.textContent='Copied!';setTimeout(()=>el.textContent=old,1400);}catch(err){el.textContent='Select text to copy';}
  }));
  const createForm=document.getElementById('createKeyForm');
  if(createForm)createForm.addEventListener('submit',()=>{const devButton=document.getElementById('createKeyButton');if(devButton){devButton.disabled=true;devButton.textContent='Generating...';}});
  const initial=location.hash.slice(1);if(['overview','credentials','documentation','orders','security'].includes(initial))navigate(initial);
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
.akc-revoke-overlay{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(9,24,46,.66);backdrop-filter:blur(5px)}
.akc-revoke-overlay.is-open{display:flex}
.akc-revoke-dialog{position:relative;width:100%;max-width:460px;max-height:calc(100dvh - 40px);overflow:auto;background:#fff;border:1px solid #e4eaf2;border-radius:22px;padding:30px;box-shadow:0 28px 80px rgba(5,20,45,.27);color:#10213e}
.akc-revoke-close{position:absolute;top:18px;right:18px;width:36px;height:36px;border:0;border-radius:10px;background:#f1f5f9;color:#64748b;cursor:pointer}
.akc-revoke-icon{width:60px;height:60px;display:grid;place-items:center;border-radius:17px;background:#fef2f2;color:#dc2626;font-size:27px;margin-bottom:18px}
.akc-revoke-eyebrow{font-size:11px;font-weight:800;letter-spacing:1px;color:#dc2626;text-transform:uppercase}
.akc-revoke-title{font-size:24px;font-weight:800;margin:7px 0 10px}
.akc-revoke-description{color:#64748b;font-size:14px;line-height:1.75;margin:0 0 18px}
.akc-revoke-keybox{display:flex;gap:12px;align-items:center;padding:13px 15px;border:1px solid #e3eaf3;border-radius:12px;background:#f5f8fc;margin-bottom:16px}
.akc-revoke-keybox>i{color:#2563eb;font-size:20px}
.akc-revoke-keylabel{display:block;font-size:10px;color:#7b8ba0;font-weight:800;letter-spacing:.7px}
.akc-revoke-keyname{display:block;font-size:14px;overflow-wrap:anywhere}
.akc-revoke-warning{display:flex;align-items:flex-start;gap:11px;padding:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;color:#9a3412;font-size:13px;line-height:1.65}
.akc-revoke-actions{display:flex;gap:12px;margin-top:24px}
.akc-revoke-btn{flex:1;min-height:46px;border-radius:11px;padding:12px;border:1px solid transparent;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}
.akc-revoke-cancel{background:#fff;color:#334155;border-color:#dce5ef}
.akc-revoke-confirm{background:#dc2626;color:#fff}
.akc-revoke-confirm:hover{background:#b91c1c}
.akc-revoke-btn:disabled,.akc-revoke-close:disabled{opacity:.6;cursor:not-allowed}
.akc-revoke-btn:focus-visible,.akc-revoke-close:focus-visible{outline:3px solid #93c5fd;outline-offset:2px}
@media(max-width:480px){.akc-revoke-dialog{padding:22px}.akc-revoke-actions{flex-direction:column-reverse}}
</style>
<div id="akcRevokeModal" class="akc-revoke-overlay" role="dialog" aria-modal="true" aria-labelledby="akcRevokeTitle" aria-describedby="akcRevokeDescription" aria-hidden="true">
  <div class="akc-revoke-dialog" tabindex="-1">
    <button type="button" class="akc-revoke-close" id="akcRevokeClose" aria-label="Close"><i class="bi bi-x-lg"></i></button>
    <div class="akc-revoke-icon"><i class="bi bi-shield-x"></i></div>
    <div class="akc-revoke-eyebrow">Security Action</div>
    <h2 id="akcRevokeTitle" class="akc-revoke-title">Revoke API Key?</h2>
    <p id="akcRevokeDescription" class="akc-revoke-description">This key will immediately stop working for every connected integration.</p>
    <div class="akc-revoke-keybox"><i class="bi bi-key"></i><div><span class="akc-revoke-keylabel">SELECTED API KEY</span><strong id="akcRevokeKeyName" class="akc-revoke-keyname">API Key</strong></div></div>
    <div class="akc-revoke-warning"><i class="bi bi-exclamation-triangle-fill"></i><span><strong>This action cannot be undone.</strong> Create a new API key and update your integrations to restore access.</span></div>
    <div class="akc-revoke-actions">
      <button type="button" class="akc-revoke-btn akc-revoke-cancel" id="akcRevokeCancel">Cancel</button>
      <button type="button" class="akc-revoke-btn akc-revoke-confirm" id="akcRevokeConfirm"><i class="bi bi-x-circle"></i> <span id="akcRevokeConfirmText">Revoke API Key</span></button>
    </div>
  </div>
</div>
<script>
(function(){
  'use strict';
  const modal=document.getElementById('akcRevokeModal');
  const close=document.getElementById('akcRevokeClose');
  const cancel=document.getElementById('akcRevokeCancel');
  const confirm=document.getElementById('akcRevokeConfirm');
  const confirmText=document.getElementById('akcRevokeConfirmText');
  const keyName=document.getElementById('akcRevokeKeyName');
  if(!modal||!close||!cancel||!confirm||!confirmText||!keyName)return;
  let form=null,previousFocus=null,previousOverflow='',submitting=false;
  function dismiss(){
    if(submitting)return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow=previousOverflow;
    form=null;
    if(previousFocus&&typeof previousFocus.focus==='function')previousFocus.focus();
  }
  document.addEventListener('submit',function(e){
    const target=e.target;
    if(!(target instanceof HTMLFormElement)||!target.classList.contains('akc-revoke-form'))return;
    e.preventDefault();
    e.stopImmediatePropagation();
    if(submitting)return;
    if(!/^\/developer\/keys\/\d+\/revoke$/.test(target.getAttribute('action')||''))return;
    form=target;
    previousFocus=document.activeElement;
    previousOverflow=document.body.style.overflow;
    keyName.textContent=target.dataset.keyName||'API Key';
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow='hidden';
    cancel.focus();
  },true);
  confirm.addEventListener('click',function(){
    if(!form||submitting)return;
    const token=form.querySelector('input[name="_csrf"]');
    if(!token||!token.value){alert('Security token missing. Refresh the page and try again.');return;}
    submitting=true;
    confirm.disabled=cancel.disabled=close.disabled=true;
    confirmText.textContent='Revoking...';
    HTMLFormElement.prototype.submit.call(form);
  });
  cancel.addEventListener('click',dismiss);
  close.addEventListener('click',dismiss);
  modal.addEventListener('click',e=>{if(e.target===modal)dismiss();});
  document.addEventListener('keydown',function(e){
    if(!modal.classList.contains('is-open'))return;
    if(e.key==='Escape'){e.preventDefault();dismiss();return;}
    if(e.key!=='Tab')return;
    const items=[close,cancel,confirm].filter(x=>!x.disabled);
    if(!items.length){e.preventDefault();return;}
    const first=items[0],last=items[items.length-1];
    if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
    else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}
  });
})();
</script>

</body></html>
