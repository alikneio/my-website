
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>Developers · AK Cell</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --ink:#182330;
      --muted:#667587;
      --line:#dfe5ec;
      --canvas:#f4f6f9;
      --paper:#fff;
      --brand:#168dc2;
      --brand-soft:#eaf6fb;
      --nav:#151c25;
      --gold:#c99b48;
    }

    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      margin:0;
      background:var(--canvas);
      color:var(--ink);
      font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
      font-size:14px;
      -webkit-font-smoothing:antialiased;
    }
    a { color:inherit;text-decoration:none; }
    a:hover { color:var(--brand); }
    button,input { font:inherit; }
    .wrap { max-width:1190px;margin:auto;padding:0 25px; }

    .top {
      background:var(--nav);
      color:#f6f8fa;
      border-bottom:3px solid var(--gold);
    }
    .top-inner {
      min-height:69px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }
    .brand {
      display:flex;
      align-items:center;
      gap:11px;
      color:#fff;
      font-weight:800;
      font-size:19px;
      letter-spacing:.3px;
    }
    .brand:hover { color:#fff; }
    .brand-symbol {
      width:33px;height:33px;
      border-radius:7px;
      background:#178fc4;
      display:grid;
      place-items:center;
      font-size:18px;
    }
    .brand .sep {
      height:24px;width:1px;
      background:#4c5866;
      margin:0 3px;
    }
    .brand .section {
      font-size:13px;
      font-weight:500;
      color:#c1ccd7;
      letter-spacing:0;
    }
    .top-right {
      display:flex;
      align-items:center;
      gap:22px;
    }
    .top-right a { color:#c6d0da;font-size:13px; }
    .top-right a:hover { color:#fff; }
    .user-tag {
      display:flex;
      align-items:center;
      gap:8px;
      color:#e4ebf3;
      font-size:13px;
    }
    .user-circle {
      width:29px;height:29px;
      border-radius:50%;
      background:#374452;
      display:grid;
      place-items:center;
      font-weight:700;
    }

    .subnav { background:#fff;border-bottom:1px solid var(--line); }
    .subnav-inner { display:flex;gap:28px;overflow-x:auto; }
    .subnav a {
      display:inline-flex;
      align-items:center;
      gap:8px;
      white-space:nowrap;
      padding:15px 1px 13px;
      border-bottom:2px solid transparent;
      color:#657184;
      font-size:13px;
    }
    .subnav a.active {
      border-color:var(--brand);
      color:#1d3344;
      font-weight:650;
    }
    .subnav a:hover { color:var(--brand); }
    .subnav .notready { color:#9aa5b2;cursor:default; }

    .main { padding-top:39px;padding-bottom:75px; }
    .crumb { font-size:12px;color:#8995a2;margin-bottom:16px; }
    .crumb span { color:#3e4d5b; }
    .heading {
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      margin-bottom:28px;
    }
    .heading h1 {
      font-size:30px;
      font-weight:730;
      letter-spacing:-.9px;
      margin:0 0 8px;
    }
    .heading p { margin:0;color:var(--muted);font-size:14px; }
    .status {
      display:inline-flex;
      align-items:center;
      gap:7px;
      padding:7px 11px;
      border:1px solid #cde6d8;
      background:#f2faf5;
      color:#23744c;
      border-radius:6px;
      font-size:12px;
      font-weight:650;
      white-space:nowrap;
    }
    .status:before {
      content:"";
      width:7px;height:7px;
      background:#38a46c;
      border-radius:50%;
    }
    .notice {
      border:1px solid #d8e6ee;
      background:#f1f8fb;
      border-left:3px solid var(--brand);
      padding:15px 18px;
      border-radius:5px;
      display:flex;
      gap:12px;
      align-items:flex-start;
      margin-bottom:27px;
    }
    .notice i { color:#258ab6;font-size:17px; }
    .notice strong { font-weight:680; }
    .notice p {
      margin:4px 0 0;
      color:#657586;
      font-size:13px;
      line-height:1.6;
    }

    .section-title {
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      margin:33px 0 14px;
    }
    .section-title h2 {
      font-size:17px;
      font-weight:730;
      margin:0;
      letter-spacing:-.25px;
    }
    .section-title .small-note { font-size:12px;color:#7a8998; }
    .surface {
      background:var(--paper);
      border:1px solid var(--line);
      border-radius:8px;
      box-shadow:0 2px 9px rgba(25,45,65,.025);
    }
    .summary-grid {
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:13px;
    }
    .stat { padding:19px 20px;min-height:123px; }
    .stat-label {
      color:#6c7a89;
      font-size:12px;
      margin-bottom:15px;
      display:flex;
      justify-content:space-between;
      gap:8px;
    }
    .stat-label i { font-size:17px;color:#8795a3; }
    .stat-value {
      font-size:25px;
      letter-spacing:-.7px;
      font-weight:720;
      line-height:1.1;
    }
    .stat-sub { font-size:11px;color:#8592a0;margin-top:9px; }
    .good { color:#23744c; }

    .card-pad { padding:23px 25px; }
    .card-heading {
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
    }
    .card-heading h3 {
      font-size:15px;
      font-weight:720;
      margin:0 0 6px;
    }
    .card-heading p {
      font-size:13px;
      color:var(--muted);
      margin:0;
      line-height:1.6;
    }
    .tag {
      font-size:11px;
      border:1px solid #dce3ea;
      background:#f8fafc;
      color:#718092;
      border-radius:4px;
      padding:5px 8px;
      white-space:nowrap;
    }
    .rule { height:1px;background:var(--line);margin:20px 0; }
    .empty { text-align:center;padding:35px 10px 31px; }
    .empty-icon {
      display:inline-grid;
      place-items:center;
      width:45px;height:45px;
      background:#f1f5f8;
      border:1px solid #e2e9ee;
      border-radius:9px;
      color:#6c8496;
      font-size:20px;
      margin-bottom:13px;
    }
    .empty h4 { font-size:15px;font-weight:700;margin-bottom:7px; }
    .empty p { font-size:13px;color:var(--muted);margin:0; }

    .btn-main {
      border:1px solid #0d80b3;
      background:#148fc5;
      color:white;
      padding:10px 15px;
      border-radius:5px;
      font-size:12px;
      font-weight:650;
    }
    .btn-main:hover { background:#087cad;color:white; }
    .btn-main:disabled {
      background:#e9edf1;
      color:#8c98a4;
      border-color:#d9e0e7;
      cursor:not-allowed;
    }
    .form-control {
      border-color:#d7e0e8;
      border-radius:5px;
      font-size:13px;
      padding:10px 12px;
    }
    .form-control:focus {
      border-color:#52a7cc;
      box-shadow:0 0 0 3px #168dc21a;
    }
    .form-hint { font-size:12px;color:#8995a2;margin-top:9px; }

    .table { font-size:12px;margin:0; }
    .table th {
      color:#718092;
      font-weight:650;
      border-bottom:1px solid var(--line);
      background:#f8fafc;
      padding:12px;
    }
    .table td {
      vertical-align:middle;
      padding:12px;
      border-color:#e9edf2;
    }
    .table code {
      color:#526879;
      background:#f2f5f7;
      padding:3px 5px;
      border-radius:3px;
    }
    .key-active { color:#23744c; }
    .key-revoked { color:#8794a1; }
    .btn-revoke {
      border:1px solid #e2baba;
      color:#a63e3e;
      background:white;
      border-radius:4px;
      padding:5px 9px;
      font-size:12px;
    }
    .btn-revoke:hover { background:#fff4f4; }

    .doc-grid {
      display:grid;
      grid-template-columns:1.25fr .75fr;
      gap:15px;
    }
    .doc-title { font-size:14px;font-weight:700;margin-bottom:7px; }
    .doc-desc {
      color:var(--muted);
      font-size:13px;
      line-height:1.65;
      margin-bottom:16px;
    }
    .code-top {
      background:#27313c;
      color:#d4dce4;
      border-radius:6px 6px 0 0;
      font:11px ui-monospace,SFMono-Regular,Consolas,monospace;
      padding:10px 15px;
      display:flex;
      justify-content:space-between;
    }
    .code-body {
      background:#1b232d;
      color:#d8e8f3;
      border-radius:0 0 6px 6px;
      padding:17px;
      overflow:auto;
      font:12px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;
      white-space:pre-wrap;
      overflow-wrap:anywhere;
    }
    .doc-step {
      display:flex;
      gap:12px;
      padding:13px 0;
      border-bottom:1px solid #edf0f3;
    }
    .doc-step:last-child { border:0; }
    .step-n {
      font:12px ui-monospace,monospace;
      color:#8c99a6;
      width:21px;
      flex:none;
    }
    .doc-step strong {
      font-size:13px;
      display:block;
      font-weight:680;
    }
    .doc-step p {
      font-size:12px;
      color:#7b8997;
      margin:5px 0 0;
      line-height:1.55;
    }
    .footer {
      border-top:1px solid var(--line);
      padding:22px 0;
      color:#8b97a3;
      font-size:12px;
    }
    .footer-inner {
      display:flex;
      justify-content:space-between;
      gap:10px;
    }

    @media(max-width:850px) {
      .summary-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .doc-grid { grid-template-columns:1fr; }
      .top-right .user-tag { display:none; }
    }
    @media(max-width:520px) {
      .wrap { padding:0 16px; }
      .heading { flex-direction:column; }
      .heading h1 { font-size:25px; }
      .summary-grid { gap:9px; }
      .stat { padding:15px;min-height:116px; }
      .stat-value { font-size:22px; }
      .card-pad { padding:19px 16px; }
      .top-right { gap:10px; }
      .brand .section { display:none; }
      .subnav-inner { gap:20px; }
      .footer-inner { flex-direction:column; }
    }
  </style>
</head>

<body>
<%
  const d = typeof developer !== 'undefined' && developer
    ? developer
    : {};

  const displayName = String(d.username || 'Developer');

  const safeLevel = Math.max(
    1,
    Math.min(5, Number(d.level) || 1)
  );

  const safeBalance = Number.isFinite(Number(d.balance))
    ? Number(d.balance)
    : 0;

  const apiAuthorized = Number(d.api_enabled) === 1;

  const keys = typeof apiKeys !== 'undefined' && Array.isArray(apiKeys)
    ? apiKeys
    : [];

  const activeKeyCount = keys.filter(
    k => Number(k.is_active) === 1
  ).length;

  // Uses the CSRF token set by developerCsrfToken middleware.
  const csrfValue =
    typeof developerCsrfToken !== 'undefined' &&
    typeof developerCsrfToken === 'string'
      ? developerCsrfToken
      : '';

  const keyActionsReady =
    apiAuthorized &&
    /^[a-f0-9]{64}$/.test(csrfValue);
%>

<header class="top">
  <div class="wrap top-inner">
    <a href="/" class="brand">
      <span class="brand-symbol">
        <i class="bi bi-link-45deg"></i>
      </span>
      AK CELL
      <span class="sep"></span>
      <span class="section">Developers</span>
    </a>

    <div class="top-right">
      <a href="/">
        <i class="bi bi-arrow-left me-1"></i>
        Back to store
      </a>
      <span class="user-tag">
        <span class="user-circle">
          <%= displayName.charAt(0).toUpperCase() %>
        </span>
        <%= displayName %>
      </span>
    </div>
  </div>
</header>

<nav class="subnav">
  <div class="wrap subnav-inner">
    <a class="active" href="/developer">
      <i class="bi bi-grid"></i> Overview
    </a>
    <a href="#credentials">
      <i class="bi bi-key"></i> Credentials
    </a>
    <a href="#documentation">
      <i class="bi bi-journal-code"></i> Documentation
    </a>
    <a class="notready" aria-disabled="true">
      <i class="bi bi-box"></i> Products · Soon
    </a>
    <a class="notready" aria-disabled="true">
      <i class="bi bi-receipt"></i> Orders · Soon
    </a>
  </div>
</nav>

<main class="wrap main">

  <div class="crumb">
    AK Cell <span class="mx-2">/</span>
    Developers <span class="mx-2">/</span>
    <span>Overview</span>
  </div>

  <div class="heading">
    <div>
      <h1>Developer overview</h1>
      <p>
        Manage API credentials and integration access for your AK Cell account.
      </p>
    </div>
    <span class="status">
      <%= apiAuthorized
        ? 'Developer access approved'
        : 'Access disabled' %>
    </span>
  </div>

  <div class="notice">
    <i class="bi bi-info-circle"></i>
    <div>
      <strong>Reseller API integration is in preparation</strong>
      <p>
        Credential management is available for authorized developers.
        Product browsing and external ordering endpoints are still
        under development.
      </p>
    </div>
  </div>

  <div class="section-title">
    <h2>Account summary</h2>
    <span class="small-note">
      Linked to your existing AK Cell account
    </span>
  </div>

  <div class="summary-grid">
    <div class="surface stat">
      <div class="stat-label">
        Dealer level <i class="bi bi-person-badge"></i>
      </div>
      <div class="stat-value">Level <%= safeLevel %></div>
      <div class="stat-sub">Current pricing tier</div>
    </div>

    <div class="surface stat">
      <div class="stat-label">
        Wallet balance <i class="bi bi-wallet2"></i>
      </div>
      <div class="stat-value">$<%= safeBalance.toFixed(2) %></div>
      <div class="stat-sub">Shared with AK Cell</div>
    </div>

    <div class="surface stat">
      <div class="stat-label">
        API permission <i class="bi bi-shield-check"></i>
      </div>
      <div class="stat-value good" style="font-size:21px">
        <%= apiAuthorized ? 'Approved' : 'Disabled' %>
      </div>
      <div class="stat-sub">Controlled by administrator</div>
    </div>

    <div class="surface stat">
      <div class="stat-label">
        Active credentials <i class="bi bi-key"></i>
      </div>
      <div class="stat-value"><%= activeKeyCount %></div>
      <div class="stat-sub">Maximum 5 active keys</div>
    </div>
  </div>

  <section id="credentials">
    <div class="section-title">
      <h2>API credentials</h2>
      <span class="small-note">Authentication &amp; access</span>
    </div>

    <div class="surface card-pad">
      <div class="card-heading">
        <div>
          <h3>Access keys</h3>
          <p>
            Create credentials for your server-side integration.
            The full API key is displayed only once, immediately
            after creation.
          </p>
        </div>
        <span class="tag">Private credentials</span>
      </div>

      <div class="rule"></div>

      <% if (keys.length > 0) { %>
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Key prefix</th>
                <th>Status</th>
                <th>Created</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% keys.forEach(function(k) { %>
                <tr>
                  <td><%= k.key_name %></td>
                  <td><code><%= k.key_prefix %>…</code></td>
                  <td class="<%= Number(k.is_active) === 1 ? 'key-active' : 'key-revoked' %>">
                    <%= Number(k.is_active) === 1 ? 'Active' : 'Revoked' %>
                  </td>
                  <td>
                    <%= k.created_at
                      ? String(k.created_at).slice(0,19)
                      : '—' %>
                  </td>
                  <td>
                    <% if (Number(k.is_active) === 1 && keyActionsReady) { %>
                      <form
                        method="POST"
                        action="/developer/keys/<%= Number(k.id) %>/revoke"
                        onsubmit="return confirm('Permanently revoke this API key? Applications using it will lose access when authentication is enabled.');"
                      >
                        <input
                          type="hidden"
                          name="_csrf"
                          value="<%= csrfValue %>"
                        >
                        <button class="btn-revoke" type="submit">
                          <i class="bi bi-x-circle me-1"></i>
                          Revoke
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-secondary">
                        <%= Number(k.is_active) === 1 ? 'Unavailable' : '—' %>
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty">
          <span class="empty-icon">
            <i class="bi bi-key"></i>
          </span>
          <h4>No API keys yet</h4>
          <p>
            Generate your first key to prepare your integration.
          </p>
        </div>
      <% } %>

      <div class="rule"></div>

      <% if (keyActionsReady) { %>
        <form
          action="/developer/keys/create"
          method="POST"
          class="d-flex flex-wrap align-items-center gap-2"
          id="createKeyForm"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfValue %>"
          >

          <input
            class="form-control"
            style="max-width:270px"
            type="text"
            name="key_name"
            maxlength="100"
            placeholder="e.g. My Store Backend"
            aria-label="API key name"
            required
          >

          <button
            class="btn-main"
            type="submit"
            id="createKeyButton"
            <%= activeKeyCount >= 5 ? 'disabled' : '' %>
          >
            <i class="bi bi-plus me-1"></i>
            Create API key
          </button>
        </form>

        <div class="form-hint">
          <% if (activeKeyCount >= 5) { %>
            You've reached the limit of 5 active keys.
            Revoke an existing key to create another.
          <% } else { %>
            <i class="bi bi-shield-lock me-1"></i>
            Up to 5 active keys per account.
            Keep each key on your backend, never in frontend code.
          <% } %>
        </div>
      <% } else { %>
        <button class="btn-main" disabled>
          <i class="bi bi-plus me-1"></i>
          Create API key
        </button>
        <div class="form-hint">
          Credential management is temporarily unavailable.
          Please refresh this page or contact support.
        </div>
      <% } %>
    </div>
  </section>

  <section id="documentation">
    <div class="section-title">
      <h2>Integration guide</h2>
      <span class="small-note">
        Preview documentation · Not live
      </span>
    </div>

    <div class="doc-grid">
      <div class="surface card-pad">
        <h3 class="doc-title">Authentication preview</h3>
        <p class="doc-desc">
          Once the API is released, your backend will authenticate
          using a private bearer token. Never expose credentials
          in browser JavaScript or public repositories.
        </p>

        <div class="code-top">
          <span>HTTP · planned endpoint</span>
          <span>PREVIEW</span>
        </div>

        <div class="code-body">GET /api/v1/account HTTP/1.1
Host: akcell.store
Authorization: Bearer YOUR_API_KEY
Accept: application/json</div>

        <p class="form-hint mt-3 mb-0">
          This endpoint is not active yet. The example is
          for integration planning only.
        </p>
      </div>

      <div class="surface card-pad">
        <h3 class="doc-title">Getting started</h3>

        <div class="doc-step">
          <span class="step-n">01</span>
          <div>
            <strong>Account approval</strong>
            <p>
              An AK Cell administrator enables API access
              for your account.
            </p>
          </div>
        </div>

        <div class="doc-step">
          <span class="step-n">02</span>
          <div>
            <strong>Generate credentials</strong>
            <p>
              Create and securely store your private API key.
              It cannot be recovered later.
            </p>
          </div>
        </div>

        <div class="doc-step">
          <span class="step-n">03</span>
          <div>
            <strong>Integrate your backend</strong>
            <p>
              Connect to supported local products and order
              endpoints when released.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer-inner">
    <span>
      © <%= new Date().getFullYear() %> AK Cell. Developer services.
    </span>
    <span>
      Restricted to authorized accounts ·
      <a href="/">Return to AK Cell</a>
    </span>
  </div>
</footer>

<script>
  // Prevent accidental repeated clicks while submitting.
  // The server must still enforce limits and idempotency.
  const createForm = document.getElementById('createKeyForm');

  if (createForm) {
    createForm.addEventListener('submit', function () {
      const button = document.getElementById('createKeyButton');

      if (button) {
        button.disabled = true;
        button.textContent = 'Creating...';
      }
    });
  }
</script>

</body>
</html>
