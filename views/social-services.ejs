<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <title><%= categoryName %> – Social Media Services</title>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link
    rel="stylesheet"
    href="/css/bootstrap-icons/font/bootstrap-icons.css"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <style>
    body {
      font-family:
        "Cairo",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background: linear-gradient(
        135deg,
        #f5f7fa,
        #c3cfe2
      );

      background-attachment: fixed;
      color: #212529;
    }

    .services-shell {
      max-width: 1320px;
    }

    /* =========================
       PAGE HEADER
       ========================= */

    .services-header {
      padding: 2rem 0 1.25rem;
    }

    .services-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .services-header-left {
      display: flex;
      align-items: center;
      gap: 1rem;
      min-width: 0;
    }

    .back-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.5rem 0.9rem;
      border: 1px solid #ced4da;
      border-radius: 999px;
      background: #fff;
      color: #495057;
      text-decoration: none;
      white-space: nowrap;
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        background-color 0.2s ease;
    }

    .back-button:hover {
      color: #0d6efd;
      border-color: #0d6efd;
      background: #f8fbff;
    }

    .header-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: #212529;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 1.3rem;
    }

    .services-title {
      font-size: 1.65rem;
      font-weight: 700;
      color: #111827;
      margin: 0;
      line-height: 1.35;
    }

    .services-subtitle {
      color: #6c757d;
      margin: 0.25rem 0 0;
      font-size: 0.9rem;
    }

    .services-counter {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border: 1px solid rgba(13, 110, 253, 0.25);
      background: #eaf2ff;
      color: #0d6efd;
      border-radius: 999px;
      padding: 0.5rem 0.9rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    /* =========================
       FILTER BAR
       ========================= */

    .services-filter {
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #dee2e6;
      border-radius: 16px;
      padding: 1rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    .filter-label {
      display: block;
      font-size: 0.78rem;
      color: #6c757d;
      margin-bottom: 0.35rem;
    }

    .service-search {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      border: 1px solid #ced4da;
      border-radius: 999px;
      padding: 0.55rem 1rem;
      background: #f8f9fa;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background-color 0.2s ease;
    }

    .service-search:focus-within {
      border-color: #0d6efd;
      background: #fff;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
    }

    .service-search i {
      color: #6c757d;
    }

    .service-search input {
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      box-shadow: none;
      font-size: 0.95rem;
    }

    .service-search input:focus {
      box-shadow: none;
    }

    .sort-select {
      min-width: 200px;
    }

    .visible-counter {
      color: #6c757d;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    /* =========================
       SERVICE CARDS
       ========================= */

    .service-column {
      display: flex;
    }

    .social-service-card {
      width: 100%;
      height: 100%;
      background: #fff;
      border: 1px solid #dee2e6;
      border-radius: 12px;
      overflow: hidden;
      text-align: center;
      text-decoration: none;
      color: #212529;
      display: flex;
      flex-direction: column;
      position: relative;

      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
    }

    .social-service-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.14);
      border-color: rgba(13, 110, 253, 0.4);
      color: #0d6efd;
    }

    .service-image-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 10;
      background: #f8f9fa;
      overflow: hidden;
    }

    .service-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;

      transition:
        transform 0.35s ease,
        opacity 0.3s ease;
    }

    .social-service-card:hover .service-image {
      transform: scale(1.035);
    }

    .service-id {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 3;

      padding: 0.25rem 0.55rem;
      border-radius: 999px;

      color: #fff;
      background: rgba(17, 24, 39, 0.78);
      backdrop-filter: blur(5px);

      font-size: 0.7rem;
      font-weight: 600;
    }

    .service-badges {
      position: absolute;
      left: 10px;
      bottom: 10px;
      right: 10px;
      z-index: 3;

      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .service-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;

      padding: 0.28rem 0.55rem;
      border-radius: 999px;

      font-size: 0.67rem;
      font-weight: 700;

      background: rgba(255, 255, 255, 0.94);
      color: #4338ca;

      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.13);
      backdrop-filter: blur(6px);
    }

    .service-badge.refill {
      color: #047857;
    }

    .service-badge.no-refill {
      color: #b91c1c;
    }

    .service-badge.low-quality {
      color: #b45309;
    }

    .service-card-body {
      flex: 1;
      min-height: 108px;
      padding: 1.2rem 1rem;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .service-card-title {
      margin: 0;
      color: #111827;
      font-size: 0.98rem;
      font-weight: 700;
      line-height: 1.45;

      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;

      transition: color 0.2s ease;
    }

    .social-service-card:hover .service-card-title {
      color: #0d6efd;
    }

    .service-card-hint {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-top: 0.65rem;
      color: #6c757d;
      font-size: 0.75rem;
    }

    .social-service-card:hover .service-card-hint {
      color: #0d6efd;
    }

    .service-card-hidden {
      display: none !important;
    }

    /* =========================
       EMPTY STATE
       ========================= */

    .empty-state {
      text-align: center;
      background: rgba(255, 255, 255, 0.95);
      border: 1px dashed #adb5bd;
      border-radius: 16px;
      padding: 4rem 1rem;
      color: #6c757d;
    }

    .empty-state i {
      display: block;
      font-size: 3rem;
      margin-bottom: 1rem;
      color: #adb5bd;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @media (max-width: 767.98px) {
      .services-header {
        padding-top: 1.3rem;
      }

      .services-header-row {
        align-items: flex-start;
      }

      .services-header-left {
        align-items: flex-start;
      }

      .services-title {
        font-size: 1.25rem;
      }

      .services-subtitle {
        font-size: 0.8rem;
      }

      .header-icon {
        width: 42px;
        height: 42px;
      }

      .sort-select {
        width: 100%;
        min-width: 0;
      }

      .visible-counter {
        width: 100%;
      }

      .service-card-body {
        min-height: 95px;
        padding: 1rem 0.75rem;
      }

      .service-card-title {
        font-size: 0.88rem;
      }
    }

    @media (max-width: 575.98px) {
      .back-button span {
        display: none;
      }

      .back-button {
        width: 42px;
        height: 42px;
        padding: 0;
      }

      .services-counter {
        width: 100%;
        justify-content: center;
      }

      .services-filter {
        padding: 0.85rem;
      }

      .service-id {
        top: 7px;
        right: 7px;
      }

      .service-badges {
        left: 7px;
        right: 7px;
        bottom: 7px;
      }

      .service-badge {
        padding: 0.22rem 0.42rem;
        font-size: 0.59rem;
      }

      .service-card-body {
        min-height: 88px;
        padding: 0.8rem 0.55rem;
      }

      .service-card-title {
        font-size: 0.79rem;
        line-height: 1.4;
        -webkit-line-clamp: 3;
      }

      .service-card-hint {
        display: none;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/header', { user }) %>

  <main class="py-3">
    <div class="container services-shell">

      <!-- PAGE HEADER -->
      <header class="services-header">
        <div class="services-header-row">

          <div class="services-header-left">

            <a href="/social-media" class="back-button">
              <i class="bi bi-arrow-left"></i>
              <span>Back</span>
            </a>

            <div class="header-icon">
              <i class="bi bi-broadcast-pin"></i>
            </div>

            <div>
              <h1 class="services-title">
                <%= categoryName %>
              </h1>

              <p class="services-subtitle">
                Choose a service to continue to the checkout page.
              </p>
            </div>

          </div>

          <div class="services-counter">
            <i class="bi bi-lightning-charge-fill"></i>

            <span>
              <strong><%= Array.isArray(services) ? services.length : 0 %></strong>
              service(s)
            </span>
          </div>

        </div>
      </header>

      <!-- FILTER BAR -->
      <section class="services-filter">
        <div class="row g-3 align-items-end">

          <div class="col-md">
            <label class="filter-label" for="serviceSearch">
              Search in this category
            </label>

            <div class="service-search">
              <i class="bi bi-search"></i>

              <input
                type="search"
                id="serviceSearch"
                placeholder="Search by service name or badge..."
                autocomplete="off"
              />
            </div>
          </div>

          <div class="col-md-auto">
            <label class="filter-label" for="sortSelect">
              Sort
            </label>

            <select
              id="sortSelect"
              class="form-select sort-select"
            >
              <option value="default">
                Recommended
              </option>

              <option value="name-asc">
                Name: A to Z
              </option>

              <option value="name-desc">
                Name: Z to A
              </option>
            </select>
          </div>

          <div class="col-md-auto">
            <div class="visible-counter pb-md-2">
              Showing
              <strong id="visibleServicesCount">
                <%= Array.isArray(services) ? services.length : 0 %>
              </strong>
              services.
            </div>
          </div>

        </div>
      </section>

      <%
        const serviceList = Array.isArray(services)
          ? services
          : [];
      %>

      <% if (!serviceList.length) { %>

        <section class="empty-state">
          <i class="bi bi-collection"></i>

          <h4>No services available</h4>

          <p class="mb-0">
            Try another category from the
            <a href="/social-media">
              social media services page
            </a>.
          </p>
        </section>

      <% } else { %>

        <div
          id="servicesGrid"
          class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4"
        >

          <% serviceList.forEach(function(service) {
            const serviceName =
              String(service.name || 'Social Media Service').trim();

            const serviceNameLower =
              serviceName.toLowerCase();

            const serviceImage =
              service.image && String(service.image).trim()
                ? String(service.image).trim()
                : '/images/default-category.png';

            /*
             * دعم أسماء الأعمدة الموجودة عندك:
             * بعض أجزاء السيرفر تستعمل badge_best_price
             * والصفحة القديمة كانت تستعمل best_price.
             */
            const showBest =
              Number(
                service.badge_best_price ??
                service.best_price ??
                0
              ) === 1;

            const showFast =
              Number(
                service.badge_fast_start ??
                service.fast_start ??
                0
              ) === 1;

            const showRefill =
              Number(
                service.badge_refill ??
                service.refill ??
                0
              ) === 1;

            const showNoRefill =
              Number(
                service.badge_no_refill ??
                service.no_refill ??
                0
              ) === 1;

            const showLowQuality =
              Number(
                service.badge_low_quality ??
                service.low_quality ??
                0
              ) === 1;

            const searchBadges = [
              showBest ? 'best price' : '',
              showFast ? 'fast start' : '',
              showRefill ? 'refill' : '',
              showNoRefill ? 'no refill' : '',
              showLowQuality ? 'low quality' : ''
            ]
              .filter(Boolean)
              .join(' ')
              .toLowerCase();

            const searchValue =
              `${serviceNameLower} ${searchBadges}`.trim();
          %>

            <div
              class="col service-column"
              data-service-card
              data-original-index="<%= serviceList.indexOf(service) %>"
              data-name="<%= serviceNameLower %>"
              data-search="<%= searchValue %>"
            >

              <a
                href="/social-checkout/<%= service.id %>"
                class="social-service-card"
                aria-label="Open <%= serviceName %>"
              >

                <div class="service-image-wrapper">

                  <img
                    src="<%= serviceImage %>"
                    class="service-image"
                    alt="<%= serviceName %>"
                    loading="lazy"
                    onerror="this.onerror=null;this.src='/images/default-category.png';"
                  />

                  <span class="service-id">
                    #<%= service.id %>
                  </span>

                  <% if (
                    showBest ||
                    showFast ||
                    showRefill ||
                    showNoRefill ||
                    showLowQuality
                  ) { %>

                    <div class="service-badges">

                      <% if (showBest) { %>
                        <span class="service-badge">
                          <i class="bi bi-graph-up-arrow"></i>
                          Best price
                        </span>
                      <% } %>

                      <% if (showFast) { %>
                        <span class="service-badge">
                          <i class="bi bi-lightning-charge"></i>
                          Fast start
                        </span>
                      <% } %>

                      <% if (showRefill) { %>
                        <span class="service-badge refill">
                          <i class="bi bi-shield-check"></i>
                          Refill
                        </span>
                      <% } %>

                      <% if (showNoRefill) { %>
                        <span class="service-badge no-refill">
                          <i class="bi bi-slash-circle"></i>
                          No refill
                        </span>
                      <% } %>

                      <% if (showLowQuality) { %>
                        <span class="service-badge low-quality">
                          <i class="bi bi-exclamation-triangle"></i>
                          Low quality
                        </span>
                      <% } %>

                    </div>

                  <% } %>

                </div>

                <div class="service-card-body">

                  <h2 class="service-card-title">
                    <%= serviceName %>
                  </h2>

                  <span class="service-card-hint">
                    Continue to checkout
                    <i class="bi bi-arrow-right"></i>
                  </span>

                </div>

              </a>

            </div>

          <% }); %>

        </div>

        <!-- يظهر فقط عندما البحث لا يجد نتائج -->
        <section
          id="noSearchResults"
          class="empty-state mt-4 d-none"
        >
          <i class="bi bi-search"></i>

          <h5>No matching services found</h5>

          <p class="mb-0">
            Try using another search term.
          </p>
        </section>

      <% } %>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput =
        document.getElementById('serviceSearch');

      const sortSelect =
        document.getElementById('sortSelect');

      const servicesGrid =
        document.getElementById('servicesGrid');

      const visibleCount =
        document.getElementById('visibleServicesCount');

      const noResults =
        document.getElementById('noSearchResults');

      if (!servicesGrid) return;

      const cards = Array.from(
        servicesGrid.querySelectorAll('[data-service-card]')
      );

      function updateVisibleCount() {
        const count = cards.filter(function (card) {
          return !card.classList.contains('service-card-hidden');
        }).length;

        if (visibleCount) {
          visibleCount.textContent = String(count);
        }

        if (noResults) {
          noResults.classList.toggle('d-none', count !== 0);
        }
      }

      function applySearch() {
        const term = searchInput
          ? searchInput.value.toLowerCase().trim()
          : '';

        cards.forEach(function (card) {
          const searchable =
            card.dataset.search || '';

          const shouldShow =
            !term || searchable.includes(term);

          card.classList.toggle(
            'service-card-hidden',
            !shouldShow
          );
        });

        updateVisibleCount();
      }

      function applySort() {
        if (!sortSelect) return;

        const mode = sortSelect.value;

        const sortedCards = [...cards].sort(function (a, b) {
          const nameA = a.dataset.name || '';
          const nameB = b.dataset.name || '';

          const indexA =
            Number(a.dataset.originalIndex || 0);

          const indexB =
            Number(b.dataset.originalIndex || 0);

          if (mode === 'name-asc') {
            return nameA.localeCompare(nameB);
          }

          if (mode === 'name-desc') {
            return nameB.localeCompare(nameA);
          }

          return indexA - indexB;
        });

        sortedCards.forEach(function (card) {
          servicesGrid.appendChild(card);
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', applySearch);
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', applySort);
      }

      updateVisibleCount();
    });
  </script>

</body>
</html>