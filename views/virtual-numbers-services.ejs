<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Numbers - AK Cell</title>

    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/custom.css">
    <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
</head>

<body>

<%- include('partials/header') %>

<div class="hero-section">
    <h1 class="display-4">Virtual Numbers</h1>
    <p class="lead col-lg-8 mx-auto">
        Choose the service you want to activate and receive the SMS code directly in My Orders.
    </p>
</div>

<div class="container my-5">
    <div class="search-bar-container">
        <form id="searchForm">
            <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Search for WhatsApp, Telegram, Google..."
            >
            <button type="submit" class="search-btn">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>
</div>

<div class="container my-5 py-5">

    <h2 class="text-center section-title">
        Select a Service
    </h2>

    <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

        <% if (!services || !services.length) { %>
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    No virtual number services are currently available.
                </div>
            </div>
        <% } else { %>

            <% services.forEach(function(service) { %>
                <div class="col">
                    <a
                        href="/virtual-numbers/<%= service.product_code %>"
                        class="category-card service-card"
                    >
                        <img
                            src="<%= service.image || '/images/default-product.png' %>"
                            class="card-img"
                            alt="<%= service.name %>"
                            loading="lazy"
                            onerror="this.src='/images/default-product.png'"
                        >

                        <div class="card-body">
                            <div><%= service.name %></div>

                            <div class="small text-muted mt-1">
                                <%= Number(service.countries_count || 0) %>
                                available countries
                            </div>

                            <div class="small text-primary fw-bold mt-1">
                                From $<%= Number(service.starting_price || 0).toFixed(2) %>
                            </div>
                        </div>
                    </a>
                </div>
            <% }); %>

        <% } %>

    </div>

</div>

<%- include('partials/footer') %>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const input = document.getElementById("searchInput");
    const form = document.getElementById("searchForm");

    if (form) {
        form.addEventListener("submit", event => event.preventDefault());
    }

    if (input) {
        input.addEventListener("input", function(){

            const value = this.value.toLowerCase().trim();

            document.querySelectorAll(".category-card").forEach(card => {

                const wrapper = card.closest(".col");
                const title = card.innerText.toLowerCase();

                wrapper.style.display =
                    title.includes(value) ? "" : "none";
            });

        });
    }

});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/main.js"></script>

</body>
</html>
