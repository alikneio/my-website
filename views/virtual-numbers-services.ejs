<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Numbers - AK Cell</title>

    <link rel="stylesheet" href="/css/bootstrap.css">
    <link rel="stylesheet" href="/css/custom.css">
    <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">

    <style>
        .vn-card-image {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            background:
                linear-gradient(135deg, rgba(5, 10, 22, .96), rgba(30, 38, 55, .94)),
                url('/images/new banner.png') center/cover no-repeat;
        }

        .vn-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .vn-card-fallback {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            color: #fff;
            padding: 24px;
            text-align: center;
        }

        .vn-card-fallback i {
            font-size: 4rem;
            color: #0d6efd;
        }

        .vn-card-fallback strong {
            font-size: 1.35rem;
        }

        .vn-meta {
            font-size: .84rem;
            font-weight: 400;
            color: #6c757d;
            margin-top: 5px;
        }

        .vn-price {
            color: #0d6efd;
            font-weight: 700;
            margin-top: 4px;
        }

        .category-card .card-body {
            min-height: 108px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @media (max-width: 576px) {
            .vn-card-fallback i {
                font-size: 3rem;
            }

            .vn-card-fallback strong {
                font-size: 1.05rem;
            }

            .category-card .card-body {
                padding: 1rem .65rem;
                min-height: 100px;
            }
        }
    </style>
</head>

<body>

<%- include('partials/header') %>

<div class="hero-section">
    <h1 class="display-4">Virtual Numbers</h1>
    <p class="lead col-lg-8 mx-auto">
        Choose the service you want to activate.
    </p>
</div>

<div class="container my-5">
    <div class="search-bar-container">
        <form id="searchForm">
            <input
                type="search"
                id="searchInput"
                class="search-input"
                placeholder="Search for WhatsApp, Telegram, Google..."
            >
            <button type="submit" class="search-btn">
                <i class="bi bi-search"></i>
            </button>
        </form>
    </div>
</div>

<div class="container my-5 py-5">
    <h2 class="text-center section-title">Select a Service</h2>

    <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

        <% if (!services || !services.length) { %>
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    No virtual number services are currently available.
                </div>
            </div>
        <% } else { %>

            <% services.forEach(function(service) { %>
                <div class="col">
                    <a
                        href="/virtual-numbers/<%= service.product_code %>"
                        class="category-card service-card h-100"
                    >
                        <div class="vn-card-image">
<% const serviceImage = service.card_image || null; %>

<% if (serviceImage) { %>
    <img
        src="<%= serviceImage %>"
        alt="<%= service.name %>"
        loading="lazy"
        onerror="
            this.style.display='none';
            this.nextElementSibling.style.display='flex';
        "
    >
<% } %>

<div
    class="vn-card-fallback"
    style="<%= serviceImage ? 'display:none;' : 'display:flex;' %>"
>
                                <i class="bi bi-chat-square-dots-fill"></i>
                                <strong><%= service.name %></strong>
                            </div>
                        </div>

                        <div class="card-body text-center">
                            <div><%= service.name %></div>

                            <div class="vn-meta">
                                <%= Number(service.countries_count || 0) %>
                                available countr<%= Number(service.countries_count || 0) === 1 ? 'y' : 'ies' %>
                            </div>

                            <div class="vn-price">
                                From $<%= Number(service.starting_price || 0).toFixed(2) %>
                            </div>
                        </div>
                    </a>
                </div>
            <% }); %>

        <% } %>

    </div>
</div>

<%- include('partials/footer') %>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("searchInput");
    const form = document.getElementById("searchForm");

    if (form) {
        form.addEventListener("submit", event => event.preventDefault());
    }

    if (input) {
        input.addEventListener("input", function () {
            const value = this.value.toLowerCase().trim();

            document.querySelectorAll(".category-card").forEach(card => {
                const wrapper = card.closest(".col");
                const title = card.innerText.toLowerCase();
                wrapper.style.display = title.includes(value) ? "" : "none";
            });
        });
    }
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/main.js"></script>

</body>
</html>
