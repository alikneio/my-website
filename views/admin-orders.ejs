
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="same-origin">
  <title>Manage Orders | AK Cell</title>

  <link rel="stylesheet" href="/css/bootstrap.css">
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css">

  <style>
    :root {
      --ak-bg: #f5f7fb;
      --ak-dark: #111c32;
      --ak-muted: #64748b;
      --ak-border: #e5eaf2;
      --ak-blue: #2563eb;
    }

    body {
      background: var(--ak-bg);
      color: var(--ak-dark);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    .orders-main {
      min-width: 0;
      flex: 1;
      padding: 30px;
    }

    .orders-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 25px;
    }

    .orders-heading h1 {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -.5px;
      margin: 0;
    }

    .muted {
      color: var(--ak-muted);
      font-size: .85rem;
    }

    .ak-card {
      background: #fff;
      border: 1px solid var(--ak-border);
      border-radius: 17px;
      box-shadow: 0 6px 22px rgba(15,23,42,.035);
    }

    .stat-card {
      padding: 19px;
      height: 100%;
    }

    .stat-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 1.25rem;
      background: #eff6ff;
      color: #2563eb;
      flex-shrink: 0;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .filter-card {
      padding: 20px;
    }

    .form-control, .form-select {
      border-color: #dce3ee;
      border-radius: 10px;
    }

    .btn {
      border-radius: 10px;
    }

    .table-responsive {
      border-radius: 0 0 17px 17px;
    }

    .orders-table {
      min-width: 1320px;
      margin-bottom: 0;
    }

    .orders-table thead th {
      background: #f8fafc;
      color: #475569;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .45px;
      padding: 15px;
      border-bottom: 1px solid var(--ak-border);
      white-space: nowrap;
    }

    .orders-table tbody td {
      padding: 15px;
      border-color: #edf1f6;
      vertical-align: top;
      font-size: .85rem;
    }

    .order-id {
      font-weight: 800;
      color: #2563eb;
    }

    .source-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: 7px;
      font-size: .7rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .source-api {
      background: #ede9fe;
      color: #6d28d9;
    }

    .source-web {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .status-badge {
      display: inline-block;
      border-radius: 7px;
      padding: 5px 9px;
      font-size: .7rem;
      font-weight: 800;
    }

    .s-waiting { background: #fff7ed; color: #b45309; }
    .s-progress { background: #eff6ff; color: #1d4ed8; }
    .s-accepted { background: #ecfdf5; color: #047857; }
    .s-rejected { background: #fef2f2; color: #b91c1c; }
    .s-partial { background: #f5f3ff; color: #7c3aed; }

    .detail-item {
      padding: 7px 9px;
      border: 1px solid #edf1f6;
      background: #f8fafc;
      border-radius: 8px;
      margin-bottom: 5px;
      font-size: .76rem;
      overflow-wrap: anywhere;
    }

    .detail-item strong {
      display: block;
      color: #64748b;
      font-size: .67rem;
      margin-bottom: 2px;
    }

    .detail-sensitive {
      color: #b45309;
      font-style: italic;
    }

    .quick-replies {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 7px;
    }

    .quick-reply {
      font-size: .68rem;
      border: 1px solid #e2e8f0;
      border-radius: 7px;
      background: #f8fafc;
      padding: 4px 7px;
      color: #475569;
    }

    .quick-reply:hover {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .pagination .page-link {
      border-radius: 9px !important;
      margin: 0 3px;
      color: #334155;
      border-color: #e2e8f0;
    }

    .pagination .active .page-link {
      background: #2563eb;
      border-color: #2563eb;
      color: white;
    }

    .mono {
      font-family: Consolas, ui-monospace, monospace;
      font-variant-numeric: tabular-nums;
    }

    @media(max-width: 768px) {
      .orders-main { padding: 16px; }
      .orders-heading h1 { font-size: 1.4rem; }
      .filter-card { padding: 15px; }
    }
  </style>
</head>

<body>
<div class="d-flex">

  <%- include('partials/admin-sidebar') %>

  <main class="orders-main">

    <%
      const list = Array.isArray(orders) ? orders : [];
      const stats = summary || {};
      const pg = pagination || {};
      const f = filters || {};

      function statusClass(value) {
        return {
          'Waiting': 's-waiting',
          'In progress': 's-progress',
          'Accepted': 's-accepted',
          'Rejected': 's-rejected',
          'Partial': 's-partial'
        }[value] || 's-waiting';
      }

      function splitDetails(value) {
        return String(value || '')
          .split('|')
          .map(x => x.trim())
          .filter(Boolean)
          .map(x => {
            const i = x.indexOf(':');
            return i < 0
              ? { label: 'Detail', value: x }
              : {
                  label: x.slice(0, i).trim(),
                  value: x.slice(i + 1).trim()
                };
          });
      }

      function pageUrl(number) {
        const p = new URLSearchParams();
        if (f.search) p.set('q', f.search);
        if (f.status) p.set('status', f.status);
        if (f.source) p.set('source', f.source);
        if (f.sort) p.set('sort', f.sort);
        p.set('page', String(number));
        return '/admin/orders?' + p.toString();
      }

      const pageNumber = Number(pg.page || 1);
      const pageCount = Number(pg.totalPages || 1);
      const startPage = Math.max(1, pageNumber - 2);
      const endPage = Math.min(pageCount, pageNumber + 2);
    %>

    <div class="orders-heading">
      <div>
        <h1>
          <i class="bi bi-bag-check me-2 text-primary"></i>
          Manage Orders
        </h1>
        <div class="muted mt-1">
          Manage customer orders and reseller API purchases.
        </div>
      </div>

      <div class="d-flex gap-2">
        <a href="/admin" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
        <a href="<%= pageUrl(pageNumber) %>" class="btn btn-primary">
          <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </a>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <%
        const cards = [
          { label:'Total Orders', value:stats.total, icon:'bi-bag', color:'#2563eb' },
          { label:'Waiting', value:stats.waiting, icon:'bi-hourglass-split', color:'#d97706' },
          { label:'Accepted', value:stats.accepted, icon:'bi-check-circle', color:'#059669' },
          { label:'Rejected', value:stats.rejected, icon:'bi-x-circle', color:'#dc2626' },
          { label:'API Orders', value:stats.apiOrders, icon:'bi-code-slash', color:'#7c3aed' }
        ];
      %>

      <% cards.forEach(card => { %>
        <div class="col-6 col-lg">
          <div class="ak-card stat-card">
            <div class="d-flex align-items-center gap-3">
              <div class="stat-icon"
                   style="color:<%= card.color %>">
                <i class="bi <%= card.icon %>"></i>
              </div>
              <div>
                <div class="muted"><%= card.label %></div>
                <div class="stat-value mono">
                  <%= Number(card.value || 0).toLocaleString('en-US') %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="ak-card filter-card mb-3">
      <form method="GET" action="/admin/orders" id="filterForm">
        <div class="row g-3 align-items-end">

          <div class="col-12 col-lg-4">
            <label class="form-label fw-semibold small">
              Search Orders
            </label>
            <div class="input-group">
              <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="search"
                name="q"
                class="form-control"
                maxlength="100"
                placeholder="Order ID, username, product..."
                value="<%= f.search || '' %>"
              >
            </div>
          </div>

          <div class="col-6 col-lg-2">
            <label class="form-label fw-semibold small">Status</label>
            <select name="status" class="form-select">
              <option value="">All Statuses</option>
              <% ['Waiting','In progress','Accepted','Partial','Rejected'].forEach(s => { %>
                <option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>>
                  <%= s %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="col-6 col-lg-2">
            <label class="form-label fw-semibold small">Order Source</label>
            <select name="source" class="form-select">
              <option value="">All Sources</option>
              <option value="website" <%= f.source === 'website' ? 'selected' : '' %>>
                Website / Other
              </option>
              <option value="reseller_api" <%= f.source === 'reseller_api' ? 'selected' : '' %>>
                Reseller API
              </option>
            </select>
          </div>

          <div class="col-6 col-lg-2">
            <label class="form-label fw-semibold small">Sort</label>
            <select name="sort" class="form-select">
              <option value="newest" <%= f.sort === 'newest' ? 'selected' : '' %>>Newest</option>
              <option value="oldest" <%= f.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
              <option value="priceHigh" <%= f.sort === 'priceHigh' ? 'selected' : '' %>>Highest Price</option>
              <option value="priceLow" <%= f.sort === 'priceLow' ? 'selected' : '' %>>Lowest Price</option>
            </select>
          </div>

          <div class="col-6 col-lg-2 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">
              <i class="bi bi-funnel me-1"></i> Apply
            </button>
            <a href="/admin/orders" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
          </div>
        </div>
      </form>
    </div>

    <div class="ak-card overflow-hidden">

      <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <strong>Orders List</strong>
          <div class="muted">
            Showing <%= pg.from || 0 %>–<%= pg.to || 0 %>
            of <%= Number(pg.total || 0).toLocaleString('en-US') %>
            matching orders
          </div>
        </div>

        <button type="button" class="btn btn-outline-dark btn-sm" id="exportCsv">
          <i class="bi bi-filetype-csv me-1"></i>
          Export Current Page
        </button>
      </div>

      <div class="table-responsive">
        <table class="table table-hover orders-table" id="ordersTable">
          <thead>
            <tr>
              <th>Order</th>
              <th>Source</th>
              <th>Customer</th>
              <th>Product</th>
              <th>Details</th>
              <th>Date</th>
              <th>Status</th>
              <th>Admin Reply</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% if (!list.length) { %>
              <tr>
                <td colspan="9" class="text-center py-5">
                  <i class="bi bi-inbox fs-1 text-secondary"></i>
                  <div class="fw-bold mt-2">No orders found</div>
                  <div class="muted">Try adjusting your filters.</div>
                </td>
              </tr>
            <% } %>

            <% list.forEach(order => { %>
              <%
                const isApi = order.order_channel === 'reseller_api';
                const reply = String(order.admin_reply || '');
                const details = splitDetails(order.order_details);
                const date = order.purchaseDate
                  ? new Date(order.purchaseDate).toLocaleString('en-US')
                  : '-';
              %>

              <tr>
                <td>
                  <span class="order-id mono">#<%= order.id %></span>
                </td>

                <td>
                  <% if (isApi) { %>
                    <span class="source-badge source-api">
                      <i class="bi bi-code-slash"></i>
                      RESELLER API
                    </span>
                  <% } else { %>
                    <span class="source-badge source-web">
                      <i class="bi bi-bag"></i>
                      WEBSITE / OTHER
                    </span>
                  <% } %>
                </td>

                <td>
                  <div class="fw-bold"><%= order.username || '-' %></div>
                  <div class="muted mono">
                    User #<%= order.userId %>
                  </div>
                </td>

                <td style="min-width:180px;max-width:240px">
                  <div class="fw-bold"><%= order.productName || '-' %></div>
                  <div class="fw-semibold text-success mono mt-1">
                    $<%= Number(order.price || 0).toFixed(2) %>
                  </div>
                </td>

                <td style="min-width:230px;max-width:340px">
                  <% if (details.length) { %>
                    <% details.forEach(d => { %>
                      <div class="detail-item">
                        <strong><%= d.label %></strong>
                        <% if (/password|secret|token/i.test(d.label)) { %>
                          <span class="detail-sensitive">
                            Sensitive value hidden
                          </span>
                        <% } else { %>
                          <span class="mono"><%= d.value %></span>
                        <% } %>
                      </div>
                    <% }) %>

                    <button
                      type="button"
                      class="btn btn-outline-secondary btn-sm copy-details"
                      data-order-id="<%= order.id %>"
                    >
                      <i class="bi bi-copy me-1"></i> Copy Details
                    </button>
                  <% } else { %>
                    <span class="muted">No details</span>
                  <% } %>
                </td>

                <td class="mono text-secondary" style="min-width:155px">
                  <%= date %>
                </td>

                <td style="min-width:160px">
                  <div class="mb-2">
                    <span class="status-badge <%= statusClass(order.status) %>">
                      <%= order.status || 'Waiting' %>
                    </span>
                  </div>

                  <form
                    method="POST"
                    action="/admin/order/update/<%= order.id %>"
                    class="order-update-form"
                    id="order-form-<%= order.id %>"
                  >
                    <input type="hidden" name="return_to" value="<%= pageUrl(pageNumber) %>">

                    <select name="status" class="form-select form-select-sm">
                      <% ['Waiting','Accepted','Rejected'].forEach(s => { %>
                        <option value="<%= s %>"
                          <%= order.status === s ? 'selected' : '' %>>
                          <%= s %>
                        </option>
                      <% }) %>
                    </select>
                  </form>
                </td>

                <td style="min-width:250px">
                  <div class="input-group input-group-sm">
                    <input
                      type="text"
                      name="admin_reply"
                      class="form-control admin-reply-input"
                      form="order-form-<%= order.id %>"
                      value="<%= reply %>"
                      placeholder="Delivery link or reply..."
                    >

                    <button type="button"
                            class="btn btn-outline-secondary copy-reply"
                            title="Copy reply">
                      <i class="bi bi-copy"></i>
                    </button>
                  </div>

                  <div class="quick-replies">
                    <button type="button" class="quick-reply"
                            data-reply="Delivered successfully.">
                      Delivered
                    </button>
                    <button type="button" class="quick-reply"
                            data-reply="Please check your order details.">
                      Check details
                    </button>
                    <button type="button" class="quick-reply"
                            data-reply="Rejected: incorrect or incomplete details.">
                      Invalid details
                    </button>
                    <button type="button" class="quick-reply"
                            data-reply="Currently out of stock. We will update you shortly.">
                      Out of stock
                    </button>
                  </div>

                  <% if (/^https?:\/\//i.test(reply)) { %>
                    <a href="<%= reply %>" target="_blank"
                       rel="noopener noreferrer"
                       class="small d-inline-block mt-2">
                      <i class="bi bi-box-arrow-up-right"></i>
                      Open delivery link
                    </a>
                  <% } %>
                </td>

                <td>
                  <button
                    type="submit"
                    form="order-form-<%= order.id %>"
                    class="btn btn-primary btn-sm update-btn"
                  >
                    <i class="bi bi-save me-1"></i> Update
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="muted">
          Page <strong><%= pageNumber %></strong>
          of <strong><%= pageCount %></strong>
        </div>

        <% if (pageCount > 1) { %>
          <nav aria-label="Orders pagination">
            <ul class="pagination pagination-sm mb-0 flex-wrap">

              <li class="page-item <%= pageNumber <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="<%= pageUrl(Math.max(1,pageNumber-1)) %>">
                  Previous
                </a>
              </li>

              <% if (startPage > 1) { %>
                <li class="page-item">
                  <a class="page-link" href="<%= pageUrl(1) %>">1</a>
                </li>
                <% if (startPage > 2) { %>
                  <li class="page-item disabled">
                    <span class="page-link">...</span>
                  </li>
                <% } %>
              <% } %>

              <% for (let p = startPage; p <= endPage; p++) { %>
                <li class="page-item <%= p === pageNumber ? 'active' : '' %>">
                  <a class="page-link" href="<%= pageUrl(p) %>">
                    <%= p %>
                  </a>
                </li>
              <% } %>

              <% if (endPage < pageCount) { %>
                <% if (endPage < pageCount - 1) { %>
                  <li class="page-item disabled">
                    <span class="page-link">...</span>
                  </li>
                <% } %>
                <li class="page-item">
                  <a class="page-link" href="<%= pageUrl(pageCount) %>">
                    <%= pageCount %>
                  </a>
                </li>
              <% } %>

              <li class="page-item <%= pageNumber >= pageCount ? 'disabled' : '' %>">
                <a class="page-link"
                   href="<%= pageUrl(Math.min(pageCount,pageNumber+1)) %>">
                  Next
                </a>
              </li>
            </ul>
          </nav>
        <% } %>
      </div>
    </div>

  </main>
</div>

<script>
  const table = document.getElementById('ordersTable');

  function getRows() {
    return Array.from(table.querySelectorAll('tbody tr'))
      .filter(row => row.querySelector('.order-update-form'));
  }

  function safeDetails(row) {
    return Array.from(row.querySelectorAll('.detail-item'))
      .filter(item =>
        !item.querySelector('.detail-sensitive')
      )
      .map(item => item.innerText.trim())
      .join('\n');
  }

  async function copyText(text, button) {
    try {
      await navigator.clipboard.writeText(text);
      const original = button.innerHTML;
      button.innerHTML = '<i class="bi bi-check2"></i> Copied';
      setTimeout(() => {
        button.innerHTML = original;
      }, 1200);
    } catch (error) {
      alert('Copy failed. Please copy manually.');
    }
  }

  document.addEventListener('click', async event => {
    const quick = event.target.closest('.quick-reply');

    if (quick) {
      const row = quick.closest('tr');
      const input = row?.querySelector('.admin-reply-input');

      if (input) {
        input.value = quick.dataset.reply || '';
        input.focus();
      }
      return;
    }

    const copyReply = event.target.closest('.copy-reply');

    if (copyReply) {
      const input = copyReply.closest('tr')
        ?.querySelector('.admin-reply-input');

      await copyText(input?.value || '', copyReply);
      return;
    }

    const copyDetails = event.target.closest('.copy-details');

    if (copyDetails) {
      await copyText(
        safeDetails(copyDetails.closest('tr')),
        copyDetails
      );
    }
  });

  document.querySelectorAll('.order-update-form').forEach(form => {
    form.addEventListener('submit', function(event) {
      const row = form.closest('tr');
      const selected = form.querySelector('[name="status"]')?.value;
      const current = row.querySelector('.status-badge')?.textContent.trim();

      if (selected === 'Rejected' && current !== 'Rejected') {
        if (!confirm('Reject this order? This may refund the customer balance.')) {
          event.preventDefault();
          return;
        }
      }

      const button = document.querySelector(
        `[form="${form.id}"].update-btn`
      );

      if (button) {
        button.disabled = true;
        button.innerHTML =
          '<span class="spinner-border spinner-border-sm me-1"></span> Saving';
      }
    });
  });

  document.getElementById('exportCsv')
    ?.addEventListener('click', () => {
      const data = [[
        'Order ID',
        'Source',
        'Customer',
        'Product',
        'Price',
        'Date',
        'Status',
        'Admin Reply'
      ]];

      getRows().forEach(row => {
        const cells = row.querySelectorAll('td');
        const price = cells[3]?.querySelector('.text-success')?.textContent.trim() || '';

        data.push([
          cells[0]?.innerText.trim() || '',
          cells[1]?.innerText.trim() || '',
          cells[2]?.innerText.trim().replace(/\s+/g,' ') || '',
          cells[3]?.querySelector('.fw-bold')?.textContent.trim() || '',
          price,
          cells[5]?.innerText.trim() || '',
          cells[6]?.querySelector('.status-badge')?.textContent.trim() || '',
          row.querySelector('.admin-reply-input')?.value || ''
        ]);
      });

      const csv = data.map(line =>
        line.map(value => {
          let text = String(value ?? '');

          // Prevent spreadsheet formula execution.
          if (/^[\s]*[=+\-@]/.test(text)) {
            text = "'" + text;
          }

          return '"' + text.replace(/"/g, '""') + '"';
        }).join(',')
      ).join('\r\n');

      const blob = new Blob(
        ['\uFEFF' + csv],
        { type: 'text/csv;charset=utf-8' }
      );

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');

      a.href = url;
      a.download = 'akcell-orders-page-' +
        new Date().toISOString().slice(0,10) + '.csv';

      document.body.appendChild(a);
      a.click();
      a.remove();

      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
</script>
</body>
</html>
