<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Social Media Services</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css" />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <style>
    body {
      font-family: "Cairo", sans-serif;
    }

    .social-hero {
      background-color: #e9ecef;
      padding: 4rem 1rem;
      text-align: center;
    }

    .social-hero h1 {
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .social-hero p {
      max-width: 760px;
      margin: 0 auto;
      color: #6c757d;
    }

    .social-category-card {
      height: 100%;
    }

    .social-category-card .card-img {
      display: block;
      width: 100%;
      height: 280px;
      object-fit: cover;
      background-color: #f8f9fa;
    }

    .social-category-card .card-body {
      min-height: 88px;
      padding: 1.3rem 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      line-height: 1.4;
    }

    .social-category-wrapper {
      display: flex;
    }

    .empty-state {
      text-align: center;
      padding: 5rem 1rem;
      color: #6c757d;
    }

    .empty-state i {
      display: block;
      font-size: 3rem;
      margin-bottom: 1rem;
      color: #9ca3af;
    }

    @media (max-width: 991.98px) {
      .social-category-card .card-img {
        height: 230px;
      }
    }

    @media (max-width: 767.98px) {
      .social-hero {
        padding: 3rem 1rem;
      }

      .social-hero h1 {
        font-size: 2rem;
      }

      .social-category-card .card-img {
        height: 190px;
      }

      .social-category-card .card-body {
        min-height: 76px;
        padding: 1rem 0.7rem;
        font-size: 0.9rem;
      }
    }

    @media (max-width: 575.98px) {
      .social-category-card .card-img {
        height: 150px;
      }

      .social-category-card .card-body {
        min-height: 74px;
        font-size: 0.82rem;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/header') %>

  <section class="social-hero">
    <h1 class="display-4">Social Media Services</h1>

    <p class="lead">
      Choose a category and browse all available social media services.
    </p>
  </section>

  <%
    const cats = Array.isArray(categories)
      ? categories
      : (Array.isArray(smmCategories) ? smmCategories : []);
  %>

  <main class="container my-5 py-5">
    <h2 class="text-center section-title">
      Select a Service
    </h2>

    <% if (!cats.length) { %>

      <section class="empty-state">
        <i class="bi bi-collection-play"></i>

        <h4>No categories available yet</h4>

        <p class="mb-0">
          Social media categories will appear here once they are enabled.
        </p>
      </section>

    <% } else { %>

      <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

        <% cats.forEach(function(cat) {
          const title =
            cat.name ||
            cat.label ||
            cat.title ||
            'Social Media Category';

          const slug =
            cat.slug ||
            cat.handle ||
            cat.id;

          const image =
            cat.image && String(cat.image).trim()
              ? String(cat.image).trim()
              : '/images/default-category.png';
        %>

          <div class="col social-category-wrapper">

            <a
              href="/social-media/<%= encodeURIComponent(slug) %>"
              class="category-card service-card social-category-card w-100"
              aria-label="View <%= title %> services"
            >

              <img
                src="<%= image %>"
                class="card-img"
                alt="<%= title %>"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/default-category.png';"
              />

              <div class="card-body">
                <%= title %>
              </div>

            </a>

          </div>

        <% }); %>

      </div>

    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>