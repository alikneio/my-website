
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>API Key Created | AK Cell</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    body {
      background: #f3f5f8;
      color: #17212e;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    .topbar {
      background: #151c25;
      border-bottom: 3px solid #c99b48;
      color: #fff;
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: #168dc2;
      border-radius: 10px;
    }

    .secret-box {
      background: #f7f9fb;
      border: 1px solid #d9e0e8;
      border-radius: 12px;
      padding: 18px;
      overflow-wrap: anywhere;
      font-family: Consolas, monospace;
      font-size: 14px;
      user-select: all;
    }

    .main-card {
      max-width: 720px;
      margin: 55px auto;
      border: 1px solid #e1e6ed;
      border-radius: 16px;
    }

    .btn-primary {
      background: #168dc2;
      border-color: #168dc2;
    }
  </style>
</head>

<body>
  <header class="topbar py-3">
    <div class="container d-flex align-items-center gap-3">
      <span class="brand-mark">
        <i class="bi bi-code-slash fs-5"></i>
      </span>
      <div>
        <strong>AK CELL</strong>
        <div class="small text-white-50">Developer Platform</div>
      </div>
    </div>
  </header>

  <main class="container">
    <div class="card main-card shadow-sm">
      <div class="card-body p-4 p-md-5">

        <div class="mb-3 text-success">
          <i class="bi bi-check-circle-fill fs-1"></i>
        </div>

        <h2 class="fw-bold">API key created successfully</h2>

        <p class="text-secondary">
          Your new credential
          <strong><%= keyName %></strong>
          has been generated.
        </p>

        <div class="alert alert-warning">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Copy this key now.</strong>
          It will not be displayed again after leaving this page.
        </div>

        <label class="form-label fw-semibold">
          Your secret API key
        </label>

        <div class="secret-box mb-3" id="apiKey">
          <%= rawKey %>
        </div>

        <button
          type="button"
          class="btn btn-primary px-4"
          id="copyKeyButton"
        >
          <i class="bi bi-copy me-2"></i>
          Copy API Key
        </button>

        <hr class="my-4">

        <p class="small text-secondary">
          Store this credential securely on your server.
          Never expose it in browser JavaScript, public repositories,
          or frontend application code.
        </p>

        <a href="/developer" class="btn btn-outline-dark">
          <i class="bi bi-arrow-left me-2"></i>
          Return to Developer Center
        </a>

      </div>
    </div>
  </main>

  <script>
    document.getElementById('copyKeyButton')
      .addEventListener('click', async function () {
        const key = document.getElementById('apiKey').textContent.trim();

        try {
          await navigator.clipboard.writeText(key);
          this.textContent = 'Copied successfully';
        } catch (error) {
          alert('Copy failed. Please select and copy the key manually.');
        }
      });
  </script>
</body>
</html>
