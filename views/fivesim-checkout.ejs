<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= item.name %> – Checkout</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <style>
    body {
      font-family: "Cairo", sans-serif;
      background:
        radial-gradient(circle at top right, rgba(13, 110, 253, 0.09), transparent 34%),
        #f6f8fb;
    }

    .checkout-wrap {
      max-width: 1050px;
    }

    .checkout-card {
      border: 0;
      border-radius: 22px;
      box-shadow: 0 18px 55px rgba(25, 40, 70, 0.09);
      overflow: hidden;
    }

    .service-image {
      width: 86px;
      height: 86px;
      border-radius: 20px;
      object-fit: cover;
      border: 1px solid #e6eaf0;
      background: #f1f4f8;
    }

    .country-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      background: #eef4ff;
      color: #0d6efd;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .price-box {
      border: 1px solid #e7ebf2;
      background: #fbfcfe;
      border-radius: 18px;
      padding: 18px;
    }

    .price-value {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -1px;
    }

    .info-box {
      border-radius: 16px;
      padding: 15px 16px;
      background: #fff8e8;
      border: 1px solid #ffe5a8;
      color: #7a5900;
    }

    .success-box {
      border-radius: 16px;
      padding: 14px 16px;
      background: #edf9f2;
      border: 1px solid #ccebd9;
      color: #146c43;
    }

    .balance-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border-radius: 999px;
      background: #f2f4f7;
      color: #495057;
      font-size: 0.9rem;
    }

    .buy-btn {
      min-height: 52px;
      border-radius: 14px;
      font-weight: 700;
      font-size: 1rem;
    }

    .feature-row {
      display: flex;
      align-items: flex-start;
      gap: 11px;
      padding: 12px 0;
      border-bottom: 1px solid #edf0f4;
    }

    .feature-row:last-child {
      border-bottom: 0;
    }

    .feature-icon {
      width: 35px;
      height: 35px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #eef4ff;
      color: #0d6efd;
      flex: 0 0 auto;
    }

    @media (max-width: 767px) {
      .checkout-card {
        border-radius: 16px;
      }

      .price-value {
        font-size: 1.6rem;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/navbar', { user: user }) %>

  <main class="container py-5 checkout-wrap">
    <div class="mb-4">
      <a href="javascript:history.back()" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>
        Back
      </a>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger border-0 shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <%= error %>
      </div>
    <% } %>

    <div class="card checkout-card">
      <div class="card-body p-4 p-lg-5">
        <div class="row g-5">

          <div class="col-lg-7">
            <div class="d-flex align-items-center gap-3 mb-4">
              <img
                src="<%= item.serviceImage %>"
                alt="<%= item.name %>"
                class="service-image"
                onerror="this.src='/images/default-product.png'"
              />

              <div>
                <div class="text-muted small mb-1">Virtual Number</div>
                <h1 class="h3 fw-bold mb-2"><%= item.name %></h1>

                <span class="country-badge">
                  <i class="bi bi-geo-alt-fill"></i>
                  <%= item.countryName %>
                  <% if (item.countryIso) { %>
                    (<%= item.countryIso.toUpperCase() %>)
                  <% } %>
                </span>
              </div>
            </div>

            <div class="success-box mb-4">
              <i class="bi bi-check-circle-fill me-2"></i>
              The system will automatically select the best available operator.
            </div>

            <div class="feature-row">
              <span class="feature-icon">
                <i class="bi bi-phone"></i>
              </span>
              <div>
                <div class="fw-bold">Temporary phone number</div>
                <div class="small text-muted">
                  The number will appear immediately after a successful purchase.
                </div>
              </div>
            </div>

            <div class="feature-row">
              <span class="feature-icon">
                <i class="bi bi-chat-dots"></i>
              </span>
              <div>
                <div class="fw-bold">SMS code in My Orders</div>
                <div class="small text-muted">
                  Once the message arrives, the code will be displayed in your order details.
                </div>
              </div>
            </div>

            <div class="feature-row">
              <span class="feature-icon">
                <i class="bi bi-shield-check"></i>
              </span>
              <div>
                <div class="fw-bold">Automatic provider selection</div>
                <div class="small text-muted">
                  Operator names remain hidden and the server chooses the best suitable offer.
                </div>
              </div>
            </div>

            <div class="info-box mt-4">
              <div class="fw-bold mb-1">
                <i class="bi bi-info-circle-fill me-1"></i>
                Important
              </div>
              <div class="small">
                This is a temporary SMS activation number, not a permanent SIM card.
                Complete the activation before the number expires.
              </div>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="price-box">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted">Order total</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                  Available
                </span>
              </div>

              <div class="price-value mb-1">
                $<%= Number(item.price || 0).toFixed(2) %>
              </div>

              <div class="small text-muted mb-4">
                <%= Number(item.available || 0).toLocaleString() %> numbers currently available
              </div>

              <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="text-muted">Your balance</span>
                <span class="balance-chip">
                  <i class="bi bi-wallet2"></i>
                  $<%= Number(user?.balance || 0).toFixed(2) %>
                </span>
              </div>

              <form
                method="post"
                action="/virtual-numbers/buy/<%= item.id %>"
                id="buyForm"
              >
                <input type="hidden" name="idem_key" value="<%= idemKey %>" />

                <button
                  type="submit"
                  class="btn btn-primary w-100 buy-btn"
                  id="buyButton"
                  <%= Number(user?.balance || 0) < Number(item.price || 0) ? 'disabled' : '' %>
                >
                  <i class="bi bi-lightning-charge-fill me-2"></i>
                  Buy Number
                </button>
              </form>

              <% if (Number(user?.balance || 0) < Number(item.price || 0)) { %>
                <div class="alert alert-warning mt-3 mb-0 small">
                  <i class="bi bi-wallet2 me-1"></i>
                  Your balance is insufficient for this purchase.
                </div>
              <% } %>

              <div class="small text-muted text-center mt-3">
                The final price is read securely from the server.
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </main>

  <script src="/js/bootstrap.bundle.min.js"></script>

  <script>
    (function () {
      const form = document.getElementById('buyForm');
      const button = document.getElementById('buyButton');

      if (!form || !button) return;

      form.addEventListener('submit', function () {
        button.disabled = true;
        button.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2"></span>' +
          'Reserving number...';
      });
    })();
  </script>
</body>
</html>
