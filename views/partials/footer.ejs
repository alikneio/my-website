<script>
(function () {

 
  function extractProductFromHref(href) {

    if (!href) {
      return null;
    }

    try {

      const url = new URL(
        href,
        window.location.origin
      );

      const pathname =
        url.pathname || '';



      let match =
        pathname.match(
          /^\/api-checkout\/(\d+)(?:\/)?$/
        );

      if (match) {

        return {
          id: String(match[1]),
          source: 'api'
        };

      }


      match =
        pathname.match(
          /^\/checkout\/(\d+)(?:\/)?$/
        );

      if (match) {

        return {
          id: String(match[1]),
          source: 'sql'
        };

      }



      if (
        pathname === '/api-checkout' ||
        pathname === '/api-checkout/'
      ) {

        const q =
          url.searchParams.get('id') ||
          url.searchParams.get('product_id') ||
          url.searchParams.get('productId');

        if (
          q &&
          /^\d+$/.test(q)
        ) {

          return {
            id: String(q),
            source: 'api'
          };

        }

      }


      if (
        pathname === '/checkout' ||
        pathname === '/checkout/'
      ) {

        const q =
          url.searchParams.get('id') ||
          url.searchParams.get('product_id') ||
          url.searchParams.get('productId');

        if (
          q &&
          /^\d+$/.test(q)
        ) {

          return {
            id: String(q),
            source: 'sql'
          };

        }

      }


    } catch (e) {

      return null;

    }


    return null;

  }



  function makeOosKey(source, id) {

    return (
      String(source || '').toLowerCase() +
      ':' +
      String(id || '')
    );

  }



  async function applyOutOfStockOverlay() {

    try {

      const resp =
        await fetch(
          '/api/out-of-stock',
          {
            credentials: 'same-origin'
          }
        );


      if (!resp.ok) {

        console.warn(
          'OOS API returned status:',
          resp.status
        );

        return;

      }


      const items =
        await resp.json();


      if (
        !Array.isArray(items) ||
        items.length === 0
      ) {

        return;

      }


      const oosSet =
        new Set();


      items.forEach(function (item) {

        if (
          !item ||
          item.id === undefined ||
          item.id === null ||
          !item.source
        ) {

          return;

        }


        const source =
          String(item.source).toLowerCase();


        if (
          source !== 'sql' &&
          source !== 'api'
        ) {

          return;

        }


        oosSet.add(
          makeOosKey(
            source,
            item.id
          )
        );

      });



      const anchors =
        document.querySelectorAll(
          'a[href]'
        );


      anchors.forEach(function (a) {

        const href =
          a.getAttribute('href') || '';


        const product =
          extractProductFromHref(href);


        if (!product) {

          return;

        }


        const key =
          makeOosKey(
            product.source,
            product.id
          );


        if (!oosSet.has(key)) {

          return;

        }


     
        a.classList.add(
          'disabled-link'
        );


        a.setAttribute(
          'aria-disabled',
          'true'
        );


        a.setAttribute(
          'tabIndex',
          '-1'
        );


        const card =
          a.querySelector(
            '.product-card, .card'
          ) ||
          a.closest(
            '.product-card, .card'
          ) ||
          a;


       
        if (
          card &&
          !card.querySelector(
            '.out-of-stock-overlay'
          )
        ) {

          card.classList.add(
            'position-relative'
          );


          const overlay =
            document.createElement(
              'div'
            );


          overlay.className =
            'out-of-stock-overlay';


          overlay.textContent =
            'OUT OF STOCK';


          card.appendChild(
            overlay
          );

        }


        
        const button =
          a.querySelector(
            'button[type="submit"]'
          );


        if (button) {

          button.disabled =
            true;

        }

      });





      document
        .querySelectorAll('form')
        .forEach(function (form) {


          const productInput =
            form.querySelector(
              'input[name="product_id"], input[name="productId"]'
            );


          if (
            !productInput ||
            !productInput.value
          ) {

            return;

          }


          const productId =
            String(
              productInput.value
            );


          let source =
            null;



          const action =
            form.getAttribute('action') || '';


          if (action) {

            try {

              const actionUrl =
                new URL(
                  action,
                  window.location.origin
                );


              if (
                actionUrl.pathname.includes(
                  'api-checkout'
                )
              ) {

                source =
                  'api';

              } else if (
                actionUrl.pathname.includes(
                  'checkout'
                )
              ) {

                source =
                  'sql';

              }

            } catch (e) {}

          }



          if (!source) {

            const sourceInput =
              form.querySelector(
                'input[name="source"], input[name="product_source"]'
              );


            if (sourceInput) {

              const candidate =
                String(
                  sourceInput.value || ''
                ).toLowerCase();


              if (
                candidate === 'api' ||
                candidate === 'sql'
              ) {

                source =
                  candidate;

              }

            }

          }


      
          if (!source) {

            return;

          }


          const key =
            makeOosKey(
              source,
              productId
            );


          if (!oosSet.has(key)) {

            return;

          }


          const button =
            form.querySelector(
              'button[type="submit"]'
            );


          if (button) {

            button.disabled =
              true;

          }


          form.style.opacity =
            '.65';

        });


    } catch (e) {

      console.warn(
        'OOS overlay error:',
        e
      );

    }

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      applyOutOfStockOverlay
    );

  } else {

    applyOutOfStockOverlay();

  }

})();
</script>


