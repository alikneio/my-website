<div class="d-flex flex-column flex-shrink-0 p-3 text-white bg-dark"
     style="width:280px;min-height:100vh;">

  <a href="/admin"
     class="d-flex align-items-center mb-3 text-white text-decoration-none">
    <i class="bi bi-speedometer2 me-2"></i>
    <span class="fs-4">Admin Panel</span>
  </a>

  <hr>

  <ul class="nav nav-pills flex-column mb-auto">

    <!-- Dashboard -->
    <li>
      <a href="/admin" class="nav-link text-white">
        <i class="bi bi-grid"></i>
        <span class="ms-2">Dashboard</span>
      </a>
    </li>

    <!-- Orders -->
    <li>
      <a href="/admin/orders" class="nav-link text-white">
        <i class="bi bi-table"></i>
        <span class="ms-2">Orders</span>
      </a>
    </li>

    <!-- Balance -->
    <li>
      <a href="/admin/balance-requests"
         class="nav-link text-white d-flex justify-content-between align-items-center">

        <span>
          <i class="bi bi-wallet2"></i>
          <span class="ms-2">Balance Requests</span>
        </span>

        <% if ((pendingBalanceRequestsCount || 0) > 0) { %>
          <span class="badge bg-warning text-dark rounded-pill">
            <%= pendingBalanceRequestsCount > 99 ? '99+' : pendingBalanceRequestsCount %>
          </span>
        <% } %>

      </a>
    </li>

    <hr class="text-secondary">

    <!-- Products -->
    <li>
      <a href="/admin/products" class="nav-link text-white">
        <i class="bi bi-box-seam"></i>
        <span class="ms-2">Products</span>
      </a>
    </li>

    <li>
      <a href="/admin/stock" class="nav-link text-white">
        <i class="bi bi-archive-fill"></i>
        <span class="ms-2">Stock Management</span>
      </a>
    </li>

    <li>
      <a href="/admin/api-products" class="nav-link text-white">
        <i class="bi bi-cloud-arrow-down-fill"></i>
        <span class="ms-2">API Products</span>
      </a>
    </li>

    <li>
      <a href="/admin/api-categories" class="nav-link text-white">
        <i class="bi bi-grid-3x3-gap-fill"></i>
        <span class="ms-2">API Categories</span>
      </a>
    </li>

    <hr class="text-secondary">

    <!-- NEW -->
    <li>
      <a href="/admin/fivesim-services"
         class="nav-link text-white">

        <i class="bi bi-phone-vibrate-fill"></i>

        <span class="ms-2">
          Virtual Numbers
        </span>
      </a>
    </li>

    <hr class="text-secondary">

    <!-- SMM -->
    <li>
      <a href="/admin/smm-services"
         class="nav-link text-white">

        <i class="bi bi-instagram"></i>

        <span class="ms-2">
          SMM Services
        </span>
      </a>
    </li>

    <li>
      <a href="/admin/smm-categories"
         class="nav-link text-white">

        <i class="bi bi-collection"></i>

        <span class="ms-2">
          SMM Categories
        </span>
      </a>
    </li>

    <hr class="text-secondary">

    <!-- Users -->
    <li>
      <a href="/admin/users" class="nav-link text-white">
        <i class="bi bi-people-fill"></i>
        <span class="ms-2">Users</span>
      </a>
    </li>

  </ul>

  <hr>

  <a href="/" class="btn btn-secondary">
    <i class="bi bi-arrow-left-square me-2"></i>
    Back to Main Site
  </a>

