<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin – SMM Categories</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css" />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <style>
    .category-preview {
      width: 90px;
      height: 65px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid #dee2e6;
      background: #f8f9fa;
      display: block;
    }

    .image-path-input {
      min-width: 250px;
    }

    .category-name-input {
      min-width: 210px;
    }

    .category-slug-input {
      min-width: 190px;
    }

    .category-actions {
      white-space: nowrap;
    }

    .table td,
    .table th {
      vertical-align: middle;
    }

    @media (max-width: 767.98px) {
      .main-header-row {
        flex-direction: column;
        align-items: flex-start !important;
        gap: 12px;
      }

      .main-header-row .btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/admin-sidebar', { user: user }) %>

  <main class="main-content">
    <div class="container-fluid py-4" style="max-width: 1400px;">

      <!-- Header -->
      <div class="main-header-row d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0">
          <i class="bi bi-collection-play"></i>
          SMM Categories
        </h1>

        <a href="/" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-box-arrow-left"></i>
          Back to main site
        </a>
      </div>

      <!-- Flash message -->
      <% if (flash) { %>
        <div
          class="alert alert-<%= flash.type === 'info' ? 'info' : 'danger' %> alert-dismissible fade show"
          role="alert"
        >
          <%= flash.message %>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
          ></button>
        </div>
      <% } %>

      <!-- Create new category -->
      <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2 class="h6 mb-0 text-uppercase text-muted">
            Create new category
          </h2>
        </div>

        <div class="card-body">
          <form
            class="row g-3 align-items-end"
            method="post"
            action="/admin/smm-categories/create"
          >
            <div class="col-lg-4 col-md-6">
              <label class="form-label text-uppercase small text-muted">
                Name
              </label>

              <input
                type="text"
                name="name"
                class="form-control"
                placeholder="e.g., Instagram Followers"
                required
              />
            </div>

            <div class="col-lg-4 col-md-6">
              <label class="form-label text-uppercase small text-muted">
                Image path
              </label>

              <input
                type="text"
                name="image"
                class="form-control"
                placeholder="/images/smm/instagram-followers.webp"
              />

              <div class="form-text small text-muted">
                Add the image inside public/images and enter its public path.
              </div>
            </div>

            <div class="col-lg-2 col-md-6">
              <label class="form-label text-uppercase small text-muted">
                Sort order
              </label>

              <input
                type="number"
                name="sort_order"
                class="form-control"
                value="0"
              />

              <div class="form-text small text-muted">
                Smaller numbers appear first.
              </div>
            </div>

            <div class="col-lg-2 col-md-6">
              <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-plus-circle"></i>
                Add
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Filters -->
      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <form
            class="row g-3 align-items-end"
            method="get"
            action="/admin/smm-categories"
          >
            <div class="col-md-6">
              <label class="form-label text-uppercase small text-muted">
                Search
              </label>

              <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search by name, slug or ID"
                value="<%= filters && filters.search ? filters.search : '' %>"
              />
            </div>

            <div class="col-md-3">
              <label class="form-label text-uppercase small text-muted">
                Status
              </label>

              <select name="status" class="form-select">
                <option
                  value="all"
                  <%= !filters || filters.status === 'all' ? 'selected' : '' %>
                >
                  All
                </option>

                <option
                  value="active"
                  <%= filters && filters.status === 'active' ? 'selected' : '' %>
                >
                  Active
                </option>

                <option
                  value="inactive"
                  <%= filters && filters.status === 'inactive' ? 'selected' : '' %>
                >
                  Disabled
                </option>
              </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
              <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel"></i>
                Apply
              </button>

              <a
                href="/admin/smm-categories"
                class="btn btn-outline-secondary"
              >
                Reset
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Categories list -->
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h6 mb-0 text-uppercase text-muted">
              Categories list
            </h2>

            <small class="text-muted">
              Showing
              <strong><%= categories ? categories.length : 0 %></strong>
              categories.
            </small>
          </div>

          <% if (!categories || !categories.length) { %>
            <div class="text-center text-muted py-4">
              No categories found. Try changing filters or add a new category above.
            </div>
          <% } else { %>

            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th style="width: 70px;">ID</th>
                    <th style="width: 110px;">Preview</th>
                    <th style="width: 230px;">Name</th>
                    <th style="width: 210px;">Slug</th>
                    <th style="width: 290px;">Image path</th>
                    <th style="width: 95px;">Sort</th>
                    <th style="width: 115px;">Status</th>
                    <th style="width: 210px;" class="text-end">
                      Actions
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <% categories.forEach(function(c) { %>
                    <tr>
                      <td class="text-muted">
                        #<%= c.id %>
                      </td>

                      <td>
                        <img
                          id="preview-<%= c.id %>"
                          src="<%= c.image || '/images/default-category.png' %>"
                          alt="<%= c.name %>"
                          class="category-preview"
                          onerror="this.onerror=null;this.src='/images/default-category.png';"
                        />
                      </td>

                      <td>
                        <form
                          method="post"
                          action="/admin/smm-categories/<%= c.id %>/update"
                          class="d-contents"
                        >
                          <input
                            type="text"
                            name="name"
                            class="form-control form-control-sm category-name-input"
                            value="<%= c.name %>"
                            required
                          />
                      </td>

                      <td>
                          <input
                            type="text"
                            name="slug"
                            class="form-control form-control-sm category-slug-input"
                            value="<%= c.slug %>"
                            required
                          />
                      </td>

                      <td>
                          <input
                            type="text"
                            name="image"
                            class="form-control form-control-sm image-path-input"
                            value="<%= c.image || '' %>"
                            placeholder="/images/smm/category.webp"
                            data-preview-target="preview-<%= c.id %>"
                          />
                      </td>

                      <td>
                          <input
                            type="number"
                            name="sort_order"
                            class="form-control form-control-sm"
                            value="<%= c.sort_order %>"
                          />
                      </td>

                      <td>
                        <% if (c.is_active) { %>
                          <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i>
                            Active
                          </span>
                        <% } else { %>
                          <span class="badge bg-secondary">
                            <i class="bi bi-pause-circle"></i>
                            Disabled
                          </span>
                        <% } %>
                      </td>

                      <td class="text-end category-actions">
                          <button
                            type="submit"
                            class="btn btn-sm btn-outline-primary"
                          >
                            <i class="bi bi-save"></i>
                            Save
                          </button>
                        </form>

                        <form
                          method="post"
                          action="/admin/smm-categories/<%= c.id %>/toggle"
                          class="d-inline"
                        >
                          <button
                            type="submit"
                            class="btn btn-sm <%= c.is_active ? 'btn-warning' : 'btn-success' %> ms-1"
                          >
                            <i class="bi <%= c.is_active ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                            <%= c.is_active ? 'Disable' : 'Enable' %>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

          <% } %>
        </div>
      </div>
    </div>
  </main>

  <script src="/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const imageInputs = document.querySelectorAll('[data-preview-target]');

      imageInputs.forEach(function (input) {
        input.addEventListener('input', function () {
          const previewId = input.dataset.previewTarget;
          const preview = document.getElementById(previewId);

          if (!preview) return;

          const imagePath = input.value.trim();

          preview.src = imagePath || '/images/default-category.png';
        });
      });
    });
  </script>
</body>
</html>