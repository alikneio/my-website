<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <title>Order <%= service.name %> | AK Cell</title>

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  />

  <link rel="stylesheet" href="/css/bootstrap.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <link
    rel="stylesheet"
    href="/css/bootstrap-icons/font/bootstrap-icons.css"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --checkout-primary: #1769ff;
      --checkout-secondary: #6847f5;
      --checkout-dark: #101828;
      --checkout-text: #344054;
      --checkout-muted: #667085;
      --checkout-border: #e4e7ec;
      --checkout-bg: #f2f5fb;
      --checkout-success: #079455;
      --checkout-danger: #d92d20;
      --checkout-warning: #dc6803;
      --checkout-radius: 18px;
      --checkout-shadow: 0 14px 40px rgba(16, 24, 40, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      max-width: 100%;
      margin: 0;
      overflow-x: hidden;
    }

    body {
      min-height: 100vh;
      font-family:
        "Cairo",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: var(--checkout-dark);

      background:
        radial-gradient(
          circle at 0 0,
          rgba(23, 105, 255, 0.13),
          transparent 35%
        ),
        radial-gradient(
          circle at 100% 15%,
          rgba(104, 71, 245, 0.1),
          transparent 30%
        ),
        var(--checkout-bg);
    }

    button,
    input {
      font: inherit;
    }

    .smm-checkout-page {
      width: 100%;
      padding: 12px 0 36px;
    }

    .smm-checkout-container {
      width: min(100% - 24px, 1160px);
      margin-inline: auto;
    }

    /* =====================================
       TOP BAR
       ===================================== */

    .smm-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
      margin-bottom: 12px;
    }

    .smm-topbar-brand {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
      color: var(--checkout-dark);
      font-size: 14px;
      font-weight: 800;
    }

    .smm-topbar-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: linear-gradient(
        135deg,
        var(--checkout-primary),
        var(--checkout-secondary)
      );
      border-radius: 12px;
      box-shadow: 0 8px 20px rgba(23, 105, 255, 0.25);
    }

    .smm-back-btn {
      min-height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 7px 13px;
      color: #475467;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--checkout-border);
      border-radius: 999px;
      text-decoration: none;
      white-space: nowrap;
    }

    .smm-back-btn:hover {
      color: var(--checkout-primary);
      border-color: rgba(23, 105, 255, 0.5);
    }

    /* =====================================
       ALERT
       ===================================== */

    .smm-error-alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      width: 100%;
      margin-bottom: 12px;
      padding: 13px;
      color: #912018;
      background: #fef3f2;
      border: 1px solid #fecdca;
      border-radius: 15px;
      font-size: 13px;
      line-height: 1.6;
    }

    .smm-error-icon {
      width: 32px;
      height: 32px;
      flex: 0 0 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: var(--checkout-danger);
      border-radius: 50%;
    }

    .smm-error-alert strong {
      display: block;
      margin-bottom: 2px;
    }

    /* =====================================
       SERVICE HEADER
       ===================================== */

    .smm-service-hero {
      width: 100%;
      min-width: 0;
      display: grid;
      grid-template-columns: 86px minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      padding: 12px;
      margin-bottom: 12px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid var(--checkout-border);
      border-radius: var(--checkout-radius);
      box-shadow: var(--checkout-shadow);
    }

    .smm-service-image {
      width: 86px;
      height: 86px;
      overflow: hidden;
      background: #f2f4f7;
      border: 1px solid var(--checkout-border);
      border-radius: 14px;
    }

    .smm-service-image img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .smm-service-info {
      min-width: 0;
    }

    .smm-service-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 6px;
    }

    .smm-badge {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      max-width: 100%;
      padding: 3px 7px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 700;
      line-height: 1.3;
    }

    .smm-badge.category {
      color: #175cd3;
      background: #eff8ff;
      border: 1px solid #b2ddff;
    }

    .smm-badge.default {
      color: #344054;
      background: #f2f4f7;
      border: 1px solid #eaecf0;
    }

    .smm-badge.success {
      color: #067647;
      background: #ecfdf3;
      border: 1px solid #abefc6;
    }

    .smm-badge.warning {
      color: #b54708;
      background: #fffaeb;
      border: 1px solid #fedf89;
    }

    .smm-badge.danger {
      color: #b42318;
      background: #fef3f2;
      border: 1px solid #fecdca;
    }

    .smm-service-title {
      display: -webkit-box;
      margin: 0;
      overflow: hidden;
      color: var(--checkout-dark);
      font-size: 14px;
      font-weight: 800;
      line-height: 1.45;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow-wrap: anywhere;
    }

    /* =====================================
       MAIN LAYOUT — MOBILE FIRST
       ===================================== */

    .smm-checkout-layout {
      width: 100%;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .smm-panel {
      width: 100%;
      min-width: 0;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.97);
      border: 1px solid var(--checkout-border);
      border-radius: var(--checkout-radius);
      box-shadow: var(--checkout-shadow);
    }

    .smm-form-panel {
      padding: 16px;
    }

    .smm-step + .smm-step {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #eaecf0;
    }

    .smm-step-heading {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 14px;
    }

    .smm-step-number {
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      background: linear-gradient(
        135deg,
        var(--checkout-primary),
        var(--checkout-secondary)
      );
      border-radius: 12px;
      font-size: 15px;
      font-weight: 800;
      box-shadow: 0 8px 20px rgba(23, 105, 255, 0.22);
    }

    .smm-step-title {
      margin: 0;
      color: var(--checkout-dark);
      font-size: 15px;
      font-weight: 800;
    }

    .smm-step-description {
      margin: 2px 0 0;
      color: var(--checkout-muted);
      font-size: 11px;
      line-height: 1.5;
    }

    /* =====================================
       FIELDS
       ===================================== */

    .smm-label {
      display: block;
      margin-bottom: 7px;
      color: var(--checkout-text);
      font-size: 12px;
      font-weight: 800;
    }

    .smm-input-wrap {
      position: relative;
      width: 100%;
      min-width: 0;
    }

    .smm-input-icon {
      position: absolute;
      top: 50%;
      left: 15px;
      z-index: 2;
      transform: translateY(-50%);
      color: #98a2b3;
      pointer-events: none;
    }

    .smm-input {
      width: 100%;
      min-width: 0;
      height: 54px;
      padding: 10px 13px 10px 43px;
      color: var(--checkout-dark);
      background: #fff;
      border: 1.5px solid #d0d5dd;
      border-radius: 13px;
      outline: none;
      box-shadow: none;
      font-size: 14px;
      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    .smm-input::placeholder {
      color: #98a2b3;
    }

    .smm-input:focus {
      border-color: var(--checkout-primary);
      box-shadow: 0 0 0 4px rgba(23, 105, 255, 0.1);
    }

    .smm-input.valid {
      border-color: #12b76a;
      box-shadow: 0 0 0 4px rgba(18, 183, 106, 0.09);
    }

    .smm-input.invalid {
      border-color: #f04438;
      box-shadow: 0 0 0 4px rgba(240, 68, 56, 0.08);
    }

    .smm-field-message {
      min-height: 18px;
      margin-top: 6px;
      color: var(--checkout-muted);
      font-size: 10px;
      line-height: 1.5;
    }

    .smm-field-message.success {
      color: var(--checkout-success);
    }

    .smm-field-message.error {
      color: var(--checkout-danger);
    }

    /* =====================================
       QUANTITY
       ===================================== */

    .smm-limits {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-bottom: 11px;
    }

    .smm-limit {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      color: #475467;
      background: #f9fafb;
      border: 1px solid #eaecf0;
      border-radius: 999px;
      font-size: 9px;
      line-height: 1.4;
    }

    .smm-limit strong {
      color: var(--checkout-text);
    }

    .smm-quick-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 7px;
      width: 100%;
      margin-top: 11px;
    }

    .smm-quick-btn {
      width: 100%;
      min-width: 0;
      height: 42px;
      padding: 5px;
      color: #344054;
      background: #fff;
      border: 1px solid #d0d5dd;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 800;
      transition: 0.18s ease;
    }

    .smm-quick-btn:hover {
      color: var(--checkout-primary);
      background: #eff6ff;
      border-color: rgba(23, 105, 255, 0.45);
    }

    .smm-quick-btn.active {
      color: #fff;
      background: var(--checkout-primary);
      border-color: var(--checkout-primary);
    }

    .smm-order-notice {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
      margin-top: 17px;
      padding: 10px;
      color: #475467;
      background: #f9fafb;
      border: 1px solid #eaecf0;
      border-radius: 12px;
      font-size: 10px;
      line-height: 1.55;
    }

    .smm-order-notice i {
      margin-top: 1px;
      color: var(--checkout-primary);
    }

    /* =====================================
       SUMMARY — FULL WIDTH ON MOBILE
       ===================================== */

    .smm-summary-panel {
      width: 100%;
      min-width: 0;
      padding: 16px;
    }

    .smm-summary-heading {
      margin-bottom: 13px;
    }

    .smm-summary-title {
      margin: 0;
      color: var(--checkout-dark);
      font-size: 16px;
      font-weight: 800;
    }

    .smm-summary-subtitle {
      margin: 2px 0 0;
      color: var(--checkout-muted);
      font-size: 10px;
    }

    .smm-total-box {
      width: 100%;
      min-width: 0;
      padding: 16px;
      color: #fff;
      background: linear-gradient(
        135deg,
        var(--checkout-primary),
        var(--checkout-secondary)
      );
      border-radius: 15px;
      box-shadow: 0 13px 27px rgba(23, 105, 255, 0.22);
    }

    .smm-total-label {
      font-size: 10px;
      opacity: 0.82;
    }

    .smm-total-price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 3px;
      margin-top: 3px;
      font-size: 28px;
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.03em;
    }

    .smm-total-price small {
      font-size: 10px;
      font-weight: 700;
      opacity: 0.8;
    }

    .smm-total-note {
      margin-top: 5px;
      font-size: 9px;
      opacity: 0.75;
    }

    .smm-summary-data {
      display: grid;
      gap: 9px;
      margin-top: 14px;
    }

    .smm-summary-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      min-width: 0;
      color: #475467;
      font-size: 11px;
    }

    .smm-summary-row strong {
      min-width: 0;
      color: var(--checkout-dark);
      text-align: right;
      overflow-wrap: anywhere;
    }

    .smm-summary-separator {
      height: 1px;
      margin: 14px 0;
      background: #eaecf0;
    }

    .smm-balance-box {
      width: 100%;
      padding: 12px;
      background: #f9fafb;
      border: 1px solid #eaecf0;
      border-radius: 13px;
    }

    .smm-balance-values {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 10px;
    }

    .smm-balance-item:last-child {
      text-align: right;
    }

    .smm-balance-label {
      color: var(--checkout-muted);
      font-size: 9px;
    }

    .smm-balance-value {
      margin-top: 2px;
      color: var(--checkout-dark);
      font-size: 15px;
      font-weight: 800;
    }

    .smm-balance-status {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      min-height: 42px;
      margin-top: 10px;
      padding: 9px 10px;
      border-radius: 10px;
      font-size: 10px;
      line-height: 1.45;
    }

    .smm-balance-status.waiting {
      color: #475467;
      background: #f2f4f7;
    }

    .smm-balance-status.success {
      color: #067647;
      background: #ecfdf3;
    }

    .smm-balance-status.error {
      color: #b42318;
      background: #fef3f2;
    }

    .smm-confirm-btn {
      width: 100%;
      min-width: 0;
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin-top: 12px;
      padding: 10px 14px;
      color: #fff;
      background: linear-gradient(
        135deg,
        var(--checkout-primary),
        var(--checkout-secondary)
      );
      border: 0;
      border-radius: 13px;
      font-size: 13px;
      font-weight: 800;
      box-shadow: 0 12px 26px rgba(23, 105, 255, 0.22);
    }

    .smm-confirm-btn:disabled {
      cursor: not-allowed;
      opacity: 0.45;
      box-shadow: none;
    }

    .smm-secure-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      margin-top: 9px;
      color: var(--checkout-muted);
      font-size: 9px;
      text-align: center;
    }

    /* =====================================
       MODAL
       ===================================== */

    .smm-confirm-modal .modal-dialog {
      margin: 12px;
    }

    .smm-confirm-modal .modal-content {
      overflow: hidden;
      border: 0;
      border-radius: 19px;
      box-shadow: 0 26px 80px rgba(16, 24, 40, 0.26);
    }

    .smm-confirm-modal .modal-body {
      padding: 18px;
    }

    .smm-modal-icon {
      width: 50px;
      height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 11px;
      color: var(--checkout-primary);
      background: #eff6ff;
      border-radius: 15px;
      font-size: 22px;
    }

    .smm-modal-preview {
      display: grid;
      gap: 8px;
      padding: 12px;
      margin: 14px 0;
      background: #f9fafb;
      border: 1px solid #eaecf0;
      border-radius: 13px;
    }

    .smm-modal-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
      color: var(--checkout-muted);
      font-size: 11px;
    }

    .smm-modal-row strong {
      max-width: 68%;
      color: var(--checkout-dark);
      text-align: right;
      overflow-wrap: anywhere;
    }

    /* =====================================
       DESKTOP ONLY
       ===================================== */

    @media (min-width: 768px) {
      .smm-checkout-page {
        padding-top: 20px;
      }

      .smm-service-hero {
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 18px;
        padding: 16px;
      }

      .smm-service-image {
        width: 150px;
        height: 100px;
      }

      .smm-service-title {
        font-size: 19px;
        -webkit-line-clamp: 2;
      }

      .smm-badge {
        padding: 4px 9px;
        font-size: 10px;
      }

      .smm-checkout-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 18px;
        align-items: start;
      }

      .smm-form-panel,
      .smm-summary-panel {
        padding: 22px;
      }

      .smm-step-title {
        font-size: 17px;
      }

      .smm-step-description {
        font-size: 12px;
      }

      .smm-label {
        font-size: 13px;
      }

      .smm-input {
        height: 58px;
        font-size: 15px;
      }

      .smm-field-message {
        font-size: 11px;
      }

      .smm-limit {
        font-size: 10px;
      }

      .smm-quick-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .smm-quick-btn {
        height: 44px;
        font-size: 12px;
      }

      .smm-order-notice {
        font-size: 11px;
      }

      .smm-summary-panel {
        position: sticky;
        top: 85px;
      }

      .smm-summary-title {
        font-size: 18px;
      }

      .smm-summary-subtitle {
        font-size: 11px;
      }

      .smm-total-price {
        font-size: 33px;
      }

      .smm-summary-row {
        font-size: 12px;
      }

      .smm-balance-label {
        font-size: 10px;
      }

      .smm-balance-value {
        font-size: 17px;
      }

      .smm-balance-status {
        font-size: 11px;
      }

      .smm-confirm-btn {
        min-height: 55px;
        font-size: 14px;
      }
    }

    @media (min-width: 1100px) {
      .smm-checkout-layout {
        grid-template-columns: minmax(0, 1fr) 390px;
      }
    }
  </style>
</head>

<body>

  <%- include('partials/header', { user: user }) %>

  <%
    const ratePer = Number(service.rate_per || 1000) || 1000;
    const minQtySafe = Number(service.min_qty || 1);
    const maxQtySafe = Number(service.max_qty || minQtySafe);
    const userBalanceSafe = Number(balance || 0);

    const serviceImage =
      service.image && String(service.image).trim()
        ? String(service.image).trim()
        : '/images/default-category.png';

    const showBest =
      Number(service.badge_best_price ?? service.best_price ?? 0) === 1;

    const showFast =
      Number(service.badge_fast_start ?? service.fast_start ?? 0) === 1;

    const showRefill =
      Number(service.badge_refill ?? service.refill ?? 0) === 1;

    const showNoRefill =
      Number(service.badge_no_refill ?? service.no_refill ?? 0) === 1;

    const showLowQuality =
      Number(service.badge_low_quality ?? service.low_quality ?? 0) === 1;
  %>

  <main class="smm-checkout-page">
    <div class="smm-checkout-container">

      <!-- TOP BAR -->
      <div class="smm-topbar">
        <div class="smm-topbar-brand">
          <span class="smm-topbar-icon">
            <i class="bi bi-stars"></i>
          </span>

          <span>Social Media Checkout</span>
        </div>

        <a
          href="javascript:history.back()"
          class="smm-back-btn"
        >
          <i class="bi bi-arrow-left"></i>
          <span>Back</span>
        </a>
      </div>

      <!-- ERROR MESSAGE -->
      <% if (error) { %>
        <div class="smm-error-alert">
          <span class="smm-error-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </span>

          <div>
            <% if (error === 'provider') { %>
              <strong>We could not submit this order.</strong>
              Check that the link is correct, public when required,
              and matches the selected service.

            <% } else if (error === 'missing_fields') { %>
              <strong>Please complete all required fields.</strong>
              Enter the link and quantity, then try again.

            <% } else if (error === 'invalid_quantity') { %>
              <strong>The quantity is not valid.</strong>
              Please enter a whole number.

            <% } else if (error === 'range') { %>
              <strong>The quantity is outside the allowed range.</strong>
              Choose a quantity between
              <%= rangeMin %> and <%= rangeMax %>.

            <% } else if (error === 'balance') { %>
              <strong>Your balance is not enough.</strong>
              Reduce the quantity or recharge your balance.

            <% } else if (error === 'missing_idem') { %>
              <strong>Your checkout session expired.</strong>
              Reload the page and try again.

            <% } else { %>
              <strong>Something went wrong.</strong>
              Please verify your information and try again.
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- SERVICE -->
      <section class="smm-service-hero">
        <div class="smm-service-image">
          <img
            src="<%= serviceImage %>"
            alt="<%= service.name %>"
            onerror="this.onerror=null;this.src='/images/default-category.png';"
          />
        </div>

        <div class="smm-service-info">
          <div class="smm-service-badges">

            <% if (service.category_name) { %>
              <span class="smm-badge category">
                <i class="bi bi-grid"></i>
                <%= service.category_name %>
              </span>
            <% } %>

            <% if (showBest) { %>
              <span class="smm-badge default">
                <i class="bi bi-graph-up-arrow"></i>
                Best price
              </span>
            <% } %>

            <% if (showFast) { %>
              <span class="smm-badge default">
                <i class="bi bi-lightning-charge-fill"></i>
                Fast start
              </span>
            <% } %>

            <% if (showRefill) { %>
              <span class="smm-badge success">
                <i class="bi bi-shield-check"></i>
                Refill
              </span>
            <% } %>

            <% if (showNoRefill) { %>
              <span class="smm-badge danger">
                <i class="bi bi-slash-circle"></i>
                No refill
              </span>
            <% } %>

            <% if (showLowQuality) { %>
              <span class="smm-badge warning">
                <i class="bi bi-exclamation-triangle"></i>
                Low quality
              </span>
            <% } %>

          </div>

          <h1 class="smm-service-title">
            <%= service.name %>
          </h1>
        </div>
      </section>

      <form
        id="buySocialForm"
        method="POST"
        action="/buy-social"
        novalidate
      >
        <input
          type="hidden"
          name="service_id"
          value="<%= service.id %>"
        />

        <input
          type="hidden"
          name="idempotency_key"
          id="idemKeyInput"
          value="<%= (idemKey || '').toString() %>"
        />

        <div class="smm-checkout-layout">

          <!-- FORM -->
          <section class="smm-panel smm-form-panel">

            <!-- LINK -->
            <div class="smm-step">
              <div class="smm-step-heading">
                <span class="smm-step-number">1</span>

                <div>
                  <h2 class="smm-step-title">
                    Add the correct link
                  </h2>

                  <p class="smm-step-description">
                    Paste the profile, post, reel or video link required by this service.
                  </p>
                </div>
              </div>

              <label class="smm-label" for="linkInput">
                Profile, post or video link
              </label>

              <div class="smm-input-wrap">
                <i class="bi bi-link-45deg smm-input-icon"></i>

                <input
                  type="text"
                  id="linkInput"
                  name="link"
                  class="smm-input"
                  placeholder="Paste the link here"
                  value="<%= formLink || '' %>"
                  autocomplete="off"
                  required
                />
              </div>

              <div id="linkMessage" class="smm-field-message">
                Make sure the account or post is public when required.
              </div>
            </div>

            <!-- QUANTITY -->
            <div class="smm-step">
              <div class="smm-step-heading">
                <span class="smm-step-number">2</span>

                <div>
                  <h2 class="smm-step-title">
                    Choose the quantity
                  </h2>

                  <p class="smm-step-description">
                    Your total price updates automatically.
                  </p>
                </div>
              </div>

              <div class="smm-limits">
                <span class="smm-limit">
                  <i class="bi bi-arrow-down"></i>
                  Minimum:
                  <strong><%= minQtySafe.toLocaleString() %></strong>
                </span>

                <span class="smm-limit">
                  <i class="bi bi-arrow-up"></i>
                  Maximum:
                  <strong><%= maxQtySafe.toLocaleString() %></strong>
                </span>

                <% if (service.average_time) { %>
                  <span class="smm-limit">
                    <i class="bi bi-clock"></i>
                    <%= service.average_time %>
                  </span>
                <% } %>
              </div>

              <label class="smm-label" for="qtyInput">
                Quantity
              </label>

              <div class="smm-input-wrap">
                <i class="bi bi-hash smm-input-icon"></i>

                <input
                  type="number"
                  id="qtyInput"
                  name="quantity"
                  class="smm-input"
                  min="<%= minQtySafe %>"
                  max="<%= maxQtySafe %>"
                  step="1"
                  placeholder="Enter quantity"
                  value="<%= formQty || '' %>"
                  inputmode="numeric"
                  required
                />
              </div>

              <div id="qtyMessage" class="smm-field-message">
                Enter a value between
                <%= minQtySafe.toLocaleString() %>
                and
                <%= maxQtySafe.toLocaleString() %>.
              </div>

              <div
                id="quickQuantities"
                class="smm-quick-grid"
              ></div>
            </div>

            <div class="smm-order-notice">
              <i class="bi bi-info-circle-fill"></i>

              <span>
                Verify the link before confirming. Some social media orders
                cannot be cancelled after submission.
              </span>
            </div>

          </section>

          <!-- SUMMARY -->
          <aside class="smm-panel smm-summary-panel">
            <div class="smm-summary-heading">
              <h2 class="smm-summary-title">
                Order summary
              </h2>

              <p class="smm-summary-subtitle">
                Review your order before confirming.
              </p>
            </div>

            <div class="smm-total-box">
              <div class="smm-total-label">
                Total price
              </div>

              <div class="smm-total-price">
                <span>$</span>
                <span id="estimatedPrice">0.0000</span>
                <small>USD</small>
              </div>

              <div class="smm-total-note">
                Calculated from your selected quantity.
              </div>
            </div>

            <div class="smm-summary-data">
              <div class="smm-summary-row">
                <span>Quantity</span>
                <strong id="summaryQuantity">—</strong>
              </div>

              <!-- يظهر على الكمبيوتر فقط عبر JavaScript/CSS عند الحاجة -->
              <div class="smm-summary-row d-none d-md-flex">
                <span>Service rate</span>

                <strong>
                  $<%= Number(service.rate || 0).toFixed(4) %>
                  /
                  <%= ratePer.toLocaleString() %>
                </strong>
              </div>

              <% if (service.average_time) { %>
                <div class="smm-summary-row d-none d-md-flex">
                  <span>Estimated time</span>
                  <strong><%= service.average_time %></strong>
                </div>
              <% } %>
            </div>

            <div class="smm-summary-separator"></div>

            <div class="smm-balance-box">
              <div class="smm-balance-values">
                <div class="smm-balance-item">
                  <div class="smm-balance-label">
                    Current balance
                  </div>

                  <div class="smm-balance-value">
                    $<%= userBalanceSafe.toFixed(2) %>
                  </div>
                </div>

                <div class="smm-balance-item">
                  <div class="smm-balance-label">
                    Balance after order
                  </div>

                  <div
                    id="balanceAfter"
                    class="smm-balance-value"
                  >
                    $<%= userBalanceSafe.toFixed(2) %>
                  </div>
                </div>
              </div>

              <div
                id="balanceStatus"
                class="smm-balance-status waiting"
              >
                <i class="bi bi-hourglass-split"></i>
                Enter the link and quantity to continue.
              </div>
            </div>

            <button
              id="confirmBtn"
              type="button"
              class="smm-confirm-btn"
              disabled
            >
              <i class="bi bi-check2-circle"></i>
              Review and confirm
            </button>

            <div class="smm-secure-note">
              <i class="bi bi-shield-lock"></i>
              Your order will only be submitted once.
            </div>
          </aside>

        </div>
      </form>
    </div>
  </main>

  <!-- CONFIRMATION MODAL -->
  <div
    class="modal fade smm-confirm-modal"
    id="confirmationModal"
    tabindex="-1"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-body">

          <div class="smm-modal-icon">
            <i class="bi bi-check2-circle"></i>
          </div>

          <h2 class="h5 fw-bold mb-1">
            Confirm your order
          </h2>

          <p class="text-muted small mb-0">
            Check the information one last time.
          </p>

          <div class="smm-modal-preview">
            <div class="smm-modal-row">
              <span>Link</span>
              <strong id="confirmLink">—</strong>
            </div>

            <div class="smm-modal-row">
              <span>Quantity</span>
              <strong id="confirmQuantity">—</strong>
            </div>

            <div class="smm-modal-row">
              <span>Total</span>
              <strong id="confirmPrice">$0.0000</strong>
            </div>
          </div>

          <div class="alert alert-warning small py-2 mb-3">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Do not change the username or link while processing.
          </div>

          <div class="d-flex gap-2">
            <button
              type="button"
              class="btn btn-outline-secondary flex-grow-1"
              data-bs-dismiss="modal"
            >
              Go back
            </button>

            <button
              type="button"
              id="finalSubmitBtn"
              class="btn btn-primary flex-grow-1 fw-bold"
            >
              <i class="bi bi-cart-check me-1"></i>
              Submit
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap must load before checkout JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const rate = Number(<%= Number(service.rate || 0) %>);
      const ratePer = Number(<%= ratePer %>);
      const minQty = Number(<%= minQtySafe %>);
      const maxQty = Number(<%= maxQtySafe %>);
      const userBalance = Number(<%= userBalanceSafe %>);

      const form = document.getElementById('buySocialForm');
      const linkInput = document.getElementById('linkInput');
      const qtyInput = document.getElementById('qtyInput');
      const idemInput = document.getElementById('idemKeyInput');

      const linkMessage = document.getElementById('linkMessage');
      const qtyMessage = document.getElementById('qtyMessage');
      const quickQuantities = document.getElementById('quickQuantities');

      const estimatedPrice = document.getElementById('estimatedPrice');
      const summaryQuantity = document.getElementById('summaryQuantity');
      const balanceAfter = document.getElementById('balanceAfter');
      const balanceStatus = document.getElementById('balanceStatus');

      const confirmBtn = document.getElementById('confirmBtn');
      const finalSubmitBtn = document.getElementById('finalSubmitBtn');

      const confirmLink = document.getElementById('confirmLink');
      const confirmQuantity = document.getElementById('confirmQuantity');
      const confirmPrice = document.getElementById('confirmPrice');

      const modalElement =
        document.getElementById('confirmationModal');

      const confirmationModal =
        modalElement &&
        window.bootstrap &&
        window.bootstrap.Modal
          ? new window.bootstrap.Modal(modalElement)
          : null;

      let calculatedTotal = 0;
      let submitting = false;

      function formatNumber(value) {
        return Number(value || 0).toLocaleString('en-US');
      }

      function generateToken() {
        if (
          window.crypto &&
          typeof window.crypto.randomUUID === 'function'
        ) {
          return window.crypto.randomUUID();
        }

        return (
          'checkout-' +
          Date.now() +
          '-' +
          Math.random().toString(16).slice(2)
        );
      }

      function ensureToken() {
        if (!idemInput) return;

        if (!String(idemInput.value || '').trim()) {
          idemInput.value = generateToken();
        }
      }

      function buildQuickQuantityValues() {
        const values = [
          minQty,
          100,
          200,
          250,
          500,
          1000,
          2500,
          5000,
          10000,
          25000,
          50000,
          maxQty
        ];

        return [...new Set(values)]
          .filter(function (value) {
            return (
              Number.isFinite(value) &&
              value >= minQty &&
              value <= maxQty
            );
          })
          .sort(function (a, b) {
            return a - b;
          })
          .slice(0, 6);
      }

      function renderQuickQuantities() {
        if (!quickQuantities) return;

        quickQuantities.innerHTML = '';

        buildQuickQuantityValues().forEach(function (value) {
          const button = document.createElement('button');

          button.type = 'button';
          button.className = 'smm-quick-btn';
          button.dataset.quantity = String(value);
          button.textContent = formatNumber(value);

          button.addEventListener('click', function () {
            qtyInput.value = String(value);
            validateAll();
            qtyInput.focus();
          });

          quickQuantities.appendChild(button);
        });
      }

      function validateLink() {
        const link = String(linkInput.value || '').trim();

        linkInput.classList.remove('valid', 'invalid');

        if (!link) {
          linkMessage.textContent =
            'Paste the link required by this service.';

          linkMessage.className = 'smm-field-message';

          return false;
        }

        if (link.length < 3) {
          linkInput.classList.add('invalid');

          linkMessage.textContent =
            'Please enter a valid link or username.';

          linkMessage.className =
            'smm-field-message error';

          return false;
        }

        linkInput.classList.add('valid');

        linkMessage.textContent =
          'Link added. Make sure it is correct and public if required.';

        linkMessage.className =
          'smm-field-message success';

        return true;
      }

      function validateQuantity() {
        const quantity = Number(qtyInput.value || 0);

        qtyInput.classList.remove('valid', 'invalid');

        if (
          !Number.isFinite(quantity) ||
          quantity <= 0
        ) {
          qtyMessage.textContent =
            `Enter a value between ${formatNumber(minQty)} and ${formatNumber(maxQty)}.`;

          qtyMessage.className =
            'smm-field-message';

          return false;
        }

        if (!Number.isInteger(quantity)) {
          qtyInput.classList.add('invalid');

          qtyMessage.textContent =
            'Quantity must be a whole number.';

          qtyMessage.className =
            'smm-field-message error';

          return false;
        }

        if (
          quantity < minQty ||
          quantity > maxQty
        ) {
          qtyInput.classList.add('invalid');

          qtyMessage.textContent =
            `Allowed quantity is between ${formatNumber(minQty)} and ${formatNumber(maxQty)}.`;

          qtyMessage.className =
            'smm-field-message error';

          return false;
        }

        qtyInput.classList.add('valid');

        qtyMessage.textContent =
          'Quantity is within the allowed range.';

        qtyMessage.className =
          'smm-field-message success';

        return true;
      }

      function updateQuickButtons() {
        const quantity = Number(qtyInput.value || 0);

        document
          .querySelectorAll('.smm-quick-btn')
          .forEach(function (button) {
            button.classList.toggle(
              'active',
              Number(button.dataset.quantity) === quantity
            );
          });
      }

      function updatePrice() {
        const quantity = Number(qtyInput.value || 0);

        calculatedTotal =
          quantity > 0 &&
          rate > 0 &&
          ratePer > 0
            ? (quantity * rate) / ratePer
            : 0;

        estimatedPrice.textContent =
          calculatedTotal.toFixed(4);

        summaryQuantity.textContent =
          quantity > 0
            ? formatNumber(quantity)
            : '—';

        const remaining =
          userBalance - calculatedTotal;

        balanceAfter.textContent =
          '$' + Math.max(0, remaining).toFixed(2);
      }

      function updateStatus(
        validLink,
        validQuantity
      ) {
        balanceStatus.className =
          'smm-balance-status';

        if (!validLink || !validQuantity) {
          balanceStatus.classList.add('waiting');

          balanceStatus.innerHTML =
            '<i class="bi bi-hourglass-split"></i>' +
            '<span>Enter the link and a valid quantity to continue.</span>';

          return false;
        }

        if (
          !Number.isFinite(calculatedTotal) ||
          calculatedTotal <= 0
        ) {
          balanceStatus.classList.add('error');

          balanceStatus.innerHTML =
            '<i class="bi bi-exclamation-circle"></i>' +
            '<span>Unable to calculate the order price.</span>';

          return false;
        }

        if (userBalance < calculatedTotal) {
          balanceStatus.classList.add('error');

          balanceStatus.innerHTML =
            '<i class="bi bi-wallet2"></i>' +
            '<span>Your balance is not enough for this quantity.</span>';

          return false;
        }

        balanceStatus.classList.add('success');

        balanceStatus.innerHTML =
          '<i class="bi bi-check-circle-fill"></i>' +
          '<span>Everything is ready. You can continue.</span>';

        return true;
      }

      function validateAll() {
        const validLink = validateLink();
        const validQuantity = validateQuantity();

        updatePrice();
        updateQuickButtons();

        const validBalance =
          updateStatus(validLink, validQuantity);

        const ready =
          validLink &&
          validQuantity &&
          validBalance;

        confirmBtn.disabled = !ready;

        return ready;
      }

      function fillConfirmation() {
        const link =
          String(linkInput.value || '').trim();

        const quantity =
          Number(qtyInput.value || 0);

        confirmLink.textContent = link;
        confirmQuantity.textContent =
          formatNumber(quantity);

        confirmPrice.textContent =
          '$' + calculatedTotal.toFixed(4);
      }

      function openConfirmation() {
        if (!validateAll()) return;

        ensureToken();
        fillConfirmation();

        if (confirmationModal) {
          confirmationModal.show();
          return;
        }

        const approved = window.confirm(
          'Confirm this order?\n\n' +
          'Quantity: ' +
          formatNumber(Number(qtyInput.value || 0)) +
          '\nTotal: $' +
          calculatedTotal.toFixed(4)
        );

        if (approved) {
          submitOrder();
        }
      }

      function submitOrder() {
        if (submitting) return;
        if (!validateAll()) return;

        submitting = true;
        ensureToken();

        confirmBtn.disabled = true;
        finalSubmitBtn.disabled = true;

        finalSubmitBtn.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2"></span>' +
          'Submitting...';

        form.submit();
      }

      linkInput.addEventListener('input', validateAll);
      linkInput.addEventListener('blur', validateAll);

      qtyInput.addEventListener('input', validateAll);
      qtyInput.addEventListener('blur', validateAll);

      confirmBtn.addEventListener(
        'click',
        openConfirmation
      );

      finalSubmitBtn.addEventListener(
        'click',
        submitOrder
      );

      form.addEventListener('submit', function (event) {
        if (submitting) return;

        event.preventDefault();
        openConfirmation();
      });

      renderQuickQuantities();
      ensureToken();
      validateAll();
    });
  </script>

</body>
</html>