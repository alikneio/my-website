<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Accounts - AK Cell</title>

  <link rel="stylesheet" href="/css/bootstrap.css">
  <link rel="stylesheet" href="/css/custom.css">
  <link rel="stylesheet" href="/css/bootstrap-icons/font/bootstrap-icons.css">

  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css"
  >
</head>

<body>

  <%- include('partials/header') %>


  <div class="hero-section">

    <h1 class="display-4">
      Accounts Services
    </h1>

    <p class="lead col-lg-8 mx-auto">
      All available accounts and subscriptions in one place.
    </p>

  </div>


  <div class="container my-5">

    <div class="search-bar-container">

      <form
        id="searchForm"
        action="#"
        method="GET"
        role="search"
      >

        <input
          type="search"
          id="searchInput"
          class="search-input"
          placeholder="Search for any service..."
        >

        <button
          type="submit"
          class="search-btn"
        >
          <i class="bi bi-search"></i>
        </button>

      </form>

    </div>

  </div>


  <%
    /*
     * =========================================================
     * STATIC ACCOUNT CATEGORIES
     * =========================================================
     *
     * sort_order controls the position of every existing card.
     *
     * Dynamic SQL categories use the SAME sort_order system.
     *
     * Example:
     * Dynamic AK DRAMA with sort_order = 3
     * will appear after Netflix Normal and before Shahid.
     *
     * =========================================================
     */

    const staticAccountCategories = [

      {
        name: 'Netflix High Quality',
        href: '/netflixH-section',
        image: '/images/webp/netflixlogo.webp',
        alt: 'Netflix',
        sort_order: 1
      },

      {
        name: 'Netflix Normal Qauilty',
        href: '/netflixL-section',
        image: '/images/webp/netflixlogo.webp',
        alt: 'Netflix',
        sort_order: 2
      },

      {
        name: 'Shahid',
        href: '/shahid-section',
        image: '/images/webp/shahidlogo1.webp',
        alt: 'shahid',
        sort_order: 4
      },

      {
        name: 'Cyber Ghost',
        href: '/cyberghost',
        image: '/images/cyberghost.png',
        alt: 'Cyber Ghost',
        sort_order: 5
      },

      {
        name: 'IPTV',
        href: '/iptv-section',
        image: '/images/webp/iptvlogo.webp',
        alt: 'iptv',
        sort_order: 6
      },

      {
        name: 'osn',
        href: '/osn-section',
        image: '/images/webp/osnlogo1.webp',
        alt: 'osn',
        sort_order: 7
      },

      {
        name: 'Prime video',
        href: '/primevideo',
        image: '/images/webp/primevideologo.webp',
        alt: 'Prime Video',
        sort_order: 8
      },

      {
        name: 'watch IT',
        href: '/watchit',
        image: '/images/watchit.png',
        alt: 'watch it',
        sort_order: 9
      },

      {
        name: 'YANGO PLAY',
        href: '/yango',
        image: '/images/yango.png',
        alt: 'YANGO',
        sort_order: 10
      },

      {
        name: 'HBO Max',
        href: '/hbo',
        image: '/images/hbo.png',
        alt: 'HBO',
        sort_order: 11
      },

      {
        name: 'Disney High',
        href: '/disneyhigh-section',
        image: '/images/webp/disneylogo1.webp',
        alt: 'Disney high',
        sort_order: 12
      },

      {
        name: 'Dramabox',
        href: '/dramabox',
        image: '/images/dramabox.png',
        alt: 'Dramabox',
        sort_order: 13
      },

      {
        name: 'GoodShort',
        href: '/goodshort',
        image: '/images/goodshort.png',
        alt: 'GoodShort',
        sort_order: 14
      },

      {
        name: 'Anghami',
        href: '/anghami-section',
        image: '/images/webp/anghamilogo.webp',
        alt: 'anghami',
        sort_order: 15
      },

      {
        name: 'Adobe Creativity Cloud',
        href: '/Adobe_Creativity_Cloud',
        image: '/images/adobe.png',
        alt: 'Adobe Creativity Cloud',
        sort_order: 16
      },

      {
        name: 'Duolingo',
        href: '/duolingo',
        image: '/images/duolingo.png',
        alt: 'Duolingo',
        sort_order: 17
      },

      {
        name: 'Youtube premuim',
        href: '/youtube-section',
        image: '/images/webp/youtubelogo.webp',
        alt: 'Youtube',
        sort_order: 18
      },

      {
        name: 'Microsoft Office 365',
        href: '/office365',
        image: '/images/office365.png',
        alt: 'office365',
        sort_order: 19
      },

      {
        name: 'IBO Player',
        href: '/ibo',
        image: '/images/ibo.png',
        alt: 'ibo',
        sort_order: 20
      },

      {
        name: 'Snapchat',
        href: '/snapchat',
        image: '/images/snapchat.png',
        alt: 'Snapchat',
        sort_order: 21
      },

      {
        name: 'TOD',
        href: '/tod',
        image: '/images/tod.png',
        alt: 'tod',
        sort_order: 22
      },

      {
        name: 'Apple Tv+',
        href: '/appletv',
        image: '/images/appletv.png',
        alt: 'appletv',
        sort_order: 23
      },

      {
        name: 'Telegram Stars',
        href: '/telegramstars',
        image: '/images/telegramstars.png',
        alt: 'Telegram Stars',
        sort_order: 24
      },

      {
        name: 'Starzplay',
        href: '/starzplay',
        image: '/images/starzplay.png',
        alt: 'starzplay',
        sort_order: 25
      },

      {
        name: 'Spotify Normal Quality',
        href: '/spotifyN-section',
        image: '/images/webp/spotifylogo.webp',
        alt: 'Spotify',
        sort_order: 26
      },

      {
        name: 'Spotify High Quality',
        href: '/spotifyH-section',
        image: '/images/webp/spotifylogo.webp',
        alt: 'Spotify',
        sort_order: 27
      },

      {
        name: 'Crunchy Roll',
        href: '/crunchyroll-section',
        image: '/images/webp/crunchyrol.webp',
        alt: 'crunchyroll',
        sort_order: 28
      },

      {
        name: 'CapCut',
        href: '/capcut-section',
        image: '/images/webp/capcutlogo.webp',
        alt: 'CapCut',
        sort_order: 29
      }

    ];


    /*
     * =========================================================
     * DYNAMIC SQL SUB-CATEGORIES
     * =========================================================
     */

    const dynamicAccountCategories =
      (dynamicSubcategories || []).map(function(category) {

        return {

          name: category.name,

          href: '/category/' + category.slug,

          image:
            category.image ||
            '/images/logo.webp',

          alt: category.name,

          sort_order:
            Number(category.sort_order) || 0,

          isDynamic: true,

          dynamicId:
            Number(category.id) || 0

        };

      });


    /*
     * =========================================================
     * MERGE STATIC + DYNAMIC
     * =========================================================
     */

    const allAccountCategories = [
      ...staticAccountCategories,
      ...dynamicAccountCategories
    ];


    /*
     * =========================================================
     * SORT
     * =========================================================
     *
     * Lower sort_order appears first.
     *
     * If two cards have the same sort_order:
     * static card comes first,
     * then dynamic card.
     *
     * =========================================================
     */

    allAccountCategories.sort(function(a, b) {

      const aOrder =
        Number(a.sort_order) || 0;

      const bOrder =
        Number(b.sort_order) || 0;


      if (aOrder !== bOrder) {
        return aOrder - bOrder;
      }


      if (!!a.isDynamic !== !!b.isDynamic) {

        return a.isDynamic
          ? 1
          : -1;

      }


      return (
        (Number(a.dynamicId) || 0) -
        (Number(b.dynamicId) || 0)
      );

    });

  %>


  <div class="container my-5 py-5">

    <h2 class="text-center section-title">
      Select a Service
    </h2>


    <div class="row row-cols-2 row-cols-sm-4 row-cols-lg-3 g-4">


      <% allAccountCategories.forEach(function(category) { %>


        <div class="col-lg-3 col-md-4 col-sm-6">


          <a
            href="<%= category.href %>"
            class="category-card service-card"
          >


            <img
              src="<%= category.image %>"
              class="card-img"
              alt="<%= category.alt %>"
            >


            <div class="card-body">
              <%= category.name %>
            </div>


          </a>


        </div>


      <% }) %>


    </div>

  </div>


  <%- include('partials/footer') %>


  <script>

    document.addEventListener(
      "DOMContentLoaded",
      function () {

        console.log(
          "✅ Search script loaded!"
        );


        const searchInput =
          document.getElementById(
            "searchInput"
          );


        if (!searchInput) {
          return;
        }


        const searchForm =
          document.getElementById(
            "searchForm"
          );


        if (searchForm) {

          searchForm.addEventListener(
            "submit",
            function (e) {

              e.preventDefault();

            }
          );

        }


        searchInput.addEventListener(
          "input",
          function () {

            const query =
              this.value
                .toLowerCase()
                .trim();


            const cards =
              document.querySelectorAll(
                ".category-card"
              );


            cards.forEach(
              function (card) {

                const title =
                  card.textContent
                    ?.toLowerCase() || "";


                const cardWrapper =
                  card.closest(
                    "div[class^='col']"
                  );


                if (!cardWrapper) {
                  return;
                }


                if (
                  title.includes(query)
                ) {

                  cardWrapper.style.display =
                    "";

                } else {

                  cardWrapper.style.display =
                    "none";

                }

              }
            );

          }
        );

      }
    );

  </script>


  <link
    rel="stylesheet"
    href="/css/bootstrap-icons/font/bootstrap-icons.css"
  >


  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>


  <script src="/main.js"></script>


</body>

</html>